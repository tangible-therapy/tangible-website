---
// "Find Your Therapist" with a search-bar style filter (design Option C).
// Every therapist is rendered into the HTML at build time (good for SEO);
// the filters only show/hide cards in the browser. Data: src/lib/therapist-sheet.ts
import { site } from '../data/site';
import { bookingAttrs } from '../lib/booking';
import BookingScript from './BookingScript.astro';
import { getFinderData, LOCATIONS, TIMES, AGES, SEES, SPECIALTIES, APPROACHES, INSURERS } from '../lib/therapist-sheet';

interface Props { heading?: string }
const { heading = 'Find Your Therapist' } = Astro.props;
const { therapists } = await getFinderData();

const usedApproaches = APPROACHES.filter((a) => therapists.some((t) => t.approaches.includes(a)));
const usedSpecialties = SPECIALTIES.filter((s) => therapists.some((t) => t.specialties.includes(s)));

type Group = { key: string; title?: string; options: string[]; single?: boolean };
type Pill = { key: string; label: string; empty: string; hint: string; groups: Group[] };
const pills: Pill[] = [
  { key: 'loc', label: 'Location', empty: 'Any office', hint: 'Choose one or more', groups: [{ key: 'loc', options: LOCATIONS }] },
  { key: 'ins', label: 'Insurance', empty: 'Any plan', hint: 'Show therapists in-network with your plan', groups: [{ key: 'ins', options: INSURERS, single: true }] },
  { key: 'time', label: 'Availability', empty: 'Any time', hint: 'Times of day that work for you', groups: [{ key: 'time', options: TIMES }] },
  { key: 'spec', label: 'Specialty', empty: 'Anything', hint: 'Pick any that apply', groups: [{ key: 'spec', options: usedSpecialties }] },
  {
    key: 'more', label: 'More', empty: 'Add filters', hint: 'Narrow it down further',
    groups: [
      { key: 'sees', title: 'Therapy for', options: SEES },
      { key: 'age', title: 'Age', options: AGES },
      { key: 'appr', title: 'Approach', options: usedApproaches },
      { key: 'gender', title: 'Therapist', options: ['Female', 'Male'] },
      { key: 'lang', title: 'Language', options: ['Spanish'] },
    ],
  },
];
const j = (a: string[]) => a.join('|');
const officeText = (locs: string[]) => locs.filter((l) => l !== 'Telehealth').join(', ') || 'Telehealth';
---
<section class="sec t-black tf" data-finder>
  <div class="tf-head">
    <h1>{heading}</h1>

    <div class="tf-bar" role="group" aria-label="Filter therapists">
      {pills.map((p, i) => (
        <>
          {i > 0 && <span class="tf-div" aria-hidden="true" />}
          <button type="button" class="tf-seg" aria-expanded="false" aria-controls={`tf-panel-${p.key}`} data-pill={p.key} data-empty={p.empty}>
            <span class="tf-seg-label">{p.label}</span>
            <span class="tf-seg-value is-empty">{p.empty}</span>
          </button>
        </>
      ))}
      <span class="tf-div" aria-hidden="true" />
      <button type="button" class="tf-seg tf-toggle" role="switch" aria-checked="false" data-open-toggle>
        <span class="tf-toggle-text">
          <span class="tf-seg-label">Openings</span>
          <span class="tf-seg-value">Accepting only</span>
        </span>
        <span class="tf-switch" aria-hidden="true"><span /></span>
      </button>
    </div>

    {pills.map((p) => (
      <div class="tf-panel" id={`tf-panel-${p.key}`} data-panel={p.key} hidden>
        <div class="tf-panel-top">
          <div>
            <div class="tf-panel-title">{p.label}</div>
            <div class="tf-panel-hint">{p.hint}</div>
          </div>
          <button type="button" class="tf-done" data-close>Done</button>
        </div>
        {p.groups.map((g) => (
          <fieldset class="tf-group">
            <legend class={g.title ? 'tf-group-title' : 'sr-only'}>{g.title ?? p.label}</legend>
            <div class="tf-opts">
              {g.single && (
                <label class="tf-opt"><input type="radio" name={g.key} value="" checked /><span>Any plan</span></label>
              )}
              {g.options.map((o) => (
                <label class="tf-opt">
                  <input type={g.single ? 'radio' : 'checkbox'} name={g.key} value={o} />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
    ))}

    <div class="tf-status">
      <span aria-live="polite" data-count>Showing all {therapists.length} therapists</span>
      <button type="button" class="tf-clear" data-clear hidden>Clear all filters</button>
    </div>
  </div>

  <ul class="tf-grid">
    {therapists.map((t, i) => (
      <li
        class="tf-card"
        data-status={t.status}
        data-loc={j(t.locations)}
        data-ins={j(t.insurance)}
        data-time={j(t.times)}
        data-spec={j(t.specialties)}
        data-sees={j(t.sees)}
        data-age={j(t.ages)}
        data-appr={j(t.approaches)}
        data-gender={t.gender}
        data-lang={j(t.languages)}
      >
        <a href={`/ourteam/p/${t.slug}`}>
          <span class="tf-photo">
            <img src={t.photo} alt={`${t.name}, ${t.credential}`} width="600" height="750" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
          </span>
          <h2 class="tf-name">{t.name}</h2>
          <span class="tf-meta">{[t.credential, officeText(t.locations)].filter(Boolean).join(' · ')}</span>
        </a>
        {/* Over the photo but outside the profile link (a button can't live inside a link):
            status tag in the top-left corner, Book now / Call now centred at the bottom. */}
        <div class="tf-over">
          <div class="tf-tags">
            {t.status === 'open' && <span class="tf-badge"><span class="tf-dot is-open" />Accepting new clients</span>}
            {t.status === 'wait' && <span class="tf-badge"><span class="tf-dot is-wait" />Waitlist</span>}
            {(t.status === 'closed' || t.status === 'unknown') && <span class="tf-badge"><span class="tf-dot is-closed" />Not accepting new clients</span>}
          </div>
          {t.status === 'open' && t.booking && (
            <a class="tf-act" href={site.clientPortal} {...bookingAttrs(t.slug)} aria-label={`Book now with ${t.name}`}>Book now</a>
          )}
          {(t.status === 'wait' || (t.status === 'open' && !t.booking)) && (
            <a class="tf-act" href={site.phoneHref} aria-label={`Call ${site.phone} about ${t.name}`}>Call now</a>
          )}
        </div>
      </li>
    ))}
  </ul>

  <div class="tf-empty" data-empty hidden>
    <h2>No therapists match all of those</h2>
    <p>Try removing a filter, or give us a call and we'll help you find the right fit.</p>
    <button type="button" class="tf-done" data-clear>Clear all filters</button>
  </div>
</section>
<BookingScript />

<style>
  .tf { padding-bottom: 5vw; }
  .tf-head { max-width: 1080px; margin: 0 auto; padding: 3vw var(--gutter) 0; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; box-sizing: content-box; }
  .tf-head h1 { font-size: var(--h2); color: #fff; margin: 0; text-align: center; }

  .tf-bar { width: 100%; box-sizing: border-box; background: #fff; color: #1f2a20; border-radius: 14px; padding: 6px; display: flex; align-items: stretch; box-shadow: 0 10px 30px rgba(47, 58, 48, .16); }
  .tf-div { flex: 0 0 1px; margin: 14px 0; background: #e3e7e2; }
  .tf-seg { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; padding: 11px 18px; border: 0; border-radius: 10px; background: #fff; color: #1f2a20; text-align: left; font: inherit; cursor: pointer; }
  .tf-seg:hover, .tf-seg[aria-expanded="true"] { background: #eef1ed; }
  .tf-seg:focus-visible, .tf-opt input:focus-visible + span, .tf-done:focus-visible, .tf-clear:focus-visible { outline: 3px solid var(--charcoal); outline-offset: 2px; }
  .tf-seg-label { font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #56615a; }
  .tf-seg-value { max-width: 100%; font-size: 15px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tf-seg-value.is-empty { color: #6b766d; }
  .tf-toggle { flex: 0 0 auto; flex-direction: row; align-items: center; gap: 12px; }
  .tf-toggle-text { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-width: 0; }
  .tf-switch { flex: 0 0 40px; width: 40px; height: 24px; border-radius: 12px; background: #cbd3cb; padding: 3px; box-sizing: border-box; display: flex; transition: background .15s; }
  .tf-switch span { width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform .15s; }
  .tf-toggle[aria-checked="true"] .tf-switch { background: var(--charcoal); }
  .tf-toggle[aria-checked="true"] .tf-switch span { transform: translateX(16px); }

  .tf-panel { width: 100%; box-sizing: border-box; background: #fff; color: #1f2a20; border-radius: 14px; padding: 22px 26px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 12px 30px rgba(47, 58, 48, .18); }
  .tf-panel[hidden] { display: none; }
  .tf-panel-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .tf-panel-title { font-size: 16px; font-weight: 600; }
  .tf-panel-hint { font-size: 13px; color: #56615a; }
  .tf-done { min-height: 40px; padding: 0 20px; border-radius: 300px; border: 0; background: var(--charcoal); color: #fff; font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; }
  .tf-group { border: 0; margin: 0; padding: 0; }
  .tf-group-title { font-size: 12.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #56615a; margin-bottom: 6px; padding: 0; }
  .tf-opts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px 16px; }
  .tf-opt { min-height: 40px; display: flex; align-items: center; gap: 10px; padding: 4px 8px; border-radius: 8px; font-size: 14.5px; cursor: pointer; }
  .tf-opt:hover { background: #f4f6f3; }
  .tf-opt input { appearance: none; flex: 0 0 20px; width: 20px; height: 20px; margin: 0; border: 1.5px solid #aeb8ae; border-radius: 5px; background: #fff; display: grid; place-content: center; cursor: pointer; }
  .tf-opt input[type="radio"] { border-radius: 50%; }
  .tf-opt input:checked { background: var(--charcoal); border-color: var(--charcoal); }
  .tf-opt input:checked::after { content: ''; width: 10px; height: 6px; border: 2px solid #fff; border-top: 0; border-right: 0; transform: rotate(-45deg) translate(1px, -1px); }
  .tf-opt input[type="radio"]:checked::after { width: 8px; height: 8px; border: 0; border-radius: 50%; background: #fff; transform: none; }
  .tf-opt input:checked + span { font-weight: 500; }

  .tf-status { display: flex; align-items: center; gap: 16px; font-size: 15px; font-weight: 500; color: #fff; min-height: 40px; }
  .tf-clear { border: 0; background: transparent; color: #fff; font: inherit; font-weight: 300; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; padding: 8px 4px; }
  .tf-clear[hidden] { display: none; }

  .tf-grid { list-style: none; margin: 0 auto; padding: 1.5rem var(--gutter) 0; max-width: 1080px; box-sizing: content-box; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px 44px; }
  .tf-card[hidden] { display: none; }
  .tf-card > a { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; color: #fff; }
  .tf-photo { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; border-radius: 10px; overflow: hidden; background: #9dab9d; box-shadow: 0 6px 18px rgba(47, 58, 48, .12); margin-bottom: 14px; }
  .tf-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .tf-card > a:hover img { transform: scale(1.03); }
  .tf-card { position: relative; }
  /* Same size and position as the photo, so its bottom edge is the photo's bottom edge */
  .tf-over { position: absolute; top: 0; left: 0; right: 0; aspect-ratio: 4 / 5; pointer-events: none; }
  .tf-tags { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; }
  .tf-act { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); pointer-events: auto; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; height: 34px; min-width: 112px; padding: 1px 20px 0; border-radius: 300px; background: rgba(47, 51, 48, .82); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff !important; font-size: 13px; font-weight: 500; letter-spacing: .02em; line-height: 1; text-decoration: none; white-space: nowrap; box-shadow: 0 4px 14px rgba(0, 0, 0, .18); transition: background .15s, transform .15s; }
  .tf-act:hover { background: rgba(20, 22, 21, .92); transform: translateX(-50%) translateY(-1px); }
  .tf-act:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .tf-badge { display: flex; box-sizing: border-box; height: 26px; line-height: 1; white-space: nowrap; align-items: center; gap: 6px; padding: 1px 10px 0; border-radius: 300px; background: rgba(255, 255, 255, .9); backdrop-filter: blur(6px); color: #1f2a20; font-size: 11px; font-weight: 500; }
  .tf-dot { width: 6px; height: 6px; border-radius: 50%; }
  .tf-dot.is-open { background: #3d8b5a; }
  .tf-dot.is-wait { background: #e0b000; }
  .tf-dot.is-closed { background: #d64545; }
  .tf-name { margin: 0; font-size: 19px; font-weight: 500; line-height: 1.3; color: #fff; }
  .tf-meta { margin-top: 2px; font-size: 13.5px; color: #2f3a30; }

  .tf-empty { max-width: 560px; margin: 2rem auto 0; background: #fff; color: #1f2a20; border-radius: 14px; padding: 36px 28px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .tf-empty[hidden] { display: none; }
  .tf-empty h2 { margin: 0; font-size: 22px; font-weight: 500; }
  .tf-empty p { margin: 0; color: #4a554c; }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 1100px) {
    .tf-seg { padding: 10px 11px; }
    .tf-seg-value { font-size: 14px; }
    .tf-seg-label { font-size: 10.5px; letter-spacing: .06em; }
  }
  @media (max-width: 1024px) {
    .tf-grid { gap: 40px 24px; }
    .tf-opts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .tf-head { gap: 1rem; padding-top: 8vw; }
    .tf-bar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
    .tf-div { display: none; }
    .tf-seg { border: 1px solid #eef1ed; padding: 10px 12px; }
    .tf-toggle { justify-content: space-between; gap: 6px; }
    .tf-toggle .tf-seg-value { white-space: normal; line-height: 1.25; }
    .tf-panel { padding: 18px 16px; }
    .tf-opts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 14px; padding-top: 1rem; }
    .tf-name { font-size: 15px; }
    .tf-meta { font-size: 12px; }
    .tf-tags { top: 7px; left: 7px; right: 7px; }
    .tf-badge { height: 24px; padding: 1px 8px 0; font-size: 10px; }
    .tf-act { bottom: 9px; height: 30px; min-width: 96px; padding: 1px 16px 0; font-size: 12px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('.tf-card')];
    const segs = [...root.querySelectorAll<HTMLButtonElement>('[data-pill]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-open-toggle]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const clears = [...root.querySelectorAll<HTMLButtonElement>('[data-clear]')];
    const clearLink = root.querySelector<HTMLButtonElement>('.tf-clear')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const total = cards.length;

    const checked = (name: string) =>
      [...root.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value).filter(Boolean);
    const groups = ['loc', 'ins', 'time', 'spec', 'sees', 'age', 'appr', 'gender', 'lang'];
    const pillGroups: Record<string, string[]> = { loc: ['loc'], ins: ['ins'], time: ['time'], spec: ['spec'], more: ['sees', 'age', 'appr', 'gender', 'lang'] };

    function openPanel(key: string | null) {
      segs.forEach((s) => s.setAttribute('aria-expanded', String(s.dataset.pill === key)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
    }

    function apply() {
      const sel: Record<string, string[]> = {};
      groups.forEach((g) => (sel[g] = checked(g)));
      const openOnly = toggle.getAttribute('aria-checked') === 'true';
      let shown = 0;
      for (const c of cards) {
        const ok =
          (!openOnly || c.dataset.status === 'open') &&
          groups.every((g) => {
            if (!sel[g].length) return true;
            const have = (c.dataset[g] || '').split('|');
            return sel[g].some((v) => have.includes(v));
          });
        c.hidden = !ok;
        if (ok) shown++;
      }
      // Pill summaries
      for (const s of segs) {
        const picked = pillGroups[s.dataset.pill!].flatMap((g) => sel[g]);
        const v = s.querySelector<HTMLElement>('.tf-seg-value')!;
        v.textContent = picked.length === 0 ? s.dataset.empty! : picked.length <= 2 ? picked.join(', ') : `${picked[0]} +${picked.length - 1}`;
        v.classList.toggle('is-empty', picked.length === 0);
      }
      const any = openOnly || groups.some((g) => sel[g].length);
      count.textContent = any ? `${shown} therapist${shown === 1 ? '' : 's'} match` : `Showing all ${total} therapists`;
      clearLink.hidden = !any;
      empty.hidden = shown > 0;
    }

    segs.forEach((s) => s.addEventListener('click', () => openPanel(s.getAttribute('aria-expanded') === 'true' ? null : s.dataset.pill!)));
    root.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => openPanel(null)));
    root.addEventListener('change', apply);
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-checked', String(toggle.getAttribute('aria-checked') !== 'true'));
      apply();
    });
    clears.forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll<HTMLInputElement>('.tf-opt input').forEach((i) => (i.checked = i.value === '' ));
        toggle.setAttribute('aria-checked', 'false');
        openPanel(null);
        apply();
      }),
    );
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') openPanel(null); });
    apply();
  }
</script>
