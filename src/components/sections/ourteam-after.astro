---
import BookCTA from '../BookCTA.astro';
// Converted from the Squarespace page sections after the collection.
import Divider from '../Divider.astro';
---
<section class="sec t-black h-medium has-div" style="--divh:8vw">
<div class="sec-in">
<div class="fe" style="--rows:2;--mrows:2">
  <div class="b b-marquee jc" style="--d:1/2/3/26;--m:1/2/3/10;--dz:10;--mz:10"><div class="marquee" aria-label="We Offer a free 15 Minute consult with a therapist!"><div class="marquee-track"><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span><span>We Offer a free 15 Minute consult with a therapist!</span><span class="dot" aria-hidden="true">✺</span></div></div></div>
</div>
<BookCTA />
</div>
<Divider type="scalloped" height={8} width={100} fill="#fff" flipX /></section>
<section class="sec t-bright-inverse h-custom">
<div class="sec-in" style="padding-top: calc(1vmax / 10); padding-bottom: calc(1vmax / 10);">
<div class="fe" style="--rows:14;--mrows:27">
  <div class="b b-html" style="--d:2/9/4/19;--m:3/2/5/10;--dz:2;--mz:2"><div class="rte"><h3 class="ta-center">In-network providers</h3></div></div>
  <div class="b b-html" style="--d:4/9/5/19;--m:5/2/7/10;--dz:3;--mz:3"><div class="rte"><p class="ta-center">We currently accept the following insurance plans:</p></div></div>
  <div class="b b-image jc" style="--d:5/2/8/5;--m:8/2/10/5;--dz:5;--mz:5"><figure class="img fill" style="--fit:contain"><img src="/images/image-32f408.png" alt="Logo of EMI Health featuring the company name and a stylized green human figure above the text." width="441" height="114" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:5/6/8/9;--m:8/7/10/10;--dz:6;--mz:6"><figure class="img fill" style="--fit:contain"><img src="/images/image-1-43f3cb.png" alt="SelectHealth logo with two check marks, one red and one purple, beside the text &#x27;Select Health&#x27;" width="349" height="144" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:5/10/8/14;--m:10/2/12/5;--dz:7;--mz:7"><figure class="img fill" style="--fit:contain"><img src="/images/image-3-376863.png" alt="Logo of DMBA, featuring a stylized curved line design and the text &#x27;DMBA&#x27;." width="300" height="150" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:5/15/8/18;--m:12/7/14/10;--dz:8;--mz:8"><figure class="img fill" style="--fit:contain"><img src="/images/image-4-75ff77.png" alt="United Healthcare logo with blue stylized &#x27;U&#x27; and text" width="401" height="126" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:5/19/8/22;--m:16/7/18/10;--dz:14;--mz:14"><figure class="img fill" style="--fit:contain"><img src="/images/image-12-353ae3.png" alt="Logo featuring a stylized American flag on the left and a series of blue stars on the right. The word TRICARE is written below in red capital letters." width="1218" height="611" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:5/23/8/26;--m:16/2/18/5;--dz:10;--mz:10"><figure class="img fill" style="--fit:contain"><img src="/images/image-8-370a9c.png" alt="UMR logo with black text and a green curved line underneath" width="308" height="163" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:8/8/11/11;--m:10/7/12/10;--dz:11;--mz:11"><figure class="img fill" style="--fit:contain"><img src="/images/image-10-66f693.png" alt="Blue Cross logo with a blue cross and a circle with a star and a snake wrapped around a staff, and Blue Shield shield with a snake wrapped around a staff, indicating medical insurance." width="600" height="600" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:8/12/11/16;--m:12/2/14/5;--dz:12;--mz:12"><figure class="img fill" style="--fit:contain"><img src="/images/image-11-22f532.png" alt="Regence logo with a blue shield featuring a snake wrapped around a rod, and the word &#x27;Regence&#x27; written in black text." width="1449" height="387" loading="lazy" decoding="async"></figure></div>
  <div class="b b-image jc" style="--d:8/17/11/20;--m:14/2/16/5;--dz:13;--mz:13"><figure class="img fill" style="--fit:contain"><img src="/images/image-12-d170b6.png" alt="Logo with the words PEHP Health &amp; Benefits in large blue font, with PEHP in darker blue and Health &amp; Benefits in lighter blue." width="2399" height="1158" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:12/6/15/24;--m:22/2/28/10;--dz:4;--mz:4"><div class="rte"><p class="ta-center">If your provider is listed, your sessions may be partially or fully covered, depending on your plan. We encourage you to verify the specifics with your insurance company before your first session.<br/></p></div></div>
</div>
</div>
</section>
