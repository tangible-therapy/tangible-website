---
// Staff chatbot window (name: STAFF_BOT_NAME in src/data/staff.ts), shown on staff pages by Base.astro.
// Talks to netlify/functions/staff-chat.mts at /api/staff-chat, which checks the staff sign-in on every message.
// The conversation is kept only in this browser tab (sessionStorage "sc.chat.v1"); nothing is saved on our side.
// Based on the public Tangie window (ChatWidget.astro), with its own class names (sc-) and no pop-up nudge.
import { STAFF_BOT_NAME } from '../data/staff';
const name = STAFF_BOT_NAME;
const starters = ['When is my next training?', 'How many hours do I have?', 'Is a room open right now?', 'What is the PTO policy?'];
---
<div class="sc" data-sc>
  <button type="button" class="sc-launch" aria-expanded="false" aria-controls="sc-panel" aria-label={`${name}: chat assistant for staff`} data-sc-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z" /></svg>
    <span>{name}</span>
  </button>


  <section class="sc-panel" id="sc-panel" role="dialog" aria-label={name} hidden>
    <header class="sc-head">
      <span class="sc-head-av" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/><path d="M9 7.5h6M9 11h4"/></svg></span>
      <div class="sc-head-text">
        <strong>{name} <em>Beta</em></strong>
        <span>Staff only · answers from the handbook and your portal</span>
      </div>
      <button type="button" class="sc-close" aria-label="Close chat" data-sc-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="sc-log" data-sc-log aria-live="polite">
      <div class="sc-msg sc-bot">Hi! Ask me about policies and procedures, orientation, front desk steps, or your own info: your next training, your hours, or an open room.</div>
    </div>

    <div class="sc-starters" data-sc-starters>
      {starters.map((s) => <button type="button" class="sc-chip">{s}</button>)}
    </div>

    <form class="sc-form" data-sc-form>
      <label class="sc-sr" for="sc-input">Type your question</label>
      <textarea id="sc-input" rows="1" maxlength="600" placeholder="Ask a question…" autocomplete="off" data-sc-input></textarea>
      <button type="submit" class="sc-send" aria-label="Send" data-sc-send>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
      </button>
    </form>
    <p class="sc-note">Staff only. Please don't enter client names or details. Answers come from the handbook; check with your director if something isn't covered.</p>
  </section>
</div>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  const KEY = 'sc.chat.v1';
  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('.sc-panel')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-sc-toggle]')!;
    const close = root.querySelector<HTMLButtonElement>('[data-sc-close]')!;
    const log = root.querySelector<HTMLElement>('[data-sc-log]')!;
    const starters = root.querySelector<HTMLElement>('[data-sc-starters]')!;
    const form = root.querySelector<HTMLFormElement>('[data-sc-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-sc-input]')!;
    const send = root.querySelector<HTMLButtonElement>('[data-sc-send]')!;

    let state: { open: boolean; messages: Msg[]; who?: string } = { open: false, messages: [] };
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (saved && Array.isArray(saved.messages)) state = saved;
    } catch {}
    // A different person signed in on this browser tab: start a fresh conversation.
    const checkWho = (me: { email?: string } | undefined) => {
      if (!me?.email) return;
      if (state.who && state.who !== me.email) { state = { open: false, messages: [] }; log.querySelectorAll('.sc-msg:not(:first-child)').forEach((n) => n.remove()); starters.hidden = false; setOpen(false, false); }
      state.who = me.email; save();
    };
    const w = window as any;
    if (w.tangibleStaff) setTimeout(() => checkWho(w.tangibleStaff));
    else document.addEventListener('tangible:staff', (e) => checkWho((e as CustomEvent).detail), { once: true });
    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    // Tiny, safe markdown: **bold**, [links](/path) to our own site / tel / mailto / https, "- " lists.
    function render(md: string) {
      const inline = (s: string) =>
        esc(s)
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/(^|[^*\w])\*([^*\n]+?)\*(?![*\w])/g, '$1<em>$2</em>')
          .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, text, href) => {
            const ok = /^(\/(?!\/)|tel:|mailto:|https:\/\/)/.test(href);
            if (!ok) return text;
            const ext = /^https:\/\//.test(href) && !href.startsWith(location.origin);
            return `<a href="${href}"${ext ? ' target="_blank" rel="noopener"' : ''}>${text}</a>`;
          });
      const out: string[] = [];
      let list: string[] = [];
      const flush = () => { if (list.length) { out.push(`<ul>${list.map((l) => `<li>${l}</li>`).join('')}</ul>`); list = []; } };
      for (const line of md.split('\n')) {
        const m = line.match(/^\s*[-*•]\s+(.*)$/);
        if (m) { list.push(inline(m[1])); continue; }
        flush();
        if (line.trim()) out.push(`<p>${inline(line)}</p>`);
      }
      flush();
      return out.join('');
    }

    function bubble(m: Msg) {
      const el = document.createElement('div');
      el.className = `sc-msg ${m.role === 'user' ? 'sc-user' : 'sc-bot'}`;
      if (m.role === 'user') el.textContent = m.content;
      else el.innerHTML = render(m.content);
      log.appendChild(el);
      return el;
    }
    const scroll = () => { log.scrollTop = log.scrollHeight; };

    state.messages.forEach(bubble);
    starters.hidden = state.messages.length > 0;

    function setOpen(open: boolean, focus = true) {
      state.open = open;
      panel.hidden = !open;
      root!.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('sc-lock', open && matchMedia('(max-width: 560px)').matches);
      save();
      if (open) { scroll(); if (focus) input.focus(); }
      else if (focus) toggle.focus();
    }
    if (state.open && !matchMedia('(max-width: 560px)').matches) setOpen(true, false);


    toggle.addEventListener('click', () => setOpen(panel.hidden));
    close.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });

    let busy = false;
    async function ask(text: string) {
      text = text.trim().slice(0, 600);
      if (!text || busy) return;
      busy = true;
      send.disabled = true;
      starters.hidden = true;
      const q: Msg = { role: 'user', content: text };
      state.messages.push(q);
      bubble(q);
      save();
      const wait = document.createElement('div');
      wait.className = 'sc-msg sc-bot sc-typing';
      wait.innerHTML = '<span></span><span></span><span></span>';
      wait.setAttribute('aria-label', 'Thinking');
      log.appendChild(wait);
      scroll();
      let reply = '';
      try {
        const res = await fetch('/api/staff-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: state.messages.slice(-12) }),
          credentials: 'same-origin',
        });
        if (res.status === 429) reply = "You're sending messages quickly, so please wait a minute and try again.";
        else reply = ((await res.json().catch(() => ({}))) as { reply?: string }).reply || '';
      } catch {}
      if (!reply) reply = "Sorry, I couldn't connect just now. Please try again in a moment.";
      wait.remove();
      const a: Msg = { role: 'assistant', content: reply };
      state.messages.push(a);
      bubble(a);
      save();
      scroll();
      busy = false;
      send.disabled = false;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value;
      input.value = '';
      input.style.height = '';
      ask(text);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });
    input.addEventListener('input', () => {
      input.style.height = '';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });
    starters.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (b) ask(b.textContent || '');
    });
  }
</script>

<style is:global>
  .sc { --sc-ink: #2f3530; --sc-dark: var(--charcoal, #3b3f3c); --sc-soft: #eef2ed; --sc-line: #e1e6e0; font-family: Poppins, system-ui, sans-serif; }
  /* Launch button: charcoal pill like the site's primary buttons */
  .sc-launch { position: fixed; right: 20px; bottom: 20px; z-index: 9000; display: inline-flex; align-items: center; gap: 9px; padding: 15px 26px 14px 22px; border: 2px solid transparent; border-radius: 300px; background: var(--charcoal, #3b3f3c); color: #fff; font-family: Poppins, system-ui, sans-serif; font-size: 15.5px; font-weight: 500; letter-spacing: .02em; line-height: 1.2; cursor: pointer; box-shadow: 0 8px 24px rgba(30, 36, 31, .25); transition: opacity .2s ease, transform .15s; }
  .sc-launch:hover { opacity: .88; transform: translateY(-1px); }
  .sc-launch:focus-visible { outline: 3px solid var(--sage, #acb9ac); outline-offset: 3px; }
  .sc-launch svg { width: 19px; height: 19px; flex: 0 0 auto; fill: currentColor; }
  .sc.is-open .sc-launch { display: none; }


  .sc-panel { position: fixed; right: 20px; bottom: 20px; z-index: 9001; width: 380px; height: min(620px, calc(100vh - 40px)); display: flex; flex-direction: column; background: #fff; color: var(--sc-ink); border-radius: 18px; box-shadow: 0 24px 60px rgba(30, 36, 31, .28); overflow: hidden; }
  .sc-panel[hidden] { display: none; }
  .sc-head { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: var(--charcoal, #3b3f3c); color: #fff; }
  .sc-head-av { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.14); display: grid; place-items: center; }
  .sc-head-av svg { width: 21px; height: 21px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sc-head-text { flex: 1 1 auto; min-width: 0; }
  .sc-head strong { display: block; font-size: 15.5px; font-weight: 600; }
  .sc-head em { margin-left: 6px; padding: 2px 7px 1px; border-radius: 300px; background: rgba(255, 255, 255, .2); font-size: 10.5px; font-style: normal; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; vertical-align: 2px; }
  .sc-head span { display: block; margin-top: 2px; font-size: 12px; }
  .sc-close { flex: 0 0 auto; display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .12); color: #fff; cursor: pointer; }
  .sc-close:hover { background: rgba(255, 255, 255, .25); }
  .sc-close svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }

  .sc-log { flex: 1 1 auto; overflow-y: auto; padding: 16px 14px 8px; display: flex; flex-direction: column; gap: 10px; overscroll-behavior: contain; }
  .sc-msg { max-width: 86%; padding: 10px 14px; border-radius: 16px; font-size: 14.5px; line-height: 1.55; overflow-wrap: anywhere; }
  .sc-msg p { margin: 0 0 .5em; }
  .sc-msg p:last-child { margin-bottom: 0; }
  .sc-msg ul { margin: .2em 0 .5em; padding-left: 1.15em; }
  .sc-msg ul:last-child { margin-bottom: 0; }
  .sc-msg li { margin: .15em 0; }
  .sc-bot { align-self: flex-start; background: var(--sc-soft); border-bottom-left-radius: 5px; }
  .sc-bot a { color: var(--sc-dark); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; }
  .sc-user { align-self: flex-end; background: var(--sc-dark); color: #fff; border-bottom-right-radius: 5px; white-space: pre-wrap; }
  .sc-typing { display: inline-flex; gap: 5px; padding: 14px 16px; }
  .sc-typing span { width: 7px; height: 7px; border-radius: 50%; background: #8a958b; animation: sc-dot 1.2s infinite ease-in-out; }
  .sc-typing span:nth-child(2) { animation-delay: .15s; }
  .sc-typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes sc-dot { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .sc-typing span { animation: none; } .sc-launch { transition: none; } }

  .sc-starters { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 14px 10px; }
  .sc-starters[hidden] { display: none; }
  .sc-chip { padding: 7px 12px 6px; border: 1px solid var(--sc-line); border-radius: 300px; background: #fff; color: var(--sc-ink); font: inherit; font-size: 13px; cursor: pointer; }
  .sc-chip:hover { border-color: var(--sc-dark); }

  .sc-form { display: flex; align-items: flex-end; gap: 8px; margin: 0 12px; padding: 6px 6px 6px 14px; border: 1px solid var(--sc-line); border-radius: 22px; background: #fff; }
  .sc-form:focus-within { border-color: var(--sc-dark); }
  .sc-form textarea { flex: 1 1 auto; min-height: 24px; max-height: 120px; margin: 0 0 6px; padding: 0; border: 0; outline: 0; resize: none; background: transparent; color: var(--sc-ink); font: inherit; font-size: 16px; line-height: 1.5; }
  .sc-send { flex: 0 0 auto; display: grid; place-items: center; width: 38px; height: 38px; border: 0; border-radius: 50%; background: var(--sc-dark); color: #fff; cursor: pointer; }
  .sc-send:disabled { opacity: .45; cursor: default; }
  .sc-send svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .sc-note { margin: 0; padding: 8px 16px 12px; font-size: 11.5px; line-height: 1.45; color: #5d665f; }
  .sc-note a { color: inherit; font-weight: 500; }
  .sc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 560px) {
    .sc-launch { right: 14px; bottom: 14px; padding: 13px 20px 12px 17px; font-size: 14.5px; }
        .sc-panel { inset: 0; width: auto; height: 100%; height: 100dvh; border-radius: 0; }
    .sc-note { padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
    html.sc-lock, html.sc-lock body { overflow: hidden; }
  }
  @media print { .sc { display: none; } }
</style>
