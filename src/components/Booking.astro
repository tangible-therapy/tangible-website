---
// "Book Online" — SimplePractice appointment-request widget, used on therapist pages.
interface Props { phone?: string }
const { phone = '(435) 260-5406' } = Astro.props;
const tel = 'tel:' + phone.replace(/\D/g, '');
---
<div class="booking">
  <h3>To book an appointment or join a waitlist</h3>
  <h3>Call <a href={tel} style="color:inherit;text-decoration:none">{phone}</a></h3>
  <div class="spwidget-button-wrapper">
    <a href="https://tangible.clientsecure.me" class="spwidget-button" data-spwidget-scope-id="db007d38-e4cc-4a0a-9e0c-5704b4664f65" data-spwidget-scope-uri="tangible" data-spwidget-application-id="7c72cb9f9a9b913654bb89d6c7b4e71a77911b30192051da35384b4d0c6d505b" data-spwidget-scope-global data-spwidget-autobind>Book Online</a>
  </div>
</div>
<script is:inline src="https://widget-cdn.simplepractice.com/assets/integration-1.0.js"></script>
<style is:global>
  .spwidget-button-wrapper { text-align: center; margin-top: 1.2rem; }
  .spwidget-button { display: inline-block; padding: 12px 24px; color: #000 !important; background: #fff; border: 0; border-radius: 50px; font-family: Arial, Helvetica, sans-serif; font-size: 1.5rem; font-weight: 400; text-decoration: none; letter-spacing: .75px; }
  .spwidget-button:hover { background: #f0f0f0; }
</style>
