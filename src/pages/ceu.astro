---
import GoogleForm from '../components/GoogleForm.astro';
import Base from '../layouts/Base.astro';
---
<Base title={"Free CEUs for Therapists | Tangible Therapy"} description={"Free monthly CEUs for mental health professionals. Topics ranging from OCD, imposter syndrome to ethics and suicide prevention CEU's. Join Tangible Mental Health for in-person or virtual continuing education events."}>
<section class="sec t-white h-custom">
<div class="sec-in" style="padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);">
<div class="fe" style="--rows:34;--mrows:18">
  <div class="b b-image jc" style="--d:1/1/34/27;--m:1/1/19/11;--mz:3"><figure class="img fill"><img src="/images/imgg-demo-zr0xvdxx-ee53d3.jpg" alt="Two people sitting at a table, one using a laptop and the other taking notes, with a vase of white calla lilies and a glass of water on the table." width="2560" height="1792" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:6/9/15/19;--m:5/3/12/9;--dz:4;--mz:6"><div class="rte"><h1 class="ta-center"><span class="c-white">Welcome to Free CEU’s at Tangible Therapy</span></h1></div></div>
  <div class="b b-html" style="--d:15/8/17/21;--m:13/2/17/10;--dz:5;--mz:7"><div class="rte"><p class="ta-center"><span class="c-white">At Tangible Therapy, our vision has always been to make high-quality, values-driven care more accessible and more human. That’s why, each month we’re offering free CEU’s.</span></p></div></div>
</div>
</div>
</section>

<section class="sec t-white-bold h-medium">
<div class="sec-in">
<div class="fe" style="--rows:19;--mrows:36">
  <div class="b b-html" style="--d:1/4/3/13;--m:1/2/3/10;--dz:3;--mz:3"><div class="rte"><h3 class="ta-center">Our Next Live Training</h3></div></div>
  <div class="b b-html" style="--d:1/15/3/24;--m:19/2/21/10;--dz:4;--mz:4"><div class="rte"><h3 class="ta-center">Featured Virtual Training</h3></div></div>
  <div class="b b-image jc" style="--d:3/4/18/13;--m:2/2/17/10;--dz:4;--mz:4"><figure class="img fill" style="--r:20px"><img src="/images/what-we-re-getting-wrong-with-pornography-treatmen-f76584.jpg" alt="" width="1545" height="2000" loading="lazy" decoding="async"></figure></div>
  <div class="b b-product" style="--d:3/16/19/23;--m:20/2/37/10;--dz:6;--mz:6"><a class="product-card" href="/ceus/p/suicidepreventionceu"><img src="/images/presenter-brady-clegg-lcsw-70688c.png" alt="" loading="lazy"><span>Talking About Suicide Without Fear: Suicide Prevention 2hr CEU</span></a></div>
  <div class="b b-button jc" style="--d:18/6/20/11;--m:17/3/19/9;--dz:5;--mz:5"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="/ceu#register">Register</a></div></div>
</div>
</div>
</section>

<section class="sec t-white h-medium">
<div class="sec-in">
<div class="fe" style="--rows:19;--mrows:25">
  <div class="b b-shape jc" style="--d:1/2/19/20;--m:1/2/19/10"><div class="shape" style="background:hsla(39, 58%, 92%, 1);border-radius:0px"></div></div>
  <div class="b b-shape jc" style="--d:1/16/19/25;--m:19/2/25/9;--dz:4;--mz:4"><div class="shape" style="background:hsla(var(--lightAccent-hsl), 1);border-radius:0px"></div></div>
  <div class="b b-html inset-m" style="--d:2/3/4/14;--m:1/2/4/10;--dz:2;--mz:2"><div class="rte"><h2>Upcoming Live Trainings</h2></div></div>
  <div class="b b-image jc" style="--d:2/17/20/26;--m:20/3/26/10;--dz:5;--mz:5"><figure class="img fill" style="--fp:42% 36%"><img src="/images/1z8a9832-581b2c.jpg" alt="A smiling woman, Kelley Graves MFT. Therapist that works with couples in Orem &amp; Provo Utah." width="2500" height="3117" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html inset-m" style="--d:5/3/11/14;--m:10/2/16/10;--dz:6;--mz:6"><div class="rte"><p>Friday October 30, 12:30-2pm Cost: Free</p><p class="lg">What We're Getting Wrong With Pornography Treatment: How to Move Beyond Behavior Management and Towards Attachment Healing </p><p>Presented by Michael Anderson, LMFT &amp; Founder, Empowered Families</p></div></div>
  <div class="b b-button jc inset-m" style="--d:15/5/17/10;--m:16/2/18/10;--dz:3;--mz:3"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="/ceu#register">Register</a></div></div>
</div>
</div>
</section>

<section class="sec t-white h-medium">
<div class="sec-in">
<div class="fe" style="--rows:15;--mrows:25">
  <div class="b b-html" style="--d:1/2/5/7;--m:1/2/4/10;--dz:13;--mz:13"><div class="rte"><h2>Virtual CEU Trainings</h2></div></div>
  <div class="b b-product" style="--d:1/8/16/14;--m:4/2/15/6;--dz:9;--mz:9"><a class="product-card" href="/ceus/p/suicidepreventionceu"><img src="/images/presenter-brady-clegg-lcsw-70688c.png" alt="" loading="lazy"><span>Talking About Suicide Without Fear: Suicide Prevention 2hr CEU</span></a></div>
  <div class="b b-product" style="--d:1/14/16/20;--m:4/6/15/10;--dz:10;--mz:10"><a class="product-card" href="/ceus/p/gottman-ceu"><img src="/images/gottman-f0a363.png" alt="" loading="lazy"><span>Effectively Helping Couples Using Gottman Principles 1.5hr CEU</span></a></div>
  <div class="b b-product" style="--d:1/20/14/26;--m:15/6/26/10;--dz:11;--mz:11"><a class="product-card" href="/ceus/p/more-trainings-coming-soon"><img src="/images/presenter-brady-clegg-lcsw-1-243d45.png" alt="" loading="lazy"><span>More Trainings Coming Soon!</span></a></div>
</div>
</div>
</section>

<section class="sec t-bright-inverse h-custom">
<div class="sec-in" style="padding-top: calc(1vmax / 10); padding-bottom: calc(1vmax / 10);">
<div class="fe" style="--rows:62;--mrows:75">
  <div class="b b-form" style="--d:2/12/23/24;--m:11/2/37/10;--dz:3;--mz:4"><GoogleForm id="1FAIpQLSe3lrzMD4FiSRh8IDOyNx-LOvIk0jgT9ReMwHhAAua99zyU-g" title="Live CEU Registration" height={1760} /></div>
  <div class="b b-html" style="--d:2/2/12/11;--m:2/2/11/10;--dz:5;--mz:6"><div class="rte"><h2>Live CEU Registration</h2><p>All In-Person CEU’s will be Hosted at our Orem office B location: 230 N Orem boulevard, Orem Utah 84057.</p><p>In-Person attendance is limited. </p><p>If you plan to attend in person please arrive 5-10 minutes early to ensure a prompt start time. </p></div></div>
  <div class="b b-horizontalrule jc" style="--d:23/4/25/24;--m:36/2/37/10;--dz:6;--mz:7"><hr></div>
  <div class="b b-html" style="--d:25/8/27/20;--m:48/2/55/10;--dz:2;--mz:3"><div class="rte"><h2 class="ta-center"><span class="c-darkAccent">Interested In Presenting?</span></h2></div></div>
  <div class="b b-html" style="--d:28/3/35/14;--m:51/2/60/10;--dz:10;--mz:8"><div class="rte"><p class="lg"><span class="c-black">We are looking for specialized and informed therapists who are interested in helping education and CEUs be more accessible. If you are interested in providing a free CEU to the community, we’d love to connect. Click the button below to complete our CEU Presenter Form. </span></p></div></div>
  <div class="b b-image jc" style="--d:28/15/42/22;--m:37/1/48/11;--dz:11;--mz:2"><figure class="img fill" style="--r:10px;--fit:contain"><img src="/images/imgg-5i8-av2k6nyv-cc1c88.jpg" alt="" width="597" height="896" loading="lazy" decoding="async"></figure></div>
  <div class="b b-button jc" style="--d:35/5/37/11;--m:60/2/62/10;--dz:12;--mz:9"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="/presenter-application">Apply to Present</a></div></div>
  <div class="b b-image jc" style="--d:45/1/63/27;--m:63/1/76/11;--dz:4;--mz:5"><figure class="img fill"><img src="/images/imgg-demo-aq8h491f-0b0273.jpg" alt="Two people sitting at a table, engaged in work. One is typing on a laptop, the other taking notes in a notebook. A small table lamp and glasses of water are on the table." width="2560" height="1792" loading="lazy" decoding="async"></figure></div>
</div>
</div>
</section>
</Base>
