---
import Base from '../layouts/Base.astro';

// Live CEU registration happens on Teachable (Tangible Academy). The Zoom link is inside the course.
const registerUrl = 'https://academy.tangiblementalhealth.com/l/pdp/what-we-re-getting-wrong-with-pornography-treatment';
---
<Base title={"Free CEUs for Therapists | Tangible Therapy"} description={"Free monthly CEUs for mental health professionals. Topics ranging from OCD, imposter syndrome to ethics and suicide prevention CEU's. Join Tangible Mental Health for in-person or virtual continuing education events."}>
<section class="sec t-white h-custom">
<div class="sec-in" style="padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);">
<div class="fe" style="--rows:34;--mrows:18">
  <div class="b b-image jc" style="--d:1/1/34/27;--m:1/1/19/11;--mz:3"><figure class="img fill"><img src="/images/imgg-demo-zr0xvdxx-ee53d3.jpg" alt="Two people sitting at a table, one using a laptop and the other taking notes, with a vase of white calla lilies and a glass of water on the table." width="2560" height="1792" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:6/9/15/19;--m:5/3/12/9;--dz:4;--mz:6"><div class="rte"><h1 class="ta-center"><span class="c-white">Welcome to Free CEU’s at Tangible Therapy</span></h1></div></div>
  <div class="b b-html" style="--d:15/8/17/21;--m:13/2/17/10;--dz:5;--mz:7"><div class="rte"><p class="ta-center"><span class="c-white">At Tangible Therapy, our vision has always been to make high-quality, values-driven care more accessible and more human. That’s why, each month we’re offering free CEU’s.</span></p></div></div>
</div>
</div>
</section>

<section class="sec t-white-bold ceu-live" id="register">
  <div class="wrap ceu-live-in">
    <a class="ceu-live-img" href={registerUrl} target="_blank" rel="noopener">
      <img src="/images/what-we-re-getting-wrong-with-pornography-treatmen-f76584.jpg" alt="Free CEU flyer: What We're Getting Wrong With Pornography Treatment, presented by Michael Anderson, LMFT, Friday October 30, 12:30-2pm, in person and virtual." width="1545" height="2000" loading="lazy" decoding="async">
    </a>
    <div class="ceu-live-info">
      <p class="ceu-live-tag">Our Next Live Training</p>
      <h2>What We're Getting Wrong With Pornography Treatment</h2>
      <p class="ceu-live-sub">How to Move Beyond Behavior Management and Towards Attachment Healing</p>
      <ul class="ceu-live-facts">
        <li><strong>When:</strong> Friday, October 30, 12:30–2pm</li>
        <li><strong>Presenter:</strong> Michael Anderson, LMFT &amp; Founder, Empowered Families</li>
        <li><strong>Where:</strong> Live on Zoom, or in person at our Orem office B, 230 N Orem Boulevard, Orem, Utah 84057 (in-person seating is limited)</li>
        <li><strong>Cost:</strong> Free</li>
      </ul>
      <a class="btn btn-primary btn-medium" href={registerUrl} target="_blank" rel="noopener">Register</a>
      <p class="ceu-live-note">Registration is through Tangible Academy. Once you're registered, the Zoom link is waiting inside the course. If you're coming in person, please arrive 5–10 minutes early.</p>
    </div>
  </div>
</section>

<section class="sec t-white h-medium">
<div class="sec-in">
<div class="fe" style="--rows:15;--mrows:25">
  <div class="b b-html" style="--d:1/2/5/7;--m:1/2/4/10;--dz:13;--mz:13"><div class="rte"><h2>Virtual CEU Trainings</h2></div></div>
  <div class="b b-product" style="--d:1/8/16/14;--m:4/2/15/6;--dz:9;--mz:9"><a class="product-card" href="/ceus/p/suicidepreventionceu"><img src="/images/presenter-brady-clegg-lcsw-70688c.png" alt="Talking About Suicide Without Fear, a practice-focused CEU workshop presented by Brady Clegg, LCSW, Tangible Therapy" loading="lazy"><span>Talking About Suicide Without Fear: Suicide Prevention 2hr CEU</span></a></div>
  <div class="b b-product" style="--d:1/14/16/20;--m:4/6/15/10;--dz:10;--mz:10"><a class="product-card" href="/ceus/p/gottman-ceu"><img src="/images/gottman-f0a363.png" alt="Effectively Helping Couples Through the Gottman Method, a 90-minute CEU workshop with Skyler Anderson, AMFT, Tangible Therapy" loading="lazy"><span>Effectively Helping Couples Using Gottman Principles 1.5hr CEU</span></a></div>
  <div class="b b-product" style="--d:1/20/14/26;--m:15/6/26/10;--dz:11;--mz:11"><a class="product-card" href="/ceus/p/more-trainings-coming-soon"><img src="/images/presenter-brady-clegg-lcsw-1-243d45.png" alt="More CEU trainings coming soon from Tangible Therapy" loading="lazy"><span>More Trainings Coming Soon!</span></a></div>
</div>
</div>
</section>

<section class="sec t-bright-inverse h-custom">
<div class="sec-in" style="padding-top: calc(1vmax / 10); padding-bottom: calc(1vmax / 10);">
<div class="fe" style="--rows:39;--mrows:40">
  <div class="b b-image jc" style="--d:5/15/19/22;--m:1/1/12/11;--dz:11;--mz:2"><figure class="img fill" style="--r:10px;--fit:contain"><img src="/images/imgg-5i8-av2k6nyv-cc1c88.jpg" alt="A presenter leads a small group of therapists in a CEU training at Tangible Therapy in Utah" width="597" height="896" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:2/8/4/20;--m:13/2/15/10;--dz:2;--mz:3"><div class="rte"><h2 class="ta-center"><span class="c-darkAccent">Interested In Presenting?</span></h2></div></div>
  <div class="b b-html" style="--d:5/3/12/14;--m:16/2/25/10;--dz:10;--mz:8"><div class="rte"><p class="lg"><span class="c-black">We are looking for specialized and informed therapists who are interested in helping education and CEUs be more accessible. If you are interested in providing a free CEU to the community, we’d love to connect. Click the button below to complete our CEU Presenter Form. </span></p></div></div>
  <div class="b b-button jc" style="--d:12/5/14/11;--m:25/2/27/10;--dz:12;--mz:9"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="/presenter-application">Apply to Present</a></div></div>
  <div class="b b-image jc" style="--d:22/1/40/27;--m:28/1/41/11;--dz:4;--mz:5"><figure class="img fill"><img src="/images/imgg-demo-aq8h491f-0b0273.jpg" alt="Two people sitting at a table, engaged in work. One is typing on a laptop, the other taking notes in a notebook. A small table lamp and glasses of water are on the table." width="2560" height="1792" loading="lazy" decoding="async"></figure></div>
</div>
</div>
</section>
</Base>

<style is:global>
/* ---------- /ceu: next live training (registration on Teachable) ---------- */
.ceu-live { background: #fff; }
.ceu-live-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-top: 3.5rem; padding-bottom: 3.5rem; max-width: 1200px; }
.ceu-live-img img { width: 100%; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.08); transition: transform .2s; }
.ceu-live-img:hover img { transform: translateY(-3px); }
.ceu-live-tag { text-transform: uppercase; letter-spacing: .14em; font-size: .78rem; font-weight: 500; color: var(--forest); margin: 0 0 .8rem; }
.ceu-live-info h2 { color: var(--charcoal); margin-bottom: .4rem; }
.ceu-live-sub { font-size: var(--p-lg); color: var(--slate); margin: 0 0 1.6rem; line-height: 1.5; }
.ceu-live-facts { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: .65rem; }
.ceu-live-facts li { padding: .7rem 1.1rem; border-radius: 14px; background: #f1f4f1; line-height: 1.55; color: var(--charcoal); }
.ceu-live-facts strong { font-weight: 500; }
.ceu-live-info .btn { min-width: 14rem; text-align: center; }
.ceu-live-note { font-size: var(--p-sm); color: var(--charcoal); margin: 1.2rem 0 0; max-width: 52ch; }
@media (max-width: 900px) {
  .ceu-live-in { grid-template-columns: 1fr; padding-top: 2rem; padding-bottom: 2.5rem; }
  .ceu-live-img { max-width: 420px; margin: 0 auto; width: 100%; }
  .ceu-live-info .btn { display: block; }
}
</style>

