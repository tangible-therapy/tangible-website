---
// Supervision hours tracker (staff-only; data from /api/hours, see netlify/functions/hours.mts).
// Associates submit each pay period's supervised hours on Submit Hours (/employeeportal/submit-hours); they show
// up here as one entry per pay period. This page adds past hours in bulk (a date range) for catching up or hours
// outside a pay period. Their supervisor approves everything.
// Supervisors link their own supervisees and see everyone's progress. No client information is stored.
import Base from '../layouts/Base.astro';
import { LICENSES } from '../data/hours';
---
<Base title="Supervision Hours | Tangible Therapy" description="Log and approve supervised hours toward licensure." noindex>
  <section class="sec t-light hr">
    <div class="sec-in"><div class="wrap hr-wrap">
      <header class="hr-head">
        <p class="hr-eyebrow">Licensure</p>
        <h1>Supervision Hours</h1>
        <p class="hr-lede" >Your supervised hours toward licensure. Each pay period they come in through <a href="/employeeportal/submit-hours">Submit Hours</a>. Your supervisor approves them, and only approved hours count toward your totals.</p>
        <div class="hr-tabs" role="tablist" id="hr-tabs" hidden>
          <button type="button" role="tab" data-tab="mine" aria-selected="true">My hours</button>
          <button type="button" role="tab" data-tab="team" aria-selected="false">My supervisees</button>
        </div>
      </header>
      <div id="hr-alert" class="hr-alert" role="status" hidden></div>

      <!-- ===== My hours ===== -->
      <div data-pane="mine">
        <div class="hr-card hr-status" id="hr-status"><p class="hr-muted">Loading…</p></div>

        <div class="hr-cols">
          <article class="hr-card">
            <h2 id="hr-form-title">Add past hours</h2>
            <p class="hr-muted small hr-form-help" id="hr-form-help">For hours from before you started using <a href="/employeeportal/submit-hours">Submit Hours</a> (to bring your Supervision Hours up to date), or hours outside a pay period. Enter the totals for the whole date range.</p>
            <form id="hr-form" novalidate>
              <div class="hr-nums">
                <label class="hr-field"><span>From</span><input type="date" name="date" required /></label>
                <label class="hr-field"><span>To</span><input type="date" name="end" required /></label>
              </div>
              <div class="hr-nums">
                <label class="hr-field"><span>Direct client care</span><input type="number" name="direct" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                <label class="hr-field"><span>Individual supervision</span><input type="number" name="individual" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                <label class="hr-field"><span>Group supervision</span><input type="number" name="group" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                <label class="hr-field"><span>…of which direct observation</span><input type="number" name="observation" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                <label class="hr-field hr-wide"><span>Other work time <small>(notes, admin, trainings, consults…)</small></span><input type="number" name="other" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
              </div>
              <p class="hr-muted small" id="hr-week-total" aria-live="polite"></p>
              <p class="hr-err" id="hr-form-err" hidden></p>
              <div class="hr-actions">
                <button class="hr-btn primary" type="submit" id="hr-save">Add past hours</button>
                <button class="hr-btn" type="button" id="hr-cancel" hidden>Cancel edit</button>
              </div>
            </form>
          </article>

          <article class="hr-card">
            <div class="hr-row-head"><h2>My entries</h2><button class="hr-btn small" type="button" id="hr-csv-mine">Download CSV</button></div>
            <div id="hr-entries"></div>
          </article>
        </div>
      </div>

      <!-- ===== Supervisor view ===== -->
      <div data-pane="team" hidden>
        <div class="hr-card">
          <div class="hr-row-head">
            <h2>My supervisees</h2>
            <form id="hr-add" class="hr-add">
              <select name="email" aria-label="Choose a supervisee" required><option value="">Add an associate…</option></select>
              <select name="license" aria-label="License">{LICENSES.map((l) => <option value={l.id}>{l.label} → {l.goal}</option>)}</select>
              <button class="hr-btn primary small" type="submit">Add</button>
            </form>
          </div>
          <div id="hr-team"><p class="hr-muted">Loading…</p></div>
        </div>

        <div class="hr-card" id="hr-detail" hidden>
          <div class="hr-row-head">
            <div><p class="hr-eyebrow dark" id="hr-d-license"></p><h2 id="hr-d-name"></h2></div>
            <div class="hr-actions">
              <button class="hr-btn small" type="button" id="hr-d-csv">Download CSV</button>
              <button class="hr-btn small" type="button" id="hr-d-close">Close</button>
            </div>
          </div>
          <div id="hr-d-progress"></div>
          <div class="hr-row-head"><h3>Waiting for your approval</h3><button class="hr-btn primary small" type="button" id="hr-d-approve-all" hidden>Approve all</button></div>
          <div id="hr-d-pending"></div>
          <h3>All entries</h3>
          <div id="hr-d-entries"></div>
          <details class="hr-settings">
            <summary>License and targets</summary>
            <form id="hr-d-settings">
              <div class="hr-nums">
                <label class="hr-field"><span>License</span><select name="license">{LICENSES.map((l) => <option value={l.id}>{l.label} → {l.goal}</option>)}</select></label>
                <label class="hr-field"><span>Supervision started</span><input type="date" name="startDate" /></label>
                <label class="hr-field"><span>Total hours target</span><input type="number" name="total" min="0" step="1" /></label>
                <label class="hr-field"><span>Direct client care target</span><input type="number" name="direct" min="0" step="1" /></label>
                <label class="hr-field"><span>Supervision target</span><input type="number" name="supervision" min="0" step="1" /></label>
                <label class="hr-field"><span>Direct observation target</span><input type="number" name="observation" min="0" step="1" /></label>
                <label class="hr-field"><span>Group supervision that can count (max)</span><input type="number" name="groupMax" min="0" step="1" /></label>
              </div>
              <p class="hr-muted small">Defaults follow Utah Code 58-60-405 (July 2026). Requirements vary by license and issue date, so check with DOPL.</p>
              <div class="hr-actions">
                <button class="hr-btn primary small" type="submit">Save</button>
                <button class="hr-btn small danger" type="button" id="hr-d-unlink">Stop supervising</button>
              </div>
            </form>
          </details>
        </div>
      </div>
    </div></div>
  </section>

  <script is:inline define:vars={{ LICENSES }}>
    (function () {
      var API = '/api/hours', $ = function (id) { return document.getElementById(id); };
      var mine = null, team = null, detail = null, editing = null;
      var LIC = {}; LICENSES.forEach(function (l) { LIC[l.id] = l; });

      function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
      function h(n) { n = Math.round(n * 100) / 100; return n.toLocaleString('en-US') + (n === 1 ? ' hr' : ' hrs'); }
      function fmtDate(iso) { return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
      function addDays(iso, n) { var x = new Date(iso + 'T12:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); }
      function fmtRange(a, b) { return a === b ? fmtDate(a) : new Date(a + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' – ' + fmtDate(b); }
      function entryTitle(e) {
        if (e.kind === 'period') return 'Pay period ' + fmtRange(e.date, e.end || e.date);
        if (e.kind === 'bulk') return 'Past hours ' + fmtRange(e.date, e.end || e.date);
        return (e.kind === 'week' ? 'Week of ' : '') + fmtDate(e.date);
      }
      var KIND = { week: 'Week', session: 'Session', bulk: 'Past hours (bulk)', period: 'Pay period' };
      function notify(t, bad) { var a = $('hr-alert'); a.textContent = t; a.className = 'hr-alert' + (bad ? ' bad' : ''); a.hidden = false; clearTimeout(notify.t); notify.t = setTimeout(function () { a.hidden = true; }, 6000); }
      function call(method, qs, body) {
        return fetch(API + (qs || ''), { method: method, credentials: 'same-origin', headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined })
          .then(function (r) { return r.json().then(function (b) { if (!r.ok) throw new Error(b.error || 'Something went wrong.'); return b; }); });
      }
      var STATUS = { pending: 'Waiting for approval', approved: 'Approved', returned: 'Sent back' };

      // ---------- progress ----------
      function progress(link, approved, pending) {
        var wrap = el('div', 'hr-progress');
        var t = Object.assign({}, LICENSES[0].targets, link ? link.targets : {});
        var groupCounted = Math.min(approved.group, t.groupMax);
        var rows = [
          ['Total hours', approved.total || 0, pending.total || 0, t.total],
          ['Direct client care', approved.direct, pending.direct, t.direct],
          ['Supervision', approved.individual + groupCounted, pending.individual + pending.group, t.supervision, approved.group > t.groupMax ? 'Only ' + t.groupMax + ' group supervision hours can count (' + h(approved.group) + ' logged).' : ''],
          ['Direct observation', approved.observation, pending.observation, t.observation],
        ];
        rows.forEach(function (r) {
          var pct = r[3] ? Math.min(100, (r[1] / r[3]) * 100) : 0, ppct = r[3] ? Math.min(100 - pct, (r[2] / r[3]) * 100) : 0;
          var row = el('div', 'hr-bar');
          var top = el('div', 'hr-bar-top');
          top.appendChild(el('span', 'lab', r[0]));
          top.appendChild(el('span', 'val', h(r[1]) + ' of ' + r[3].toLocaleString('en-US') + (r[2] ? '  ·  ' + h(r[2]) + ' waiting' : '')));
          row.appendChild(top);
          var track = el('div', 'hr-track'); track.setAttribute('role', 'progressbar'); track.setAttribute('aria-label', r[0]); track.setAttribute('aria-valuenow', String(Math.round(pct))); track.setAttribute('aria-valuemin', '0'); track.setAttribute('aria-valuemax', '100');
          var f = el('span', 'fill'); f.style.width = pct + '%'; track.appendChild(f);
          var p = el('span', 'pend'); p.style.width = ppct + '%'; track.appendChild(p);
          row.appendChild(track);
          if (r[4]) row.appendChild(el('p', 'hr-note', r[4]));
          wrap.appendChild(row);
        });
        return wrap;
      }

      // ---------- entries table ----------
      function entryList(entries, opts) {
        var box = el('div', 'hr-list');
        var list = entries.slice().sort(function (a, b) { return a.date < b.date ? 1 : a.date > b.date ? -1 : 0; });
        if (!list.length) { box.appendChild(el('p', 'hr-muted', opts.empty || 'No entries yet.')); return box; }
        list.forEach(function (e) {
          var row = el('div', 'hr-entry ' + e.status);
          var head = el('div', 'hr-entry-head');
          head.appendChild(el('strong', null, entryTitle(e)));
          head.appendChild(el('span', 'hr-chip ' + e.status, STATUS[e.status]));
          row.appendChild(head);
          var parts = [];
          if (e.direct) parts.push('Direct ' + h(e.direct));
          if (e.individual) parts.push('Individual sup. ' + h(e.individual));
          if (e.group) parts.push('Group sup. ' + h(e.group));
          if (e.observation) parts.push('Observation ' + h(e.observation));
          if (e.other) parts.push('Other ' + h(e.other));
          var tot = e.direct + e.individual + e.group + (e.other || 0);
          head.insertBefore(el('span', 'hr-entry-total', h(tot)), head.lastChild);
          row.appendChild(el('p', 'hr-entry-hours', parts.join(' · ')));
          if (e.kind === 'period' && opts.mine) row.appendChild(el('p', 'hr-muted small', 'From Submit Hours. To change it, submit your hours again for that pay period.'));
          if (e.supervisorNote && e.status === 'returned') row.appendChild(el('p', 'hr-entry-sup', 'Supervisor: ' + e.supervisorNote));
          var btns = el('div', 'hr-actions');
          (opts.buttons(e) || []).forEach(function (b) { var x = el('button', 'hr-btn small' + (b.cls ? ' ' + b.cls : ''), b.label); x.type = 'button'; x.onclick = b.go; btns.appendChild(x); });
          if (btns.children.length) row.appendChild(btns);
          box.appendChild(row);
        });
        return box;
      }

      // ---------- CSV ----------
      function csv(log, who) {
        var rows = [['Supervisee', 'Type', 'From', 'To', 'Direct client care', 'Individual supervision', 'Group supervision', 'Direct observation', 'Other work time', 'Total', 'Status', 'Reviewed by', 'Reviewed at']];
        log.entries.slice().sort(function (a, b) { return a.date < b.date ? -1 : 1; }).forEach(function (e) {
          rows.push([who, KIND[e.kind] || e.kind, e.date, e.end || (e.kind === 'week' ? addDays(e.date, 6) : e.date), e.direct, e.individual, e.group, e.observation, e.other || 0, e.direct + e.individual + e.group + (e.other || 0), STATUS[e.status], e.reviewedBy || '', e.reviewedAt ? e.reviewedAt.slice(0, 10) : '']);
        });
        var text = rows.map(function (r) { return r.map(function (c) { c = String(c); if (/^[=+\-@]/.test(c)) c = "'" + c; return /[",\n]/.test(c) ? '"' + c.replace(/"/g, '""') + '"' : c; }).join(','); }).join('\n');
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([text], { type: 'text/csv' }));
        a.download = 'supervision-hours-' + who.replace(/[^a-z0-9]+/gi, '-').toLowerCase() + '.csv';
        document.body.appendChild(a); a.click(); a.remove();
      }

      // ---------- My hours ----------
      function renderMine() {
        var s = $('hr-status'); s.innerHTML = '';
        var top = el('div', 'hr-row-head');
        var who = el('div');
        if (mine.link) {
          var l = LIC[mine.link.license] || LICENSES[0];
          who.appendChild(el('p', 'hr-eyebrow dark', l.label + ' → ' + l.goal));
          who.appendChild(el('h2', null, 'Supervisor: ' + mine.supervisorName));
        } else {
          who.appendChild(el('h2', null, 'No supervisor linked yet'));
          who.appendChild(el('p', 'hr-muted', 'Your hours are saved now. Ask your supervisor to add you in Supervision Hours; your entries will then go to them for approval.'));
        }
        top.appendChild(who); s.appendChild(top);
        s.appendChild(progress(mine.link, mine.approved, mine.pending));

        var box = $('hr-entries'); box.innerHTML = '';
        box.appendChild(entryList(mine.log.entries, {
          mine: true,
          empty: 'Nothing yet. Submit your hours each pay period on Submit Hours, and add any past hours on the left.',
          buttons: function (e) {
            if (e.status === 'approved' || e.kind === 'period') return [];
            return [
              { label: 'Edit', go: function () { startEdit(e); } },
              { label: 'Delete', cls: 'danger', go: function () { if (confirm('Delete this entry?')) save({ action: 'delete', id: e.id }, 'Entry deleted.'); } },
            ];
          },
        }));
      }
      function startEdit(e) {
        editing = e; var f = $('hr-form');
        ['direct', 'individual', 'group', 'observation', 'other'].forEach(function (k) { f.elements[k].value = e[k] || ''; });
        f.elements.date.value = e.date;
        f.elements.end.value = e.end || (e.kind === 'week' ? addDays(e.date, 6) : e.date);
        weekTotal();
        $('hr-form-title').textContent = 'Edit entry'; $('hr-save').textContent = 'Save changes'; $('hr-cancel').hidden = false;
        f.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      function resetForm() {
        editing = null; var f = $('hr-form'); f.reset();
        var today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        f.elements.date.max = today; f.elements.end.max = today;
        $('hr-form-title').textContent = 'Add past hours'; $('hr-save').textContent = 'Add past hours'; $('hr-cancel').hidden = true; $('hr-form-err').hidden = true;
        weekTotal();
      }
      function weekTotal() {
        var f = $('hr-form'), sum = 0;
        ['direct', 'individual', 'group', 'other'].forEach(function (k) { sum += Number(f.elements[k].value) || 0; });
        $('hr-week-total').textContent = sum ? 'Counts toward your total: ' + h(sum) : '';
        if (f.elements.date.value) f.elements.end.min = f.elements.date.value;
      }
      ['direct', 'individual', 'group', 'other'].forEach(function (k) { $('hr-form').elements[k].addEventListener('input', weekTotal); });
      function save(body, msg) {
        return call('POST', '', body).then(function (b) { mine = Object.assign(mine, b); renderMine(); notify(msg); return b; }).catch(function (e) { notify(e.message, true); throw e; });
      }
      $('hr-form').addEventListener('submit', function (ev) {
        ev.preventDefault();
        var f = this, entry = { kind: 'bulk', date: f.elements.date.value, end: f.elements.end.value || f.elements.date.value };
        ['direct', 'individual', 'group', 'observation', 'other'].forEach(function (k) { entry[k] = f.elements[k].value === '' ? 0 : Number(f.elements[k].value); });
        $('hr-save').disabled = true;
        save(editing ? { action: 'edit', id: editing.id, entry: entry } : { action: 'add', entry: entry }, editing ? 'Entry updated and sent for approval.' : 'Past hours added and sent for approval.')
          .then(resetForm)
          .catch(function (e) { $('hr-form-err').textContent = e.message; $('hr-form-err').hidden = false; })
          .finally(function () { $('hr-save').disabled = false; });
      });
      $('hr-form').elements.date.addEventListener('change', weekTotal);
      $('hr-cancel').onclick = resetForm;
      $('hr-csv-mine').onclick = function () { csv(mine.log, mine.superviseeName || 'me'); };

      // ---------- Supervisor ----------
      function loadTeam() {
        return call('GET', '?view=team').then(function (b) { team = b; renderTeam(); }).catch(function (e) { $('hr-team').innerHTML = ''; $('hr-team').appendChild(el('p', 'hr-err', e.message)); });
      }
      function renderTeam() {
        var sel = $('hr-add').elements.email; sel.innerHTML = '';
        var o0 = el('option', null, team.available.length ? 'Add an associate…' : 'No associates to add'); o0.value = ''; sel.appendChild(o0);
        team.available.forEach(function (p) { var o = el('option', null, p.name + (p.supervisor ? ' (now with ' + p.supervisorName + ')' : '')); o.value = p.email; sel.appendChild(o); });

        var box = $('hr-team'); box.innerHTML = '';
        if (!team.supervisees.length) { box.appendChild(el('p', 'hr-muted', 'No supervisees yet. Choose an associate above to add them. Only staff with the Associate role are listed.')); return; }
        var grid = el('div', 'hr-team');
        team.supervisees.sort(function (a, b) { return b.pendingCount - a.pendingCount || a.superviseeName.localeCompare(b.superviseeName); }).forEach(function (s) {
          var card = el('button', 'hr-person'); card.type = 'button';
          var top = el('div', 'hr-person-top');
          top.appendChild(el('strong', null, s.superviseeName));
          if (s.pendingCount) top.appendChild(el('span', 'hr-chip pending', s.pendingCount + ' to review'));
          card.appendChild(top);
          var l = LIC[s.link.license] || LICENSES[0];
          card.appendChild(el('span', 'hr-muted small', l.label + ' → ' + l.goal + (team.overseer && s.supervisor !== team.me ? ' · supervisor: ' + s.supervisorName : '')));
          var t = Object.assign({}, LICENSES[0].targets, s.link.targets), pct = t.total ? Math.min(100, (s.approved.total || 0) / t.total * 100) : 0;
          var track = el('div', 'hr-track thin'); var f = el('span', 'fill'); f.style.width = pct + '%'; track.appendChild(f); card.appendChild(track);
          card.appendChild(el('span', 'hr-muted small', h(s.approved.total || 0) + ' of ' + t.total.toLocaleString('en-US') + ' total · ' + h(s.approved.direct) + ' of ' + t.direct.toLocaleString('en-US') + ' direct · ' + h(s.approved.individual + Math.min(s.approved.group, t.groupMax)) + ' of ' + t.supervision.toLocaleString('en-US') + ' supervision' + (s.lastEntry ? ' · last entry ' + fmtDate(s.lastEntry) : '')));
          card.onclick = function () { openDetail(s.supervisee); };
          grid.appendChild(card);
        });
        box.appendChild(grid);
      }
      $('hr-add').addEventListener('submit', function (ev) {
        ev.preventDefault();
        var email = this.elements.email.value, license = this.elements.license.value;
        if (!email) return;
        var pick = team.available.filter(function (p) { return p.email === email; })[0];
        if (pick && pick.supervisor && !confirm(pick.name + ' is supervised by ' + pick.supervisorName + '. Move them to you?')) return;
        call('POST', '', { action: 'link', email: email, license: license }).then(function () { notify('Added ' + (pick ? pick.name : email) + '.'); return loadTeam(); }).catch(function (e) { notify(e.message, true); });
      });

      function openDetail(email) {
        call('GET', '?view=log&email=' + encodeURIComponent(email)).then(function (b) { detail = b; renderDetail(); $('hr-detail').hidden = false; $('hr-detail').scrollIntoView({ behavior: 'smooth', block: 'start' }); }).catch(function (e) { notify(e.message, true); });
      }
      function review(ids, decision, note) {
        return call('POST', '', { action: 'review', email: detail.supervisee, ids: ids, decision: decision, note: note })
          .then(function (b) { detail = Object.assign(detail, b); renderDetail(); loadTeam(); notify(decision === 'approve' ? 'Approved.' : decision === 'return' ? 'Sent back with your note.' : 'Reopened.'); })
          .catch(function (e) { notify(e.message, true); });
      }
      function renderDetail() {
        var l = LIC[detail.link ? detail.link.license : 'acmhc'] || LICENSES[0];
        $('hr-d-license').textContent = l.label + ' → ' + l.goal + (detail.link && detail.link.startDate ? ' · since ' + fmtDate(detail.link.startDate) : '');
        $('hr-d-name').textContent = detail.superviseeName;
        var p = $('hr-d-progress'); p.innerHTML = ''; p.appendChild(progress(detail.link, detail.approved, detail.pending));
        var pend = detail.log.entries.filter(function (e) { return e.status === 'pending'; });
        $('hr-d-approve-all').hidden = !(pend.length > 1 && detail.canReview);
        var buttons = function (e) {
          if (!detail.canReview) return [];
          if (e.status === 'approved') return [{ label: 'Reopen', go: function () { review([e.id], 'reopen'); } }];
          if (e.status === 'returned') return [{ label: 'Approve', cls: 'primary', go: function () { review([e.id], 'approve'); } }];
          return [
            { label: 'Approve', cls: 'primary', go: function () { review([e.id], 'approve'); } },
            { label: 'Send back', go: function () { var n = prompt('What should they fix? (No client details.)'); if (n !== null) review([e.id], 'return', n); } },
          ];
        };
        $('hr-d-pending').innerHTML = ''; $('hr-d-pending').appendChild(entryList(pend, { empty: 'Nothing waiting. You’re all caught up.', buttons: buttons }));
        $('hr-d-entries').innerHTML = ''; $('hr-d-entries').appendChild(entryList(detail.log.entries.filter(function (e) { return e.status !== 'pending'; }), { empty: 'No reviewed entries yet.', buttons: buttons }));
        var f = $('hr-d-settings'), t = Object.assign({}, l.targets, detail.link ? detail.link.targets : {});
        f.elements.license.value = detail.link ? detail.link.license : 'acmhc';
        f.elements.startDate.value = (detail.link && detail.link.startDate) || '';
        ['total', 'direct', 'supervision', 'observation', 'groupMax'].forEach(function (k) { f.elements[k].value = t[k]; });
      }
      $('hr-d-approve-all').onclick = function () { review(detail.log.entries.filter(function (e) { return e.status === 'pending'; }).map(function (e) { return e.id; }), 'approve'); };
      $('hr-d-close').onclick = function () { $('hr-detail').hidden = true; detail = null; };
      $('hr-d-csv').onclick = function () { csv(detail.log, detail.superviseeName); };
      $('hr-d-settings').addEventListener('submit', function (ev) {
