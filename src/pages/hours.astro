---
// Supervision hours tracker (staff-only; data from /api/hours, see netlify/functions/hours.mts).
// Associates submit each pay period's supervised hours on Submit Hours (/employeeportal/submit-hours); they show
// up here as one entry per pay period. This page adds past hours in bulk (a date range) for catching up or hours
// outside a pay period. Their supervisor approves everything.
// Supervisors link their own supervisees and see everyone's progress. No client information is stored.
import Base from '../layouts/Base.astro';
import { LICENSES, licenseFromCredential, DOPL_NOTES, DOPL_BY_LICENSE } from '../data/hours';
import { getFinderData } from '../lib/therapist-sheet';
// Credentials from the therapists' website profiles (public info), keyed by normalized name, so adding a
// supervisee can fill in their license automatically. Rebuilt whenever the therapist sheet rebuilds the site.
const normName = (n: string) => n.toLowerCase().normalize('NFD').replace(/[^a-z ]/g, '').replace(/\s+/g, ' ').trim();
const CREDS: Record<string, { credential: string; license: string | null }> = {};
for (const t of (await getFinderData()).therapists) {
  if (!t.credential) continue;
  const v = { credential: t.credential, license: licenseFromCredential(t.credential) };
  const n = normName(t.name).split(' ');
  CREDS[n.join(' ')] = v;
  if (n.length > 2) CREDS[n[0] + ' ' + n[n.length - 1]] ??= v; // "Mary Ann Smith" → also "mary smith"
}
---
<Base title="Supervision Hours | Tangible Therapy" description="Log and approve supervised hours toward licensure." noindex>
  <section class="sec t-light hr">
    <div class="sec-in"><div class="wrap hr-wrap">
      <header class="hr-head">
        <p class="hr-eyebrow">Licensure</p>
        <h1>Supervision Hours</h1>
        <p class="hr-lede" >Your supervised hours toward licensure. Each pay period they come in through <a href="/employeeportal/submit-hours">Submit Hours</a>. Your supervisor approves them, and only approved hours count toward your totals.</p>
        <div class="hr-tabs" role="tablist" id="hr-tabs" hidden>
          <button type="button" role="tab" data-tab="mine" aria-selected="true">My hours</button>
          <button type="button" role="tab" data-tab="team" aria-selected="false">My supervisees</button>
        </div>
      </header>
      <div id="hr-alert" class="hr-alert" role="status" hidden></div>

      <!-- ===== My hours ===== -->
      <div data-pane="mine">
        <div class="hr-hero" id="hr-status"><p class="hr-hero-loading">Loading…</p></div>

        <div class="hr-sheet" id="hr-sheet" hidden>
          <section class="hr-sheet-main" id="hr-dopl" aria-labelledby="hr-req-title"></section>

          <section class="hr-sheet-side" aria-labelledby="hr-mine-title">
            <div class="hr-side-head">
              <h2 id="hr-mine-title">Your hours <span class="hr-count" id="hr-entry-count"></span></h2>
              <button class="hr-link" type="button" id="hr-csv-mine">Download CSV</button>
            </div>
            <div class="hr-adder" id="hr-add-card">
              <button class="hr-adder-btn" type="button" id="hr-open" aria-expanded="false" aria-controls="hr-form">
                <span class="hr-plus" aria-hidden="true">+</span>
                <span><strong id="hr-form-title">Add past hours</strong><small id="hr-form-help">From before Submit Hours, or outside a pay period</small></span>
              </button>
              <form id="hr-form" novalidate hidden>
                <p class="hr-form-head"><strong id="hr-form-title2">Add past hours</strong> <span class="hr-muted small">Totals for the whole date range. Pay periods go through <a href="/employeeportal/submit-hours">Submit Hours</a>.</span></p>
                <div class="hr-nums">
                  <label class="hr-field"><span>From</span><input type="date" name="date" required /></label>
                  <label class="hr-field"><span>To</span><input type="date" name="end" required /></label>
                </div>
                <div class="hr-nums">
                  <label class="hr-field"><span>Direct client care</span><input type="number" name="direct" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                  <label class="hr-field" id="hr-f-relational" hidden><span>…of which relational</span><input type="number" name="relational" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                  <label class="hr-field"><span>Individual supervision</span><input type="number" name="individual" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                  <label class="hr-field"><span>Group supervision</span><input type="number" name="group" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                  <label class="hr-field"><span>…of which direct observation</span><input type="number" name="observation" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                  <label class="hr-field"><span>Other work time</span><input type="number" name="other" min="0" step="0.25" inputmode="decimal" placeholder="0" /></label>
                </div>
                <p class="hr-muted small" id="hr-week-total" aria-live="polite"></p>
                <p class="hr-err" id="hr-form-err" hidden></p>
                <div class="hr-actions">
                  <button class="hr-btn primary" type="submit" id="hr-save">Add past hours</button>
                  <button class="hr-btn" type="button" id="hr-cancel">Cancel</button>
                </div>
              </form>
            </div>
            <div id="hr-entries"></div>
          </section>
        </div>
      </div>

      <!-- ===== Supervisor view ===== -->
      <div data-pane="team" hidden>
        <div class="hr-card">
          <div class="hr-row-head">
            <h2>My supervisees</h2>
            <form id="hr-add" class="hr-add">
              <select name="email" aria-label="Choose a supervisee" required><option value="">Add an associate…</option></select>
              <button class="hr-btn primary small" type="submit">Add</button>
            </form>
          </div>
          <div id="hr-team"><p class="hr-muted">Loading…</p></div>
        </div>

        <div class="hr-card" id="hr-detail" hidden>
          <div class="hr-row-head">
            <div><p class="hr-eyebrow dark" id="hr-d-license"></p><h2 id="hr-d-name"></h2></div>
            <div class="hr-actions">
              <button class="hr-btn small" type="button" id="hr-d-csv">Download CSV</button>
              <button class="hr-btn small" type="button" id="hr-d-close">Close</button>
            </div>
          </div>
          <div id="hr-d-progress"></div>
          <div class="hr-row-head"><h3>Waiting for your approval</h3><button class="hr-btn primary small" type="button" id="hr-d-approve-all" hidden>Approve all</button></div>
          <div id="hr-d-pending"></div>
          <h3>All entries</h3>
          <div id="hr-d-entries"></div>
          <details class="hr-settings">
            <summary>License and targets</summary>
            <form id="hr-d-settings">
              <div class="hr-nums">
                <label class="hr-field"><span>License</span><select name="license">{LICENSES.map((l) => <option value={l.id}>{l.label} → {l.goal}</option>)}</select></label>
                <label class="hr-field"><span>Supervision started</span><input type="date" name="startDate" /></label>
                <label class="hr-field"><span>Total hours target</span><input type="number" name="total" min="0" step="1" /></label>
                <label class="hr-field"><span>Direct client care target</span><input type="number" name="direct" min="0" step="1" /></label>
                <label class="hr-field"><span>Supervision target</span><input type="number" name="supervision" min="0" step="1" /></label>
                <label class="hr-field"><span>Direct observation target</span><input type="number" name="observation" min="0" step="1" /></label>
                <label class="hr-field"><span>Group supervision that can count (max)</span><input type="number" name="groupMax" min="0" step="1" /></label>
                <label class="hr-field"><span>Relational hours target <small>(MFT; 0 = not tracked)</small></span><input type="number" name="relational" min="0" step="1" /></label>
              </div>
              <p class="hr-muted small">Defaults follow Utah DOPL (Utah Code 58-60; MFT relational hours: Admin. Code R156-60b-302b). Check with DOPL if anything changes.</p>
              <div class="hr-actions">
                <button class="hr-btn primary small" type="submit">Save</button>
                <button class="hr-btn small danger" type="button" id="hr-d-unlink">Stop supervising</button>
              </div>
            </form>
          </details>
        </div>
      </div>
    </div></div>
  </section>

  <script is:inline define:vars={{ LICENSES, CREDS, DOPL_NOTES, DOPL_BY_LICENSE }}>
    (function () {
      var API = '/api/hours', $ = function (id) { return document.getElementById(id); };
      var mine = null, team = null, detail = null, editing = null;
      var LIC = {}; LICENSES.forEach(function (l) { LIC[l.id] = l; });

      function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
      function h(n) { n = Math.round(n * 100) / 100; return n.toLocaleString('en-US') + (n === 1 ? ' hr' : ' hrs'); }
      function fmtDate(iso) { return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
      function addDays(iso, n) { var x = new Date(iso + 'T12:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); }
      function fmtRange(a, b) { return a === b ? fmtDate(a) : new Date(a + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' – ' + fmtDate(b); }
      function entryTitle(e) {
        if (e.kind === 'period') return 'Pay period ' + fmtRange(e.date, e.end || e.date);
        if (e.kind === 'bulk') return 'Past hours ' + fmtRange(e.date, e.end || e.date);
        return (e.kind === 'week' ? 'Week of ' : '') + fmtDate(e.date);
      }
      var KIND = { week: 'Week', session: 'Session', bulk: 'Past hours (bulk)', period: 'Pay period' };
      function notify(t, bad) { var a = $('hr-alert'); a.textContent = t; a.className = 'hr-alert' + (bad ? ' bad' : ''); a.hidden = false; clearTimeout(notify.t); notify.t = setTimeout(function () { a.hidden = true; }, t.length > 90 ? 12000 : 6000); }
      function call(method, qs, body) {
        return fetch(API + (qs || ''), { method: method, credentials: 'same-origin', headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined })
          .then(function (r) { return r.json().then(function (b) { if (!r.ok) throw new Error(b.error || 'Something went wrong.'); return b; }); });
      }
      var STATUS = { pending: 'Waiting for approval', approved: 'Approved', returned: 'Sent back' };

      // ---------- progress ----------
      // A supervisee's targets: their license's defaults, then anything their supervisor changed. Older links have no
      // relational target, so the license default (500 for AMFT, 0 = not tracked otherwise) fills it in.
      function targetsFor(link) {
        var base = (link && LIC[link.license] || LICENSES[0]).targets;
        var t = Object.assign({}, base, link ? link.targets : {});
        if (t.relational == null) t.relational = base.relational;
        return t;
      }
      function progress(link, approved, pending) {
        var wrap = el('div', 'hr-progress');
        var t = targetsFor(link);
        var groupCounted = Math.min(approved.group, t.groupMax);
        var rows = [
          ['Total hours', approved.total || 0, pending.total || 0, t.total],
          ['Direct client care', approved.direct, pending.direct, t.direct],
        ].concat(t.relational ? [['Relational (of direct client care)', approved.relational || 0, pending.relational || 0, t.relational]] : []).concat([
          ['Supervision', approved.individual + groupCounted, pending.individual + pending.group, t.supervision, approved.group > t.groupMax ? 'Only ' + t.groupMax + ' group supervision hours can count (' + h(approved.group) + ' logged).' : ''],
          ['Direct observation', approved.observation, pending.observation, t.observation],
        ]);
        rows.forEach(function (r) {
          var pct = r[3] ? Math.min(100, (r[1] / r[3]) * 100) : 0, ppct = r[3] ? Math.min(100 - pct, (r[2] / r[3]) * 100) : 0;
          var row = el('div', 'hr-bar');
          var top = el('div', 'hr-bar-top');
          top.appendChild(el('span', 'lab', r[0]));
          top.appendChild(el('span', 'val', h(r[1]) + ' of ' + r[3].toLocaleString('en-US') + (r[2] ? '  ·  ' + h(r[2]) + ' waiting' : '')));
          row.appendChild(top);
          var track = el('div', 'hr-track'); track.setAttribute('role', 'progressbar'); track.setAttribute('aria-label', r[0]); track.setAttribute('aria-valuenow', String(Math.round(pct))); track.setAttribute('aria-valuemin', '0'); track.setAttribute('aria-valuemax', '100');
          var f = el('span', 'fill'); f.style.width = pct + '%'; track.appendChild(f);
          var p = el('span', 'pend'); p.style.width = ppct + '%'; track.appendChild(p);
          row.appendChild(track);
          if (r[4]) row.appendChild(el('p', 'hr-note', r[4]));
          wrap.appendChild(row);
        });
        return wrap;
      }

      // ---------- entries table ----------
      function entryList(entries, opts) {
        var box = el('div', 'hr-list');
        var list = entries.slice().sort(function (a, b) { return a.date < b.date ? 1 : a.date > b.date ? -1 : 0; });
        if (!list.length) { box.appendChild(el('p', 'hr-muted', opts.empty || 'No entries yet.')); return box; }
        var limit = opts.limit && list.length > opts.limit + 2 ? opts.limit : 0;
        list.forEach(function (e, i) {
          if (opts.compact) { box.appendChild(compactEntry(e, opts, limit && i >= limit)); return; }
          var row = el('div', 'hr-entry ' + e.status);
          var head = el('div', 'hr-entry-head');
          head.appendChild(el('strong', null, entryTitle(e)));
          head.appendChild(el('span', 'hr-chip ' + e.status, STATUS[e.status]));
          row.appendChild(head);
          var parts = [];
          if (e.direct) parts.push('Direct ' + h(e.direct));
          if (e.relational) parts.push('Relational ' + h(e.relational));
          if (e.individual) parts.push('Individual sup. ' + h(e.individual));
          if (e.group) parts.push('Group sup. ' + h(e.group));
          if (e.observation) parts.push('Observation ' + h(e.observation));
          if (e.other) parts.push('Other ' + h(e.other));
          var tot = e.direct + e.individual + e.group + (e.other || 0);
          head.insertBefore(el('span', 'hr-entry-total', h(tot)), head.lastChild);
          row.appendChild(el('p', 'hr-entry-hours', parts.join(' · ')));
          if (e.kind === 'period' && opts.mine) row.appendChild(el('p', 'hr-muted small', 'From Submit Hours. To change it, submit your hours again for that pay period.'));
          if (e.supervisorNote && e.status === 'returned') row.appendChild(el('p', 'hr-entry-sup', 'Supervisor: ' + e.supervisorNote));
          var btns = el('div', 'hr-actions');
          (opts.buttons(e) || []).forEach(function (b) { var x = el('button', 'hr-btn small' + (b.cls ? ' ' + b.cls : ''), b.label); x.type = 'button'; x.onclick = b.go; btns.appendChild(x); });
          if (btns.children.length) row.appendChild(btns);
          box.appendChild(row);
        });
        if (limit) {
          var more = el('button', 'hr-link hr-more', 'Show all ' + list.length + ' entries'); more.type = 'button';
          more.onclick = function () { box.querySelectorAll('.hr-row[hidden]').forEach(function (r) { r.hidden = false; }); more.remove(); };
          box.appendChild(more);
        }
        return box;
      }
      // One line per entry (title, total, status); click to see the breakdown and Edit/Delete.
      function compactEntry(e, opts, hide) {
        var row = el('details', 'hr-row ' + e.status); if (hide) row.hidden = true;
        if (e.status === 'returned') row.open = true;
        var sum = el('summary');
        sum.appendChild(el('span', 'hr-row-title', entryTitle(e)));
        sum.appendChild(el('span', 'hr-row-total', h(e.direct + e.individual + e.group + (e.other || 0))));
        sum.appendChild(el('span', 'hr-chip ' + e.status, STATUS[e.status]));
        row.appendChild(sum);
        var body = el('div', 'hr-row-body');
        var parts = [];
        if (e.direct) parts.push('Direct ' + h(e.direct));
        if (e.relational) parts.push('Relational ' + h(e.relational));
        if (e.individual) parts.push('Individual sup. ' + h(e.individual));
        if (e.group) parts.push('Group sup. ' + h(e.group));
        if (e.observation) parts.push('Observation ' + h(e.observation));
        if (e.other) parts.push('Other ' + h(e.other));
        body.appendChild(el('p', 'hr-entry-hours', parts.join(' · ') || 'No hours'));
        if (e.supervisorNote && e.status === 'returned') body.appendChild(el('p', 'hr-entry-sup', 'Supervisor: ' + e.supervisorNote));
        if (e.kind === 'period') body.appendChild(el('p', 'hr-muted small', 'From Submit Hours. To change it, submit your hours again for that pay period.'));
        var btns = el('div', 'hr-actions');
        (opts.buttons(e) || []).forEach(function (b) { var x = el('button', 'hr-btn small' + (b.cls ? ' ' + b.cls : ''), b.label); x.type = 'button'; x.onclick = b.go; btns.appendChild(x); });
        if (btns.children.length) body.appendChild(btns);
        row.appendChild(body);
        return row;
      }

      // ---------- CSV ----------
      function csv(log, who) {
        var rows = [['Supervisee', 'Type', 'From', 'To', 'Direct client care', 'Relational (of direct)', 'Individual supervision', 'Group supervision', 'Direct observation', 'Other work time', 'Total', 'Status', 'Reviewed by', 'Reviewed at']];
        log.entries.slice().sort(function (a, b) { return a.date < b.date ? -1 : 1; }).forEach(function (e) {
          rows.push([who, KIND[e.kind] || e.kind, e.date, e.end || (e.kind === 'week' ? addDays(e.date, 6) : e.date), e.direct, e.relational || 0, e.individual, e.group, e.observation, e.other || 0, e.direct + e.individual + e.group + (e.other || 0), STATUS[e.status], e.reviewedBy || '', e.reviewedAt ? e.reviewedAt.slice(0, 10) : '']);
        });
        var text = rows.map(function (r) { return r.map(function (c) { c = String(c); if (/^[=+\-@]/.test(c)) c = "'" + c; return /[",\n]/.test(c) ? '"' + c.replace(/"/g, '""') + '"' : c; }).join(','); }).join('\n');
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([text], { type: 'text/csv' }));
        a.download = 'supervision-hours-' + who.replace(/[^a-z0-9]+/gi, '-').toLowerCase() + '.csv';
        document.body.appendChild(a); a.click(); a.remove();
      }

      // ---------- My hours ----------
      function renderMine() {
        renderPath();
        $('hr-entry-count').textContent = mine.log.entries.length ? '(' + mine.log.entries.length + ')' : '';
        var box = $('hr-entries'); box.innerHTML = '';
        box.appendChild(entryList(mine.log.entries, {
          mine: true, compact: true, limit: 8,
          empty: 'Nothing yet. Submit your hours each pay period on Submit Hours, and add any past hours above.',
          buttons: function (e) {
            if (e.status === 'approved' || e.kind === 'period') return [];
            return [
              { label: 'Edit', go: function () { startEdit(e); } },
              { label: 'Delete', cls: 'danger', go: function () { if (confirm('Delete this entry?')) save({ action: 'delete', id: e.id }, 'Entry deleted.'); } },
            ];
          },
        }));
      }
      var fmt = function (n) { return (Math.round(n * 4) / 4).toLocaleString('en-US'); };
      // Hero: the path from their associate license to the full one, on the dark header (no box).
      function renderPath() {
        var s = $('hr-status'); s.innerHTML = ''; $('hr-sheet').hidden = false;
        var l = mine.link ? LIC[mine.link.license] || LICENSES[0] : null, t = targetsFor(mine.link);
        var done = mine.approved.total || 0, wait = mine.pending.total || 0, goal = t.total || 3000;
        var p = Math.min(100, done / goal * 100), w = Math.min(100 - p, wait / goal * 100);
        var top = el('div', 'hr-hero-top');
        var big = el('p', 'hr-hero-big');
        big.appendChild(el('strong', null, fmt(done)));
        big.appendChild(el('span', null, 'of ' + goal.toLocaleString('en-US') + ' hours toward ' + (l ? l.goal : 'licensure')));
        top.appendChild(big);
        var meta = el('div', 'hr-hero-meta');
        if (wait) meta.appendChild(el('span', 'hr-pill wait', fmt(wait) + ' waiting for approval'));
        meta.appendChild(el('span', 'hr-pill', done >= goal ? 'Total hours complete' : fmt(goal - done) + ' to go'));
        top.appendChild(meta);
        s.appendChild(top);
        var trail = el('div', 'hr-trail'); trail.setAttribute('role', 'progressbar'); trail.setAttribute('aria-label', 'Approved hours toward ' + (l ? l.goal : 'licensure'));
        trail.setAttribute('aria-valuenow', String(Math.round(done))); trail.setAttribute('aria-valuemin', '0'); trail.setAttribute('aria-valuemax', String(goal));
        trail.appendChild(el('span', 'hr-trail-from', l ? l.label : 'Associate'));
        var track = el('div', 'hr-trail-track');
        var fill = el('span', 'hr-trail-fill'); fill.style.width = p + '%'; track.appendChild(fill);
        var pend = el('span', 'hr-trail-wait'); pend.style.left = p + '%'; pend.style.width = w + '%'; track.appendChild(pend);
        for (var k = 500; k < goal; k += 500) { var tick = el('span', 'hr-trail-tick'); tick.style.left = (k / goal * 100) + '%'; track.appendChild(tick); }
        var you = el('span', 'hr-trail-you'); you.style.left = p + '%'; track.appendChild(you);
        trail.appendChild(track);
        trail.appendChild(el('span', 'hr-trail-to', l ? l.goal : 'Licensed'));
        s.appendChild(trail);
        s.appendChild(el('p', 'hr-hero-sup', mine.link ? 'Supervised by ' + mine.supervisorName : 'No supervisor linked yet. Ask your supervisor to add you; your hours then go to them for approval.'));
        renderReqs(l, t);
      }
      // DOPL's requirements: hour tiles with progress rings (post-May-2024 rules), then the to-dos not tracked here.
      function renderReqs(l, t) {
        var c = $('hr-dopl'); c.innerHTML = '';
        var d = mine.link ? DOPL_BY_LICENSE[mine.link.license] : null, a = mine.approved, pe = mine.pending;
        var head = el('div', 'hr-side-head');
        var h2 = el('h2', null, l ? 'What DOPL requires for ' + l.goal : 'What DOPL requires'); h2.id = 'hr-req-title';
        head.appendChild(h2);
        var link = el('a', 'hr-link', d ? 'DOPL’s ' + l.goal + ' page' : 'Utah DOPL'); link.href = d ? d.url : 'https://commerce.utah.gov/dopl/'; link.target = '_blank'; link.rel = 'noopener';
        head.appendChild(link);
        c.appendChild(head);
        var grid = el('ul', 'hr-tiles');
        function tile(o) {
          var pct = o.of ? Math.min(100, o.have / o.of * 100) : 0, met = !o.limit && o.of && o.have >= o.of;
          var li = el('li', 'hr-tile' + (met ? ' met' : '') + (o.limit ? ' limit' : ''));
          var ring = el('span', 'hr-ring'); ring.style.setProperty('--p', pct + '%'); ring.setAttribute('aria-hidden', 'true');
          li.appendChild(ring);
          var num = el('p', 'hr-tile-num');
          num.appendChild(el('strong', null, fmt(o.have)));
          num.appendChild(el('span', null, (o.limit ? ' of up to ' : ' / ') + o.of.toLocaleString('en-US')));
          li.appendChild(num);
          li.appendChild(el('p', 'hr-tile-label', o.label));
          if (o.note) li.appendChild(el('p', 'hr-tile-note', o.note));
          if (met) li.appendChild(el('p', 'hr-tile-flag done', 'Done'));
          else if (o.wait) li.appendChild(el('p', 'hr-tile-flag', fmt(o.wait) + ' waiting'));
          grid.appendChild(li);
        }
        var groupCounted = Math.min(a.group, t.groupMax);
        tile({ label: 'Total supervised hours', have: a.total || 0, of: t.total, wait: pe.total });
        tile({ label: 'Direct client care', have: a.direct, of: t.direct, wait: pe.direct });
        if (t.relational) tile({ label: 'Relational hours', note: DOPL_NOTES.relational + '. Part of direct client care.', have: a.relational || 0, of: t.relational, wait: pe.relational });
