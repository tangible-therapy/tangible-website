---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Booking from '../../../components/Booking.astro';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((t) => ({ params: { slug: t.id }, props: { t } }));
}
const { t } = Astro.props;
const { Content } = await render(t);
const d = t.data;
const title = `${d.seoTitle || d.name} | Tangible Therapy`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  image: new URL(d.photo, 'https://tangiblementalhealth.com').href,
  jobTitle: 'Therapist',
  worksFor: { '@type': 'MedicalBusiness', name: 'Tangible Therapy' },
};
---
<Base title={title} description={d.seoDescription} image={d.photo} schema={schema}>
  <section class="sec t-black">
    <div class="therapist">
      <div class="photo"><img src={d.photo} alt={d.name} width="900" height="1020" /></div>
      <div class="info">
        <p class="crumbs"><a href="/ourteam">Find Your Therapist</a> › {d.name}</p>
        <h1>{d.name}</h1>
        <div class="bio rte"><Content /></div>
      </div>
    </div>
    {d.booking && <Booking phone={d.phone} />}
      </section>
</Base>
