---
import Base from '../../layouts/Base.astro';
import TherapistFinder from '../../components/TherapistFinder.astro';
import { finderPresetFor } from '../../lib/therapist-sheet';
import { teamPageSeo } from '../../lib/team-page-seo';
import categories from '../../data/team-categories.json';
import Before from '../../components/sections/ourteam-before.astro';
import After from '../../components/sections/ourteam-after.astro';

export function getStaticPaths() {
  type Cat = { slug: string; name: string; children: Cat[] };
  const out: { params: { category: string }; props: { label: string; parent?: string } }[] = [];
  const walk = (cs: Cat[], parent?: Cat) =>
    cs.forEach((c) => {
      out.push({ params: { category: c.slug }, props: { label: c.name, parent: parent?.name } });
      walk(c.children, c);
    });
  walk(categories as Cat[]);
  return out;
}
const { category } = Astro.params;
// Same URLs as the old Squarespace filter pages; each opens the finder with that office/specialty
// switched on, with its own title, heading, description and intro (src/lib/team-page-seo.ts).
const seo = teamPageSeo(category!);
---
<Base title={seo.title} description={seo.description}>
  <Before />
  <TherapistFinder heading={seo.heading} intro={seo.intro} preset={finderPresetFor(category!)} />
  <After />
</Base>
