---
// Staff-only page (protected by netlify/edge-functions/staff-gate.ts).
// Layout: the Employee Portal sidebar is added by Base.astro (PortalShell); content sits in .pt-page.
// With Google sign-in on, the dashboard shows: quick numbers (rooms open now, next training, your part in it),
// the training meetings and "Suggest a training topic" from the office's Team Dashboard sheet
// (/api/dashboard — see docs/office-dashboards), room claims (/api/rooms) for the rooms count, and for
// associates their supervised hours (/api/hours, the same data as the Hours Tracker page).
// New hires (approved, orientation not complete) get a "Get set up" checklist at the top (/api/onboarding):
// join Slack, complete Orientation (ticks itself when every lesson was opened and the skills review passed in
// this browser), complete Onboarding. Finished checklists appear for directors in "New hires ready for approval".
// Find a Room is its own page: src/pages/employeeportal/rooms.astro.
import Base from '../layouts/Base.astro';
import { OFFICES } from '../data/staff-access';
import { LICENSES } from '../data/hours';
import orientation from '../data/orientation.json';
const lessonSlugs = (orientation as { slug: string }[]).map((l) => l.slug);
const offices = OFFICES.map((o) => ({ id: o.id, label: o.label.replace(/ \(.*\)/, '') }));
const defaultTargets = JSON.stringify(LICENSES[0].targets);
---
<Base title="Employee Portal | Tangible Therapy" description="Tangible Therapy employee portal." noindex>
  <div class="pt-page">
    <div class="pt-head">
      <div>
        <p class="pt-eyebrow" id="pd-date">Employee Portal</p>
        <h1 id="pd-hello">Welcome to your Employee Portal</h1>
      </div>
      <label class="pt-field" id="pd-switch" hidden>View office
        <select id="pd-office-pick">{offices.map((o) => <option value={o.id}>{o.label}</option>)}</select>
      </label>
    </div>

    <p class="pt-muted" id="pd-intro">Everything you need is in the menu.</p>

    <article class="pt-card ob-card" id="ob-card" hidden data-slugs={JSON.stringify(lessonSlugs)}>
      <div class="ob-card-head">
        <div>
          <p class="pt-eyebrow">New here?</p>
          <h2 id="ob-heading">Let’s get you set up</h2>
          <p class="ob-preview" id="ob-preview" hidden>Preview: you see this because you’re the owner. Ticks are real; approving your finished checklist just resets it.</p>
          <p class="pt-muted" id="ob-sub">Work through these steps. When they’re all ticked, your practice director sees it on their dashboard and will finish your onboarding with you.</p>
        </div>
        <p class="ob-count"><strong id="ob-n">0</strong> of <span id="ob-total">3</span> done</p>
      </div>
      <div class="ob-bar"><i id="ob-bar"></i></div>
      <ol class="ob-steps">
        <li class="ob-step" data-step="slack">
          <span class="ob-dot" aria-hidden="true"></span>
          <div class="ob-body">
            <h3>Join Slack</h3>
            <p>Slack is where the team talks day to day. Go to <a href="https://tangibletherapy.slack.com" target="_blank" rel="noopener">tangibletherapy.slack.com</a> and sign up with your Tangible email<span data-me-email></span>. It’s worth installing the Slack app on your phone and computer too.</p>
            <div class="ob-acts">
              <a class="pt-btn" href="https://tangibletherapy.slack.com" target="_blank" rel="noopener">Open Slack</a>
              <button type="button" class="pt-btn ghost" data-tick="slack">I’ve joined Slack</button>
            </div>
          </div>
        </li>
        <li class="ob-step" data-step="orientation">
          <span class="ob-dot" aria-hidden="true"></span>
          <div class="ob-body">
            <h3>Complete Orientation</h3>
            <p>Orientation covers how we work at Tangible, our policies and SimplePractice. It takes about an hour. Go through every lesson; the last one is a short SimplePractice skills review. This step ticks itself when you’ve finished, and your progress is saved to your account, so you can switch devices.</p>
            <p class="ob-prog" id="ob-orient-prog"></p>
            <div class="ob-acts">
              <a class="pt-btn" href="/orientation">Go to Orientation</a>
              <button type="button" class="ob-link" data-tick="orientation" id="ob-orient-other">I finished it on another device</button>
            </div>
          </div>
        </li>
        <li class="ob-step" data-step="paperwork">
          <span class="ob-dot" aria-hidden="true"></span>
          <div class="ob-body">
            <h3>Complete Onboarding</h3>
            <p>On the Onboarding page, download and fill in the W-4 and direct deposit form, then open the onboarding form and upload them with your license. Use your Tangible Google account so the uploads work.</p>
            <div class="ob-acts">
              <a class="pt-btn" href="/onboarding">Go to Onboarding</a>
              <button type="button" class="pt-btn ghost" data-tick="paperwork">I’ve submitted the form</button>
            </div>
          </div>
        </li>
        <li class="ob-step" data-step="headshots" hidden>
          <span class="ob-dot" aria-hidden="true"></span>
          <div class="ob-body">
            <h3>Schedule your headshots</h3>
            <p><b data-fill-ob="headshots">Julie Clegg</b> takes our headshots for the website. Send her a message on Slack to find a time. Wear semi-professional clothes in neutral colors (not gray or black).</p>
            <p class="ob-how">In Slack: click the search bar at the top, type <b data-fill-ob="headshots">Julie Clegg</b>, click her name, then click <b>Message</b>.</p>
            <div class="ob-draft"><span class="ob-draft-label">You could send:</span><span class="ob-draft-text" data-draft="headshots"></span><button type="button" class="ob-link" data-copy-draft="headshots">Copy</button></div>
            <div class="ob-acts">
              <a class="pt-btn" href="https://tangibletherapy.slack.com" target="_blank" rel="noopener">Open Slack</a>
              <button type="button" class="pt-btn ghost" data-tick="headshots">I’ve messaged Julie</button>
            </div>
          </div>
        </li>
        <li class="ob-step" data-step="supervision" hidden>
          <span class="ob-dot" aria-hidden="true"></span>
          <div class="ob-body">
            <h3>Schedule supervision</h3>
            <p class="ob-sup" id="ob-sup"></p>
            <p class="ob-how" id="ob-sup-how"></p>
            <div class="ob-draft" id="ob-sup-draft"><span class="ob-draft-label">You could send:</span><span class="ob-draft-text" data-draft="supervision"></span><button type="button" class="ob-link" data-copy-draft="supervision">Copy</button></div>
            <div class="ob-acts">
              <a class="pt-btn" href="https://tangibletherapy.slack.com" target="_blank" rel="noopener">Open Slack</a>
              <button type="button" class="pt-btn ghost" data-tick="supervision" id="ob-sup-tick">I’ve messaged my supervisor</button>
            </div>
          </div>
        </li>
      </ol>
      <p class="ob-msg" id="ob-msg" role="status"></p>
    </article>

    <article class="pt-card ob-review" id="ob-review" hidden>
      <div class="ob-card-head">
        <h2>New hires ready for approval</h2>
        <a class="pd-link" href="/staff-admin#onboarding">Staff Admin ›</a>
      </div>
      <p class="pt-muted">They’ve joined Slack and finished Orientation and Onboarding. Approve them once you’ve met to finish onboarding; their checklist then goes away.</p>
      <ul class="ob-rev-list" id="ob-rev-list"></ul>
      <p class="ob-msg" id="ob-rev-msg" role="status"></p>
    </article>
    <p class="pt-soon" id="pd-soon" hidden>This office's dashboard isn't connected yet. It's coming soon.</p>
    <p class="pt-soon" id="pd-error" hidden></p>

    <div class="pd" id="pd" hidden>
      <div class="pd-tiles" id="pd-tiles" hidden>
        <a class="pd-tile" href="/employeeportal/rooms">
          <span class="pd-tile-label">Rooms open now</span>
          <span class="pd-tile-value" id="pd-t-rooms">–</span>
          <span class="pd-tile-sub" id="pd-t-rooms-sub">Find a room ›</span>
        </a>
        <div class="pd-tile">
          <span class="pd-tile-label">Next training</span>
          <span class="pd-tile-value" id="pd-t-train">–</span>
          <span class="pd-tile-sub" id="pd-t-train-sub"></span>
        </div>
        <div class="pd-tile you" id="pd-t-you" hidden>
          <span class="pd-tile-label">Your part</span>
          <span class="pd-tile-value" id="pd-t-you-val"></span>
          <span class="pd-tile-sub" id="pd-t-you-sub"></span>
        </div>
      </div>

      <div class="pd-cols">
        <div class="pd-col-main">
          <article class="pt-card" id="pd-training" hidden>
            <h2>Training meetings</h2>
            <div id="pd-next"></div>
            <h3 class="pd-sub">Coming up</h3>
            <ul class="pd-upcoming" id="pd-upcoming"></ul>
          </article>
        </div>

        <div class="pd-col-side">
          <article class="pt-card pd-hours" id="pd-hours" hidden data-defaults={defaultTargets}>
            <div class="pd-hours-head">
              <h2>My supervised hours</h2>
              <a href="/hours" class="pd-link">Hours Tracker ›</a>
            </div>
            <p class="pd-hours-total"><strong id="pd-h-total">0</strong> <span id="pd-h-of">of 3,000 hours</span></p>
            <div class="pd-bars" id="pd-h-bars"></div>
            <p class="pt-muted pd-hours-note" id="pd-h-note"></p>
          </article>

          <article class="pt-card pd-suggest" id="pd-suggest-card" hidden>
            <h2>Suggest a training topic</h2>
            <p class="pt-muted">Have an idea for a future training meeting? It goes straight to your director's list.</p>
            <form id="pd-suggest">
              <label class="sr-only" for="pd-topic">Training topic</label>
              <textarea id="pd-topic" rows="2" maxlength="500" placeholder="e.g. Working with teens and their parents" required></textarea>
              <button type="submit" class="pt-btn">Send suggestion</button>
              <p class="pd-msg" id="pd-suggest-msg" role="status"></p>
            </form>
          </article>
        </div>
      </div>
      <p class="pt-note" id="pd-updated"></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var me = null, data = null, claims = [], currentOffice = null;

      function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
      function nowParts() {
        var f = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false, year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
        var g = {}; f.forEach(function (p) { g[p.type] = p.value; });
        return { wd: g.weekday, mins: (+g.hour % 24) * 60 + +g.minute, date: g.year + '-' + g.month + '-' + g.day };
      }
      var DAY = { Mon: 'M', Tue: 'T', Wed: 'W', Thu: 'Th', Fri: 'F', Sat: 'S' };
      function mins(hhmm) { var p = hhmm.split(':'); return +p[0] * 60 + +p[1]; }
      function niceDate(iso) { return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }); }
      function shortDate(iso) { return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }
      function tileDate(iso) { return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }); }
      function fmt(n) { return (Math.round(n * 100) / 100).toLocaleString('en-US'); }
      function isMe(names) {
        if (!me || !names) return false;
        var first = (me.firstName || '').toLowerCase();
        return !!first && names.toLowerCase().split(/[^a-z]+/).indexOf(first) >= 0;
      }

      // ----- training -----
      function renderTraining() {
        var today = nowParts().date;
        var next = (data.training || []).filter(function (t) { return t.date >= today && (t.topic || t.skill || t.dsm || t.trainer); });
        var box = $('pd-next'); box.innerHTML = '';
        $('pd-t-you').hidden = true;
        if (!next.length) {
          box.appendChild(el('p', 'pt-muted', 'No upcoming meetings are on the schedule yet.'));
          $('pd-upcoming').innerHTML = '';
          $('pd-t-train').textContent = 'Not scheduled'; $('pd-t-train-sub').textContent = '';
          return;
        }
        var n = next[0], mine = [];
        $('pd-t-train').textContent = tileDate(n.date);
        $('pd-t-train-sub').textContent = n.topic || 'Topic to be announced';

        var row = el('div', 'pd-next-row');
        var cal = el('div', 'pd-cal');
        var d = new Date(n.date + 'T12:00:00');
        cal.appendChild(el('span', 'm', d.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()));
        cal.appendChild(el('span', 'd', String(d.getDate())));
        row.appendChild(cal);
        var info = el('div', 'pd-next-info');
        info.appendChild(el('p', 'pd-date', niceDate(n.date)));
        info.appendChild(el('p', 'pd-topic', n.topic || 'Topic to be announced'));
        var chips = el('div', 'pd-chips');
        [['Trainer', n.trainer], ['Skill', n.skill], ['DSM', n.dsm]].forEach(function (f) {
          if (!f[1]) return;
          var you = isMe(f[1]); if (you) mine.push(f[0] === 'Trainer' ? 'trainer' : f[0] === 'DSM' ? 'DSM' : 'skill assignment');
          chips.appendChild(el('span', 'pd-chip' + (you ? ' you' : ''), f[0] + ': ' + f[1]));
        });
        info.appendChild(chips);
        if (n.extra) { var ex = el('p', 'pd-extra'); ex.appendChild(el('strong', null, 'Also: ')); ex.appendChild(document.createTextNode(n.extra)); info.appendChild(ex); }
        row.appendChild(info);
        box.appendChild(row);

        if (mine.length) {
          $('pd-t-you').hidden = false;
          $('pd-t-you-val').textContent = 'You’re on ' + mine.join(' & ');
          $('pd-t-you-sub').textContent = 'for the ' + shortDate(n.date) + ' meeting';
        }

        var ul = $('pd-upcoming'); ul.innerHTML = '';
        next.slice(1, 5).forEach(function (t) {
          var you = isMe([t.trainer, t.skill, t.dsm].join(' '));
          var li = el('li', you ? 'you' : '');
          li.appendChild(el('span', 'when', shortDate(t.date)));
          var body = el('span', 'body');
          body.appendChild(el('span', 'what', t.topic || 'Topic to be announced'));
          var who = [t.trainer && 'Trainer: ' + t.trainer, t.skill && 'Skill: ' + t.skill, t.dsm && 'DSM: ' + t.dsm].filter(Boolean).join(' · ');
          if (who) body.appendChild(el('span', 'who', who));
          li.appendChild(body);
          ul.appendChild(li);
        });
        if (!ul.children.length) ul.appendChild(el('li', 'pt-muted', 'Nothing else scheduled yet.'));
      }

      // ----- rooms open now (details on /employeeportal/rooms) -----
      function renderRoomsTile() {
        var now = nowParts(), day = DAY[now.wd], t = now.mins;
        var total = 0, free = 0;
        (data.schedules || []).forEach(function (s) {
          s.rooms.forEach(function (room) {
            total++;
            var busy = (room.days[day] || []).some(function (b) { return mins(b.start) <= t && t < mins(b.end); });
            var claimed = claims.some(function (c) { return c.building === s.name && c.room === room.label && c.start <= t && t < c.end; });
            if (!busy && !claimed) free++;
          });
        });
        if (!day || t < 420 || t >= 1320 || !total) { $('pd-t-rooms').textContent = 'Office closed'; $('pd-t-rooms-sub').textContent = 'Plan ahead in Find a Room ›'; return; }
        $('pd-t-rooms').textContent = free + ' of ' + total;
        $('pd-t-rooms-sub').textContent = free ? 'Find a room ›' : 'All rooms are in use · see when one opens ›';
      }

      // ----- associate hours (same data as /hours) -----
      function loadHours() {
        if (!me || (me.roles || []).indexOf('associate') < 0) return;
        fetch('/api/hours?view=mine', { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (b) {
            if (!b || !b.approved) return;
            var t = (b.link && b.link.targets) || JSON.parse($('pd-hours').getAttribute('data-defaults'));
            var a = b.approved, p = b.pending || {};
            $('pd-h-total').textContent = fmt(a.total);
            $('pd-h-of').textContent = 'of ' + fmt(t.total) + ' hours approved';
            var bars = $('pd-h-bars'); bars.innerHTML = '';
            [['Total', a.total, t.total], ['Direct client care', a.direct, t.direct], ['Supervision', a.supervision, t.supervision]].forEach(function (x) {
              var pct = x[2] ? Math.min(100, x[1] / x[2] * 100) : 0;
              var row = el('div', 'pd-bar');
              var lab = el('div', 'pd-bar-label');
              lab.appendChild(el('span', null, x[0]));
              lab.appendChild(el('span', 'num', fmt(x[1]) + ' / ' + fmt(x[2])));
              row.appendChild(lab);
              var track = el('div', 'pd-bar-track'); track.setAttribute('role', 'progressbar'); track.setAttribute('aria-label', x[0]); track.setAttribute('aria-valuenow', String(Math.round(pct))); track.setAttribute('aria-valuemin', '0'); track.setAttribute('aria-valuemax', '100');
              var fill = el('div', 'pd-bar-fill'); fill.style.width = pct + '%';
              track.appendChild(fill); row.appendChild(track); bars.appendChild(row);
            });
            var notes = [];
            if (b.pendingCount) notes.push(fmt(p.total || 0) + ' more hours waiting for your supervisor’s approval.');
            if (!b.link) notes.push('Your supervisor hasn’t linked you yet, so these use the default targets.');
            $('pd-h-note').textContent = notes.join(' ');
            $('pd-h-note').hidden = !notes.length;
            $('pd-hours').hidden = false;
          })
          .catch(function () {});
      }

      // ----- suggestions -----
      $('pd-suggest').addEventListener('submit', function (e) {
        e.preventDefault();
        var msg = $('pd-suggest-msg'), btn = this.querySelector('button'), topic = $('pd-topic').value.trim();
        if (topic.length < 3) { msg.textContent = 'Please type a topic first.'; return; }
        btn.disabled = true; msg.textContent = 'Sending…';
        fetch('/api/dashboard?office=' + encodeURIComponent(currentOffice), { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ topic: topic }) })
          .then(function (r) { return r.json(); })
          .then(function (b) { if (b.ok) { msg.textContent = 'Thanks! Your suggestion was added.'; $('pd-topic').value = ''; } else msg.textContent = b.error || 'Something went wrong.'; })
          .catch(function () { msg.textContent = 'Something went wrong. Please try again.'; })
          .finally(function () { btn.disabled = false; });
      });

      function showOffice(on) { ['pd-tiles', 'pd-training', 'pd-suggest-card'].forEach(function (id) { $(id).hidden = !on; }); }

      function load(office) {
        currentOffice = office;
        ['pd-soon', 'pd-error'].forEach(function (id) { $(id).hidden = true; });
        showOffice(false);
        $('pd-updated').textContent = 'Loading…';
        var q = '?office=' + encodeURIComponent(office);
        Promise.all([
          fetch('/api/dashboard' + q, { credentials: 'same-origin' }).then(function (r) { return r.json(); }),
          fetch('/api/rooms' + q, { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : { claims: [] }; }).catch(function () { return { claims: [] }; }),
        ]).then(function (res) {
          var b = res[0];
          claims = res[1].claims || [];
          $('pd-updated').textContent = '';
          if (b.available === false) { $('pd-soon').hidden = false; return; }
          if (b.error) { $('pd-error').textContent = b.error; $('pd-error').hidden = false; return; }
          data = b;
          renderTraining(); renderRoomsTile();
          showOffice(true);
          var ago = Math.round((Date.now() - b.fetchedAt) / 60000);
          $('pd-updated').textContent = 'From the ' + ($('pd-office-pick').selectedOptions[0] || {}).textContent + ' Team Dashboard sheet · updated ' + (ago < 2 ? 'just now' : ago + ' minutes ago') + (b.stale ? ' (the sheet couldn’t be reached just now)' : '') + '.';
        }).catch(function () { $('pd-updated').textContent = ''; $('pd-error').textContent = 'The dashboard couldn’t load. Please refresh the page.'; $('pd-error').hidden = false; });
      }

      // ----- new-hire checklist + directors' approvals -----
      var ob = null;
      function lsGet(k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } }
      // Orientation progress from the account (any device) plus anything only this browser knows yet.
      function orientationHere() {
        var slugs = JSON.parse($('ob-card').dataset.slugs || '[]');
        var seen = lsGet('tt-orientation-done') || {};
        (ob && ob.lessons || []).forEach(function (s) { seen[s] = 1; });
        var n = slugs.filter(function (s) { return seen[s]; }).length;
        var sr = lsGet('spq.progress.v1') || {};
        var review = !!(ob && ob.skillsReview) || !!sr.finished;
        var localOnly = slugs.filter(function (s) { return seen[s] && (ob && ob.lessons || []).indexOf(s) < 0; });
        return { viewed: n, total: slugs.length, review: review, localOnly: localOnly, reviewLocalOnly: !!sr.finished && !(ob && ob.skillsReview) };
      }
      function obPost(step, done) {
        $('ob-msg').textContent = '';
        return fetch('/api/onboarding', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ step: step, done: done }) })
          .then(function (r) { return r.json(); })
          .then(function (b) { if (b && b.steps) { ob = b; renderOb(); } if (b && b.error) $('ob-msg').textContent = b.error; })
          .catch(function () { $('ob-msg').textContent = 'That didn’t save. Please try again.'; });
      }
      function renderOb() {
        var card = $('ob-card');
        if (!ob || !ob.show) { card.hidden = true; return; }
        card.hidden = false;
        $('ob-preview').hidden = !ob.preview;
        var done = ob.done || {}, locked = !!ob.submittedAt, n = 0;
        var o = orientationHere();
        // Save progress this browser has that the account doesn't yet; the server ticks Orientation when it's complete.
        if ((o.localOnly.length || o.reviewLocalOnly) && !renderOb.synced) {
          renderOb.synced = true;
          fetch('/api/onboarding', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ lessons: o.localOnly, skillsReview: o.reviewLocalOnly }) })
            .then(function (r) { return r.ok ? r.json() : null; }).then(function (b) { if (b && b.steps) { ob = b; renderOb(); } }).catch(function () {});
        }
        var mine = {}; ob.steps.forEach(function (st) { mine[st.id] = 1; });
        card.querySelectorAll('[data-step]').forEach(function (li) { li.hidden = !mine[li.dataset.step]; });
        fillDrafts();
        ob.steps.forEach(function (st) {
          var li = card.querySelector('[data-step="' + st.id + '"]'); if (!li) return; var ok = !!done[st.id]; if (ok) n++;
          li.classList.toggle('done', ok);
          card.querySelectorAll('[data-tick="' + st.id + '"]').forEach(function (b) {
            b.hidden = locked || (st.id === 'orientation' && ok);
            if (st.id !== 'orientation') b.textContent = ok ? 'Undo' : b.dataset.label;
            b.classList.toggle('undo', ok);
          });
        });
        $('ob-orient-prog').hidden = !!done.orientation; $('ob-orient-prog').textContent = 'Progress: ' + o.viewed + ' of ' + o.total + ' lessons opened · Skills review ' + (o.review ? 'passed' : 'not finished yet') + '.';
        $('ob-n').textContent = n; $('ob-total').textContent = ob.steps.length; $('ob-bar').style.width = Math.round(n / ob.steps.length * 100) + '%';
        var d = ob.director || {};
        if (locked) {
          card.classList.add('sent');
          $('ob-heading').textContent = 'All done. Nice work!';
          $('ob-sub').textContent = 'Your checklist is with ' + (d.name || 'your practice director') + ' for approval. They’ll set up a time with you to finish onboarding, and this list will disappear once they approve it.';
        }
      }
