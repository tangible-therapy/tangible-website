<script is:inline>
  // Upcoming staff birthdays (next 30 days) from /api/birthdays (private Birthdays tab, month and day only).
  (function () {
    var card = document.getElementById('pd-bdays'), list = document.getElementById('pd-bday-list');
    if (!card) return;
    fetch('/api/birthdays', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (b) {
      if (!b || !b.birthdays || !b.birthdays.length) return;
      var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      var items = b.birthdays.map(function (x) {
        var m = +x.md.slice(0, 2) - 1, d = +x.md.slice(3, 5), next = new Date(today.getFullYear(), m, d);
        if (next < today) next = new Date(today.getFullYear() + 1, m, d);
        return { name: x.name, date: next, days: Math.round((next - today) / 86400000) };
      }).filter(function (x) { return x.days <= 30; }).sort(function (a, z) { return a.days - z.days || a.name.localeCompare(z.name); });
      if (!items.length) return;
      items.forEach(function (x) {
        var li = document.createElement('li'); if (x.days === 0) li.className = 'today';
        var n = document.createElement('span'); n.className = 'pd-bday-name'; n.textContent = x.name;
        var w = document.createElement('span'); w.className = 'pd-bday-when';
        w.textContent = x.days === 0 ? 'Today 🎉' : x.days === 1 ? 'Tomorrow' : x.date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        li.append(n, w); list.append(li);
      });
      card.hidden = false;
    }).catch(function () {});
  })();
</script>

