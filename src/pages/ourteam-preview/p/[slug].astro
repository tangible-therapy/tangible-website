---
// DEMO of the redesigned therapist profile. Only Phil for now; hidden (noindex, not in the sitemap).
// Once approved, src/pages/ourteam/p/[slug].astro will use <TherapistProfile /> for everyone.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TherapistProfile from '../../../components/TherapistProfile.astro';
import { getFinderData } from '../../../lib/therapist-sheet';

export async function getStaticPaths() {
  const DEMO = ['phil-childs'];
  const team = await getCollection('team');
  return team.filter((t) => DEMO.includes(t.id)).map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}
const { entry } = Astro.props;
const { therapists } = await getFinderData();
const t = therapists.find((x) => x.slug === entry.id)!;
const d = entry.data;
---
<Base title={`${d.seoTitle || d.name} (preview) | Tangible Therapy`} description={d.seoDescription} image={d.photo} noindex>
  <div class="preview-note" role="note"><strong>Preview only.</strong> New profile layout demo. The live page is <a href={`/ourteam/p/${entry.id}`}>/ourteam/p/{entry.id}</a>.</div>
  <TherapistProfile entry={entry} t={t} backHref="/ourteam-preview" />
</Base>

<style>
  .preview-note { background: #fff7d6; color: #3b3f3c; font-size: 13px; padding: 8px var(--gutter); text-align: center; }
  .preview-note a { color: inherit; }
</style>
