---
import GoogleForm from '../components/GoogleForm.astro';
import Base from '../layouts/Base.astro';
---
<Base title={"CEU Presenter Application | Tangible Therapy"} description={""}>
<section class="sec t-white h-small">
<div class="sec-in">
<div class="fe" style="--rows:23;--mrows:18">
  <div class="b b-html jc" style="--d:1/5/4/23;--m:1/2/3/10"><div class="rte"><h1 class="ta-center">CEU Presenter Application</h1></div></div>
  <div class="b b-image jc" style="--d:6/2/24/26;--m:3/2/19/10;--dz:2;--mz:2"><figure class="img fill" style="--r:20px"><img src="/images/imgg-exe-xg0ckwdv-325607.jpg" alt="" width="1200" height="896" loading="lazy" decoding="async"></figure></div>
</div>
</div>
</section>

<section class="sec t-white h-small">
<div class="sec-in">
<div class="fe" style="--rows:28;--mrows:31">
  <div class="b b-html" style="--d:1/2/3/9;--m:1/2/3/10"><div class="rte"><h3>Tell Us About You</h3></div></div>
  <div class="b b-form" style="--d:1/14/29/26;--m:9/2/32/10;--dz:4;--mz:4"><GoogleForm id="1FAIpQLSdOeumNnpM8WPYmUt6pacHJGGQN5sLpid5n14XKwMnUtrDGbg" title="CEU Presenter Application" height={1750} /></div>
  <div class="b b-html" style="--d:3/2/6/9;--m:3/2/5/10"><div class="rte"><p class="sm">Please fill out the information in the appropriate boxes. We’re looking for your general information, what you would like to present on and why you think it would be a good fit for other therapists.</p></div></div>
  <div class="b b-html" style="--d:6/2/8/9;--m:5/2/7/10"><div class="rte"><h3>Requirements</h3></div></div>
  <div class="b b-html" style="--d:8/2/12/10;--m:7/2/9/10;--dz:5;--mz:5"><div class="rte"><ul><li><p>Fully licensed in your field (LCSW, LMFT, etc).</p></li><li><p>Preferred specialized training or accreditation.</p></li><li><p>Must be free of charge.</p></li><li><p>An 75-80 Minute presentation, leaving enough time for introductions and Q&amp;A.</p></li></ul></div></div>
</div>
</div>
</section>
</Base>
