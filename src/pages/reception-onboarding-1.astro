---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
---
<Base title={"Payroll | Tangible Therapy"} description={""} noindex>
<section class="sec t-light h-small has-div" style="--divh:2vw">
<div class="sec-in">
<div class="fe" style="--rows:5;--mrows:3">
  <div class="b b-html je" style="--d:1/9/6/19;--m:1/2/4/10"><div class="rte"><div class="scaled"><span class="scaled-in"><h1>Payroll</h1></span></div></div></div>
</div>
</div>
<Divider type="wavy" height={2} width={20} fill="#fff" flipX flipY /></section>

<section class="sec t-white h-medium">
<div class="sec-in">
<div class="fe" style="--rows:7;--mrows:4">
  <div class="b b-button jc" style="--d:1/11/3/17;--m:1/2/3/10;--dz:3;--mz:3"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="https://docs.google.com/spreadsheets/d/1JFs5ENfbAr4_QFXWTVoEXULX4Xxbhk5NdF9PIjfp-ow/edit?gid=1082563411#gid=1082563411" target="_blank" rel="noopener">Payroll Form</a></div></div>
  <div class="b b-html" style="--d:4/3/8/25;--m:3/2/5/10;--dz:2;--mz:2"><div class="rte"><ol><li><h4>Go to the payroll page and using the payroll form responses update the spreadsheet.</h4></li><li><h4>Send an email to <span class="ul">nsbcpayroll@gmail.com</span> CC’ing “directors@tangiblementalhealth.com”</h4></li></ol></div></div>
</div>
</div>
</section>
</Base>
