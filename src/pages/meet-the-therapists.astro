---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
---
<Base title={"Meet the Therapists | Tangible Therapy"} description={"Get to know the therapists at Tangible Therapy. Experienced, approachable professionals offering personalized, skills-based care for your unique needs."}>
<section class="sec t-black h-medium has-bg has-div" style="--divh:6vw">
<div class="sec-bg"><img src="/images/adobestock-1555959530-69b3bb.jpg" alt="" style="object-position:72% 5%" loading="eager"><div class="sec-ov" style="opacity:0.4"></div></div><div class="sec-in">
<div class="fe" style="--rows:8;--mrows:10">
  <div class="b b-html" style="--d:1/5/7/23;--m:1/2/7/10"><div class="rte"><h1 class="ta-center">Meet the Team Behind Tangible Therapy</h1><p class="lg ta-center">Therapists who bring real-world experience, clinical skill, and genuine care to every session</p></div></div>
  <div class="b b-button jc" style="--d:7/11/9/17;--m:7/2/9/10;--dz:4;--mz:4"><div class="btn-wrap ta-center"><a class="btn btn-primary btn-medium btn-full" href="https://tangible.clientsecure.me/">Book Your First Session Today</a></div></div>
</div>
</div>
<Divider type="wavy" height={6} width={100} fill="#fff" /></section>

<section class="sec t-bright-inverse h-small">
<div class="sec-in">
<div class="fe" style="--rows:12;--mrows:22">
  <div class="b b-image jc" style="--d:2/16/12/26;--m:14/2/22/10;--dz:4;--mz:4"><figure class="img fill" style="--r:40px;--fp:61% 0%"><img src="/images/copy-of-brady-1-8eb4aa.jpg" alt="Two women sitting on a brown couch during a therapy session, with labels pointing to their feelings and physical states: one woman with a tight chest and uncontrollable thoughts, the other with difficult breathing and racing heartbeat." width="1880" height="1576" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:3/2/6/12;--m:2/2/4/10;--dz:2;--mz:2"><div class="rte"><h3>You deserve a therapist who truly gets you</h3></div></div>
  <div class="b b-html" style="--d:6/2/11/12;--m:4/2/15/10;--dz:3;--mz:3"><div class="rte"><p>At Tangible Therapy, we believe your connection with your therapist is as important as the tools you use in session. That’s why we’ve built a team of highly trained professionals who are also deeply human.</p><p>Our therapists bring a range of expertise, backgrounds, and lived experience to support you with honesty, warmth, and respect.</p></div></div>
</div>
</div>
</section>

<section class="sec t-black h-custom">
<div class="sec-in" style="padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);">
<div class="fe" style="--rows:14;--mrows:6">
  <div class="b b-code" style="--d:1/2/15/26;--m:1/2/7/10"><!-- FILTER BUTTONS -->
<h2 class="" style="text-align:center;">
        Find Your Therapist
      </h2>
<!-- FILTER BUTTONS -->
<div class="filters">
<button class="filter-btn active" data-category="all">All</button>
<button class="filter-btn" data-category="adhd">ADHD</button>
<button class="filter-btn" data-category="anxiety">Anxiety</button>
<button class="filter-btn" data-category="autism">Autism</button>
<button class="filter-btn" data-category="couples">Couples</button>
<button class="filter-btn" data-category="depression">Depression</button>
<button class="filter-btn" data-category="emdr">EMDR</button>
<button class="filter-btn" data-category="faith-transitions">Faith Transitions</button>
<button class="filter-btn" data-category="grief">Grief</button>
<button class="filter-btn" data-category="ifs">IFS</button>
<button class="filter-btn" data-category="lgbt">LGBT+</button>
<button class="filter-btn" data-category="ocd">OCD</button>
<button class="filter-btn" data-category="ptsd">PTSD</button>
<button class="filter-btn" data-category="teens">Teens</button>
<button class="filter-btn" data-category="trauma">Trauma</button>
<button class="filter-btn" data-category="current-openings">Current Openings</button>
</div>
<!-- STYLES -->
<style is:inline>
.filters {
  display: flex;
  flex-wrap: wrap;
  
    justify-content: center;

  gap: 8px;
  margin: 20px 0;
}
.filter-btn {
  padding: 8px 14px;
  background: #f0f0f0;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  transition: background 0.3s;
}
.filter-btn.active {
  background: #333;
  color: white;
}
.grid-item {
  transition: all 0.3s ease;
}

h2.nested-category-title {}

.tweak-products-header-text-alignment-middle .products.collection-content-wrapper .nested-category-title, .tweak-products-header-text-alignment-middle .ProductList.ProductItem-relatedProducts .nested-category-title
{display:none;}

ul.nested-category-children {
    display: none !important;
}

section#therapy {}

section.page-section.product-list-section.full-bleed-section.black {
    margin-top: -12%;
}
</style>
<!-- SCRIPT -->
<script is:inline>
document.addEventListener("DOMContentLoaded", function () {
  const categoryMap = {
    "Emily McCrary, CSW": ["/ocd", "/lgbt", "/anxiety", "/emdr", "/depression", "/couples", "/trauma"],
    "Hannah Hunt, CSW": ["/lgbt", "/anxiety", "/emdr", "/ifs", "/grief", "/faith-transitions", "/ptsd", "/depression", "/teens", "/trauma"],
    "Brady Clegg, LCSW": ["/ocd", "/lgbt", "/anxiety", "/autism", "/faith-transitions", "/adhd", "/depression", "/trauma"],
    "Joe Johnson, LCSW": ["/ocd", "/anxiety", "/emdr", "/adhd", "/ptsd", "/depression", "/current-openings", "/trauma"],
    "Skyler Anderson, AMFT": ["/ocd", "/lgbt", "/anxiety", "/emdr", "/grief", "/faith-transitions", "/depression", "/couples", "/trauma", "/teens"],
    "Arianne Buck, LCSW": ["/lgbt", "/anxiety", "/emdr", "/adhd", "/faith-transitions", "/ptsd", "/depression", "/trauma"],
    "Nancy Coca, CSW": ["/lgbt", "/anxiety", "/autism", "/grief", "/depression", "/teens"],
    "Hannah Brown, LCSW": ["/lgbt", "/anxiety", "/ifs", "/grief", "/faith-transitions", "/adhd", "/ptsd", "/depression", "/couples", "/trauma"],
    "Sarah Mendez, CSW": ["/ocd", "/lgbt", "/anxiety", "/emdr", "/grief", "/faith-transitions", "/ptsd", "/depression", "/trauma", "/teens"],
    "Lauren Olinger, ACMHC": ["/ocd", "/lgbt", "/anxiety", "/faith-transitions", "/adhd", "/grief", "/depression", "/current-openings", "/teens", "/trauma"],
    "Parker Jensen, CSW": ["/lgbt", "/anxiety", "/emdr", "/adhd", "/ptsd", "/autism", "/grief", "/depression", "/couples", "/trauma", "/teens"],
    "Kelley Graves, MFT-I": ["/ocd", "/lgbt", "/anxiety", "/faith-transitions", "/adhd", "/grief", "/depression", "/current-openings", "/couples", "/teens", "/trauma"]
  };

  const interval = setInterval(() => {
    const products = document.querySelectorAll(".grid-item");
    if (products.length > 0) {
      clearInterval(interval);

      products.forEach(product => {
        const nameEl = product.querySelector(".grid-title");
        if (!nameEl) return;
        const name = nameEl.textContent.trim();
        const categories = categoryMap[name] || [];
        product.dataset.categories = categories.join(", ");
      });

      const buttons = document.querySelectorAll(".filter-btn");
      buttons.forEach(button => {
        button.addEventListener("click", () => {
          const selected = button.dataset.category.toLowerCase();

          products.forEach(product => {
            const productCats = (product.dataset.categories || "").toLowerCase();
            const match =
              selected === "all" ||
              productCats.includes(`/${selected}`);

            product.style.display = match ? "block" : "none";
          });

          buttons.forEach(btn => btn.classList.remove("active"));
          button.classList.add("active");
        });
      });
    }
  }, 300);
});
</script></div>
</div>
</div>
</section>

