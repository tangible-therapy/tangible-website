---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
// Job openings by office — add, remove or edit roles here.
const jobGroups = [
  { office: 'Orem Office', jobs: [
    { title: 'Therapist / Clinical Supervisor', type: 'Full time', href: '/careers-1-1' },
    { title: 'Evening Couples Therapist', type: 'Part time', href: '/sandycouples-1-1' },
  ] },
  { office: 'Provo Office', jobs: [
    { title: 'Evening Couples Therapist', type: 'Part time', href: '/sandycouples-1' },
  ] },
  { office: 'Sandy Office', jobs: [
    { title: 'Therapist', type: 'Full time', href: '/careers-1-2' },
    { title: 'Evening Couples Therapist', type: 'Part time', href: '/sandycouples' },
  ] },
  { office: 'Fully Remote', jobs: [] as { title: string; type: string; href: string }[] },
];
---
<Base title={"Careers | Tangible Therapy"} description={"Tangible Therapy is one of Utah's best places to work as a therapist. Join a growing team in Provo & Orem with 401k, PTO, Free CEUs, health benefits & real support."}>
<section class="sec t-light h-medium">
<div class="sec-in">
<div class="fe" style="--rows:23;--mrows:38">
  <div class="b b-html" style="--d:1/3/6/14;--m:1/2/5/10;--dz:3;--mz:3"><div class="rte"><div class="scaled"><span class="scaled-in"><h1> Careers</h1></span></div></div></div>
  <div class="b b-image jc" style="--d:3/15/17/26;--m:5/1/14/11;--dz:12;--mz:12"><figure class="img fill" style="--r:40px;--fit:contain"><img src="/images/brady-6799eb.jpg" alt="Portrait of a smiling man with curly brown hair, a beard, and wearing a light gray shirt, alongside a welcome message from Brady Clegg, CEO/Founder." width="2820" height="2364" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:6/3/15/14;--m:15/2/25/10;--dz:10;--mz:10"><div class="rte"><p>Tangible Therapy is a fast-growing, Utah-based private practice. We pride ourselves on being an employee-conscious workspace. While at Tangible, we want you to feel supported, well-trained, and to keep a good work-life balance. Your work should be meaningful and fulfilling, not all-consuming.</p><p>Our vision at Tangible is focused on 2 things:</p><ol><li><p>Being the best place in Utah for Clients to receive care</p></li><li><p>Being the best place in Utah for Therapists to work.</p></li></ol><p>We’re one of the highest-rated clinics in Utah. If you’re interested in learning more, come see what the hype is all about!</p></div></div>
  <div class="b b-button jc" style="--d:16/5/18/11;--m:25/3/27/9;--dz:11;--mz:11"><div class="btn-wrap ta-center"><a class="btn btn-secondary btn-large btn-full" href="#openings">Current Openings</a></div></div>
  <div class="b b-html" style="--d:20/5/22/10;--m:27/2/29/10;--dz:6;--mz:6"><div class="rte"><h4 class="ta-center">Current Tangible Team Members</h4></div></div>
  <div class="b b-html" style="--d:20/12/22/16;--m:31/2/33/10;--dz:7;--mz:7"><div class="rte"><h4 class="ta-center">Clients Served</h4></div></div>
  <div class="b b-html" style="--d:20/18/22/24;--m:35/2/37/10;--dz:7;--mz:7"><div class="rte"><h4>Sessions Performed</h4></div></div>
  <div class="b b-html" style="--d:22/6/24/9;--m:29/2/31/10;--dz:7;--mz:7"><div class="rte"><div class="scaled"><span class="scaled-in"><h3 class="ta-center">36&nbsp;</h3></span></div></div></div>
  <div class="b b-html" style="--d:22/12/24/16;--m:33/2/35/10;--dz:8;--mz:8"><div class="rte"><div class="scaled"><span class="scaled-in"><h3 class="ta-center">2230</h3></span></div></div></div>
  <div class="b b-html" style="--d:22/18/24/23;--m:37/2/39/10;--dz:8;--mz:8"><div class="rte"><div class="scaled"><span class="scaled-in"><h3 class="ta-center">31,412</h3></span></div></div></div>
</div>
</div>
</section>

<section class="sec t-white-bold h-small has-div" style="--divh:8vw">
<div class="sec-in">
<div class="fe" style="--rows:65;--mrows:73">
  <div class="b b-shape jc" style="--d:1/2/12/26;--m:1/2/15/10"><div class="shape" style="background:hsla(var(--black-hsl), 1);border-radius:40px"></div></div>
  <div class="b b-html inset-m" style="--d:2/9/5/19;--m:2/2/4/10;--dz:2;--mz:2"><div class="rte"><h1 class="ta-center">Benefits &amp; Perks</h1></div></div>
  <div class="b b-html" style="--d:5/3/10/25;--m:4/3/14/9;--dz:8;--mz:14"><div class="rte"><h3 class="ta-center"><span class="c-accent">Compensation &amp; team culture are important to us. We take pride in creating a space where people want to be. You take care of our clients so let us take care of you.</span></h3></div></div>
  <div class="b b-image jc" style="--d:14/15/24/25;--m:15/6/20/11;--dz:9;--mz:15"><figure class="img fill" style="--fit:contain"><img src="/images/tangible-3cd365.webp" alt="A woman with brown hair and freckles holding pink sunglasses with dark lenses, making a puckered lips expression." width="3023" height="3110" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:16/5/17/9;--m:16/2/17/6;--dz:6;--mz:10"><div class="rte"><h4>Full-Time Employees</h4></div></div>
  <div class="b b-html" style="--d:17/5/22/14;--m:17/2/21/7;--dz:10;--mz:16"><div class="rte"><h1 class="benefit-h">Paid Time Off</h1></div></div>
  <div class="b b-html" style="--d:22/5/23/15;--m:21/2/25/10;--dz:11;--mz:3"><div class="rte"><p class="sm"><span class="c-accent">We know that great therapy starts with you. That’s why Tangible offers Paid Time Off (PTO). Whether it's for rest, travel, family time, or simply recharging, we encourage time away from work as a vital part of sustaining meaningful work-life blance.</span></p></div></div>
  <div class="b b-image jc" style="--d:24/3/34/12;--m:25/2/30/7;--dz:4;--mz:17"><figure class="img fill" style="--fit:contain"><img src="/images/tangible-1-74108a.webp" alt="An elderly couple sitting on a sofa, hugging and smiling at the camera." width="3023" height="3110" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:24/19/25/23;--m:52/7/53/10;--dz:7;--mz:11"><div class="rte"><h4 class="ta-right">All Employees</h4></div></div>
  <div class="b b-html" style="--d:25/15/28/23;--m:28/5/30/10;--dz:3;--mz:4"><div class="rte"><h1 class="ta-right benefit-h">401k Plan</h1></div></div>
  <div class="b b-html" style="--d:28/12/34/23;--m:30/2/41/10;--dz:5;--mz:7"><div class="rte"><p class="sm"><span class="c-accent">We’re not just thinking about today, we’re helping you plan for tomorrow. Our 401(k) retirement plans empower you to build long-term financial security with ease. With <strong>employer contributions</strong> and flexible investment options, it’s our way of supporting your future goals while you support others in the present. </span></p><p class="sm"><span class="c-accent">Our 401k plan includes a 100% match for the first 3% of contributions and 50% of the next 2%. Meaning if you would like to receive the full company match, you contribute 5% of your paycheck and we will match you 4%. </span></p></div></div>
  <div class="b b-html" style="--d:35/5/36/9;--m:41/2/43/6;--dz:5;--mz:12"><div class="rte"><h4>Full-Time Employees</h4></div></div>
  <div class="b b-image jc" style="--d:35/15/45/25;--m:40/6/45/10;--dz:12;--mz:18"><figure class="img fill" style="--fit:contain"><img src="/images/tangible-2-fb735c.webp" alt="A playful moment with two men and a young boy inside a bright, modern room. One man with a beard is carrying the boy on his shoulders, smiling and looking up. The boy is holding onto the man&#x27;s head, looking to the side." width="3023" height="3110" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:36/5/41/13;--m:43/2/46/7;--dz:3;--mz:6"><div class="rte"><h1 class="benefit-h">Health Insurance</h1></div></div>
  <div class="b b-html" style="--d:41/5/45/15;--m:46/2/52/10;--dz:4;--mz:9"><div class="rte"><p class="sm"><span class="c-accent">Your health is essential. That’s why we provide a flexible option to ensure you can get coverage that makes sense for you. Our health insurance benefit offers up to $500 a month of reimbursement towards a health insurance premium. This allows you to go to the marketplace and find a plan that best fits your needs. </span></p></div></div>
  <div class="b b-image jc" style="--d:46/3/56/13;--m:51/2/57/7;--dz:5;--mz:19"><figure class="img fill" style="--fit:contain"><img src="/images/tangible-3-2fea9c.webp" alt="A young woman with dark hair laughing and pointing to her left, wearing a beige tank top, white unbuttoned shirt, jeans, and a smartwatch, standing against a white background." width="3023" height="3110" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:46/19/47/23;--m:27/7/28/10;--dz:8;--mz:13"><div class="rte"><h4 class="ta-right">All Employees</h4></div></div>
  <div class="b b-html" style="--d:47/13/52/23;--m:57/2/58/10;--dz:3;--mz:5"><div class="rte"><h1 class="ta-right benefit-h">Full-Service Support</h1></div></div>
  <div class="b b-html" style="--d:52/13/55/23;--m:58/2/63/10;--dz:4;--mz:8"><div class="rte"><p class="sm"><span class="c-accent">At Tangible, we want you to do therapy and we’ll take care of the rest. Malpractice insurance, credentialing, marketing, billing, scheduling— Leave it to us. You can work with confidence, knowing we have your back.</span></p></div></div>
  <div class="b b-html" style="--d:56/5/57/9;--m:63/2/65/7;--dz:6;--mz:13"><div class="rte"><h4>All Employees</h4></div></div>
  <div class="b b-image jc" style="--d:56/15/66/25;--m:62/6/67/10;--dz:13;--mz:19"><figure class="img fill" style="--fit:contain"><img src="/images/tangible-5-d7dcd3.jpg" alt="Man giving a presentation to a group of six people in a modern room with large windows, a whiteboard, and potted plants." width="3023" height="3110" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:57/5/62/13;--m:64/2/68/7;--dz:4;--mz:7"><div class="rte"><h1 class="benefit-h">Quality Training</h1></div></div>
  <div class="b b-html" style="--d:62/5/66/15;--m:68/2/74/10;--dz:5;--mz:10"><div class="rte"><p class="sm"><span class="c-accent">Our focus at Tangible is providing great training opportunities that in turn create great therapists. We want you to be good at what you do, and we have a clear road map to get you there. With in-house trainings on EMDR, IFS and other modailities, you can look forward to new found confidence. With quality as the focus, each training at Tangible are certified CEU’s.</span></p></div></div>
</div>
</div>
<Divider type="scalloped" height={8} width={100} fill="#565d57" flipY /></section>

<section class="sec t-light h-small has-div" style="--divh:8vw">
<div class="sec-in">
<div class="fe" style="--rows:12;--mrows:10">
  <div class="b b-html" style="--d:3/3/8/10;--m:1/2/5/10;--dz:2;--mz:2"><div class="rte"><h1>About us</h1><p class="lg">Est. 2021</p></div></div>
  <div class="b b-html" style="--d:3/12/13/24;--m:5/2/11/10;--dz:3;--mz:3"><div class="rte"><p>Tangible was founded in 2021 by Brady Clegg from his home in Eagle Mountain, Utah. After 10 years of working in the residential treatment industry he decided it was time to venture out onto his own. His hope was to create a space where clients could be empowered by learning tangible skills.</p><p>Two years later, Brady realized that the thing he missed most from working with a group was the ability to train and develop other professionals. So in 2023, four more people joined the team. From the beginning, Tangible has been focused on creating a space for professionals to flourish.</p><p>Since that point more therapists and other team members have joined. Tangible promises to continue providing therapists with a great place to work and clients with excellent, skill-based care.</p></div></div>
</div>
</div>
<Divider type="scalloped" height={8} width={100} fill="#fff" flipY /></section>

<section class="sec t-white-bold jobs-sec" id="openings">
<div class="sec-in">
<div class="wrap">
  <div class="jobs-head">
    <h2>Job Openings</h2>
    <p>Find a role at the office that works best for you. Click any opening to see the details and apply.</p>
  </div>
  <div class="jobs-grid">
    {jobGroups.map((g) => (
      <div class="jobs-card">
        <div class="jobs-card-head">
          <h3>{g.office}</h3>
          <span class="jobs-count">{g.jobs.length ? `${g.jobs.length} ${g.jobs.length === 1 ? 'opening' : 'openings'}` : 'No openings'}</span>
        </div>
        {g.jobs.length ? (
          <ul class="jobs-list">
            {g.jobs.map((j) => (
              <li>
                <a href={j.href}>
                  <span class="jobs-title">{j.title}</span>
                  <span class="jobs-type">{j.type}</span>
                  <span class="jobs-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="jobs-none">No current openings. Check back soon!</p>
        )}
      </div>
    ))}
  </div>
</div>
</div>
</section>
</Base>
