---
import ApplyCard from '../components/ApplyCard.astro';
import Base from '../layouts/Base.astro';
---
<Base title={"Part-Time Therapist | Tangible Therapy"} description={"Tangible Therapy is one of Utah's best places to work as a therapist. Join a growing team in Provo & Orem with 401k, Free CEUs, Top-tier training & real support."}>
<section class="sec t-light-bold h-medium">
<div class="sec-in">
<div class="fe" style="--rows:32;--mrows:19">
  <div class="b b-html" style="--d:1/7/4/21;--m:1/2/6/10"><div class="rte"><div class="scaled"><span class="scaled-in"><h1 class="ta-center"><span class="c-black">Part-Time Therapist</span></h1></span></div></div></div>
  <div class="b b-html" style="--d:5/3/29/17;--m:6/2/8/10;--dz:10;--mz:10"><div class="rte"><p class="lg"><strong>What we’re looking for</strong></p><ul><li><p>A desire to be a part of an amazing team</p></li><li><p>An eagerness to learn and grow</p></li><li><p>Professional attitude and appearance</p></li><li><p>Full-time commitment</p></li><li><p>Excellent organizational skills</p></li><li><p>Multitasking and time-management skills, with the ability to prioritize tasks</p></li><li><p>Customer service attitude</p></li></ul><p class="lg"><strong>Work Duties</strong></p><ul><li><p>Counseling in office and via telehealth</p></li><li><p>Providing mental health assessment, treatment planning, and counseling</p></li><li><p>Maintaining detailed and accurate documentation of patient information and treatment plan progress and outcomes</p></li><li><p>Attend all meetings and conferences</p></li><li><p>Adhere to all facility and licensing standards</p></li></ul><p class="lg"><strong>Qualifications</strong></p><ul><li><p>Master Level Clinician: CSW, MFT, CMHC</p></li><li><p>Licensed by the State of Utah</p></li><li><p>Effective interpersonal skills, ability to follow instructions, good written and verbal communication skills, time management skills</p><p></p></li></ul><p>Note: This job description is not intended to be all-inclusive. The employee may perform other related duties as assigned by their supervisor.</p></div></div>
  <div class="b b-shape jc" style="--d:5/17/33/25;--m:8/2/20/10"><div class="shape" style="background:var(--shape);border-radius:40px"></div></div>
  <div class="b b-html inset-m" style="--d:6/18/33/24;--m:9/2/11/10;--dz:9;--mz:9"><div class="rte"><h3 class="ta-center"><span class="c-accent">Compensation &amp; Benefits</span></h3><ul><li><p><span class="c-accent">$55-$75 per hour</span></p></li><li><p><span class="c-accent">401k with matching</span></p></li><li><p><span class="c-accent">Flexible schedule</span></p></li><li><p><span class="c-accent">Full service support - we market, onboard, bill, collect, and help manage your clients</span></p></li><li><p><span class="c-accent">Full Caseloads</span></p></li><li><p><span class="c-accent">Group Malpractice Insurance</span></p></li><li><p><span class="c-accent">Training/Continuing Education (EMDR, IFS, ACT &amp; More)</span></p></li><li><p><span class="c-accent">No-Show protection</span></p></li><li><p><span class="c-accent">Client non-payment protection (you get paid regardless)</span></p></li><li><p><span class="c-accent">Calm and supportive work environment</span></p></li><li><p><span class="c-accent">No required On-Call</span></p></li><li><p><span class="c-accent">W2 employment model, essential for supervision</span></p></li><li><p><span class="c-accent">Simple Electronic Health Record platform</span></p></li><li><p><span class="c-accent">Amazing team culture and clinical support</span></p></li><li><p><span class="c-accent">Career advancement opportunities (Want to open your own practice?)</span></p></li><li><p><span class="c-accent">High-quality and paid training and supervision (Even for Fully-licensed Clinicians)</span></p></li></ul></div></div>
</div>
</div>
</section>

<section class="sec t-white h-small">
<div class="sec-in">
<div class="fe" style="--rows:13;--mrows:18">
  <div class="b b-html" style="--d:1/9/4/19;--m:1/2/3/10;--dz:6;--mz:6"><div class="rte"><h1 class="ta-center"><span class="c-lightAccent">Apply Here!</span></h1></div></div>
  <div class="b b-form b-apply" style="--d:4/9/13/19;--m:4/2/18/10;--dz:2;--mz:2"><ApplyCard href="https://docs.google.com/forms/d/e/1FAIpQLScoVaLpUFeeFDfy-WJgwnxSXNz0J8RRSoNv_Dopa8ZmCgZi7g/viewform" role={"Part-Time Therapist — Orem"} /></div>
</div>
</div>
</section>
</Base>
