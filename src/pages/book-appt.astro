---
import Base from '../layouts/Base.astro';
import Summary from '../components/Summary.astro';
---
<Base title={"Book With Utah's Top Therapists | Tangible Therapy"} description={"Book today with Utah's \"Best of State\" therapists in Provo, Orem & Sandy. Therapy at Utah's lowest rates: $115 cash or ~$25 with insurance."}>
<section class="sec t-white h-custom">
<div class="sec-in" style="padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);">
<div class="fe" style="--rows:20;--mrows:29">
  <div class="b b-image jc" style="--d:1/14/21/27;--m:1/1/13/11"><figure class="img fill"><img src="/images/imgg-demo-gwbyobuj-43c94c.jpg" alt="A woman with dark wavy hair sitting on a bench, writing in a notebook. She is next to a wooden wall with vertical panels and an abstract art piece leaning against the wall, featuring earthy tones and geometric shapes. Sunlight comes through a window, casting shadows." width="2560" height="1792" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html" style="--d:2/2/7/13;--m:14/2/19/10;--dz:2;--mz:2"><div class="rte"><h1 class="ta-center">Book an Appointment</h1></div></div>
  <div class="b b-embed je" style="--d:2/4/12/11;--m:13/3/22/9;--dz:5;--mz:5"><div>
<!-- Start SimplePractice Appointment-Request Widget Embed Code -->
<style is:inline>
.spwidget-button-wrapper{text-align: center}
.spwidget-button{
    display: inline-block;
    padding: 12px 24px;
    color: #000 !important; /* Black text color */
    background: #fff; /* White button color */
    border: 0;
    border-radius: 50px; /* Rounded edges for a pill shape */
    font-family: Arial, Helvetica, sans-serif; /* Clean sans-serif font */
    font-size: 1rem; /* Match approximate size */
    font-weight: 400; /* Light font weight */
    text-transform: none; /* Ensure text case is preserved */
    text-decoration: none;
    letter-spacing: 0.5px; /* Add slight spacing for modern look */
}
.spwidget-button:hover{
    background: #f0f0f0; /* Slightly darker shade for hover */
}
.spwidget-button:active{
    color: rgba(0, 0, 0, .75) !important;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .15) inset;
}
</style>
<div class="spwidget-button-wrapper">
<a class="spwidget-button" data-spwidget-application-id="7c72cb9f9a9b913654bb89d6c7b4e71a77911b30192051da35384b4d0c6d505b" data-spwidget-autobind="" data-spwidget-scope-global="" data-spwidget-scope-id="db007d38-e4cc-4a0a-9e0c-5704b4664f65" data-spwidget-scope-uri="tangible" href="https://tangible.clientsecure.me">
        Request Appointment
    </a>
</div>
<script is:inline src="https://widget-cdn.simplepractice.com/assets/integration-1.0.js"></script>
<!-- End SimplePractice Appointment-Request Widget Embed Code -->
</div>
<style is:inline class="transform-overrides-vars">
</style></div>
  <div class="b b-shape jc" style="--d:9/4/13/11;--m:19/3/23/9;--dz:4;--mz:4"><div class="shape" style="background:var(--shape);border-radius:10px"></div></div>
  <div class="b b-html je" style="--d:14/2/17/13;--m:24/2/28/10;--dz:3;--mz:3"><div class="rte"><p class="ta-center">Booking your appointment is simple, and our team is ready to provide the attention, care, and expertise you deserve. Let’s get started, pick a time that works for you.</p></div></div>
</div>
</div>
</section>

<section class="sec t-black h-medium has-bg">
<div class="sec-bg"><img src="/images/imgg-demo-mdikhwvg-a7cfe7.jpg" alt="A tidy desk with a laptop, notebook and pen, ready to book a therapy appointment with Tangible Therapy" style="object-position:50% 50%" loading="eager"><div class="sec-ov" style="opacity:0.2"></div></div><div class="sec-in">
<div class="fe" style="--rows:19;--mrows:7">
  <div class="b b-html" style="--d:1/6/3/22;--m:1/2/3/10;--dz:3;--mz:3"><div class="rte"><h2 class="ta-center">Therapists with Current Openings</h2></div></div>
  <div class="b b-summary-v2" style="--d:3/4/18/24;--m:3/2/8/10;--dz:2;--mz:2"><Summary kind="team" design="carousel" category="telehealth/current-openings-1" limit={9} perRow={3} rounded /></div>
</div>
</div>
</section>

<section class="sec t-white-bold h-small">
<div class="sec-in" style="padding-top:3.3vmax;padding-bottom:3.3vmax">
<div class="wrap"><div class="list-title rte"><p>Services We Offer</p></div><ul class="ulist ulist-carousel circle" style="--per:4;--tfs:calc((1.2 - 1) * var(--fs-unit) + 1rem);--bfs:calc((0.9 - 1) * var(--fs-unit) + 1rem);--cw:75%;--gap:20px"><li class="li"><a class="li-link" href="/counseling" aria-label="Counseling"></a><div class="li-media"><img src="/images/adobestock-527575314-64329a.jpg" alt="Counseling" loading="lazy"></div><div class="li-body"><h3 class="li-title">Counseling</h3></div></li><li class="li"><div class="li-media"><img src="/images/tangible-14-f871cb.jpg" alt="Couples Counseling" loading="lazy"></div><div class="li-body"><h3 class="li-title">Couples Counseling</h3></div></li><li class="li"><div class="li-media"><img src="/images/tangible-16-73cf8a.jpg" alt="EMDR Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">EMDR Therapy</h3></div></li><li class="li"><div class="li-media"><img src="/images/tangible-287-29-88eea2.jpg" alt="Family Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Family Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Anxiety Therapy"></a><div class="li-media"><img src="/images/adobestock-647648501-8a13ba.jpg" alt="Anxiety Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Anxiety Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="OCD Therapy"></a><div class="li-media"><img src="/images/adobestock-325736337-283d0b.jpg" alt="OCD Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">OCD Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Depression Therapy"></a><div class="li-media"><img src="/images/tangible-9-dbc324.jpg" alt="Depression Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Depression Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Autism Affirming Therapy"></a><div class="li-media"><img src="/images/adobestock-335196196-f97108.jpg" alt="Autism Affirming Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Autism Affirming Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="ADHD Therapy"></a><div class="li-media"><img src="/images/tangible-7-b3e9aa.jpg" alt="ADHD Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">ADHD Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Faith Crisis &amp; Transitions"></a><div class="li-media"><img src="/images/tangible-17-8b7d18.jpg" alt="Faith Crisis &amp; Transitions" loading="lazy"></div><div class="li-body"><h3 class="li-title">Faith Crisis &amp; Transitions</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Grief Therapy"></a><div class="li-media"><img src="/images/adobestock-554795822-bd6a6e.jpeg" alt="Grief Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Grief Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Trauma Therapy"></a><div class="li-media"><img src="/images/adobestock-605164242-4dddd3.jpeg" alt="Trauma Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">Trauma Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="IFS Therapy"></a><div class="li-media"><img src="/images/adobestock-1562337152-8855fb.jpeg" alt="IFS Therapy" loading="lazy"></div><div class="li-body"><h3 class="li-title">IFS Therapy</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Therapy for Teens"></a><div class="li-media"><img src="/images/adobestock-1470216187-a63329.jpeg" alt="Therapy for Teens" loading="lazy"></div><div class="li-body"><h3 class="li-title">Therapy for Teens</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="Telehealth"></a><div class="li-media"><img src="/images/tangible-13-04af0d.jpg" alt="Telehealth" loading="lazy"></div><div class="li-body"><h3 class="li-title">Telehealth</h3></div></li><li class="li"><a class="li-link" href="/" aria-label="LGBTQ+ Affirming Care"></a><div class="li-media"><img src="/images/adobestock-565272603-9ef672.jpeg" alt="LGBTQ+ Affirming Care" loading="lazy"></div><div class="li-body"><h3 class="li-title">LGBTQ+ Affirming Care</h3></div></li></ul><div class="carousel-nav"><button class="prev" aria-label="Previous"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button class="next" aria-label="Next"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></div>
</div>
</section>
</Base>
