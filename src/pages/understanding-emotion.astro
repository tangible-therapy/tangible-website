---
import Base from '../layouts/Base.astro';
---
<Base title={"Understanding Emotion: Learn & Try | Tangible Therapy"} description={"Understanding Emotion: learn to notice and reflect on daily feelings — try 3x daily check-ins to build awareness. Visit Tangible Mental Health to get started."}>
<section class="sec t-white h-custom">
<div class="sec-in" style="padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);">
<div class="fe" style="--rows:21;--mrows:19">
  <div class="b b-image jc" style="--d:1/14/22/27;--m:6/2/16/10"><figure class="img fill" style="--fit:contain"><img src="/images/feelings-wheel-wip-230d23.jpg" alt="Colorful circular chart depicting various emotional states, categorized into sections such as Happy, Surprised, Bad, Fearful, Angry, Disgusted, and Feeble." width="1500" height="1475" loading="lazy" decoding="async"></figure></div>
  <div class="b b-html jc" style="--d:5/4/11/18;--m:1/2/6/10;--dz:2;--mz:2"><div class="rte"><div class="scaled"><span class="scaled-in"><h1>Understanding</h1></span></div><h2>Emotion</h2></div></div>
  <div class="b b-html je" style="--d:13/4/16/11;--m:14/2/20/10"><div class="rte"><p class="sm"><span class="c-accent">In order to understand it you have to feel it. Three times a day take time to reflect and to note how you feel. </span></p></div></div>
</div>
</div>
</section>

<section class="sec t-white h-medium">
<div class="sec-in">
<div class="fe" style="--rows:31;--mrows:20">
  <div class="b b-embed" style="--d:1/10/19/18;--m:2/2/21/10;--dz:5;--mz:5"><div>
<iframe frameborder="0" height="644" marginheight="0" marginwidth="0" src="https://docs.google.com/forms/d/e/1FAIpQLSfM-rohjdYw9STb6YIefnF_F805pjho02kW6pHJjXX6T2_lVQ/viewform?embedded=true" width="400">Loading…</iframe>
</div>
<style is:inline class="transform-overrides-vars">
</style></div>
</div>
</div>
</section>
</Base>
