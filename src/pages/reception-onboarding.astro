---
// Reception: onboarding new employees (front desk + directors).
// Oct 30 2026 redesign: each new hire gets a PROFILE (shared by everyone at the front desk, stored on the
// website via /api/new-hires → Netlify Blobs "new-hires", netlify/lib/hires.ts). The left side has the
// "New hire" box (Start a new hire: Drive folder + contract through SignWell) and the list of people being
// onboarded, each with a status (red: waiting for the employment contract; green: ready / in progress).
// Their profile shows the contract first; everything else stays hidden until the contract is signed —
// automatically when SignWell's signed PDF is saved into their folder (netlify/lib/signwell.ts), or with the
// two-click "Employee contract signed" override. Then a checklist (src/data/onboarding-steps.ts): one
// "Automatic setup" item with the two-click Finish setup button (email + groups + Employee Portal, payroll
// info, welcome email from frontdesk@), then the manual steps, each with "How?" instructions. "Onboarding
// complete" (two clicks) only works once every step for their role is ticked; the profile then moves to
// Completed. APIs: /api/new-hire-folder, /api/new-hire-contract, /api/new-hire-email, /api/new-hire-welcome.
// No logins or passwords on this page — point to the team password manager.
import Base from '../layouts/Base.astro';
import { OFFICES } from '../data/staff-access';
import { CONTRACT_SIGNER as SIGNER, CONTRACT_TYPES, LOCATION_DIRECTORS } from '../data/contracts';
import { WELCOME_TEMPLATE } from '../data/welcome-email';
import { HIRE_STEPS } from '../data/onboarding-steps';
const CONTRACT_SIGNER = SIGNER.name;

const DRIVE_EMPLOYEES = 'https://drive.google.com/drive/u/0/folders/1DCzPfLaGhpOIepDvmZ0krxgQl61bahwN';
const DRIVE_MANAGEMENT = 'https://drive.google.com/drive/folders/1Lmh1aH0YbyRgcfuunFafXil00kQi1zLI';
const ONBOARDING_SHEET = 'https://docs.google.com/spreadsheets/d/1i2OFTCSZUwcAvJD7pckJT0h9BPsUk2wvuAS0IjgjWZ8/edit?gid=0#gid=0';
const THERAPIST_SHEET = 'https://docs.google.com/spreadsheets/d/1QIrJbIzoNtenFfOqAGBJzyx3nYSPVkLqOu7ECwLx-Kw/edit';
const SLACK = 'https://tangibletherapy.slack.com';
const SIMPLEPRACTICE = 'https://secure.simplepractice.com/calendar/appointments';
const ext = 'target="_blank" rel="noopener"';
const a = (href: string, text: string) => `<a href="${href}" ${ext}>${text}</a>`;

const offices = OFFICES.map((o) => ({ id: o.id, label: o.label, director: o.director, email: o.directorEmail, directorFull: LOCATION_DIRECTORS[o.id]?.name || o.director }));
const contractTypes = CONTRACT_TYPES as Record<string, string>;

// "How?" instructions, shown under each step in a profile. <span data-f="..."> is filled in per person:
// full, first, email, personal, office, director, directorName, supervisorName, staffline.
const HOW: Record<string, string> = {
  folder: `<p>Their folder is made automatically by <b>Start a new hire</b>, inside the shared ${a(DRIVE_EMPLOYEES, 'Employee folder')}. If that didn’t work, make it by hand:</p><ol>
    <li>Open the ${a(DRIVE_EMPLOYEES, 'Employee folder')} in Google Drive.</li>
    <li>Click <b>New</b> → <b>New folder</b> and name it <span class="ob-chip" data-f="full">First Last</span>.</li></ol>`,
  contract: `<p><b>Start a new hire</b> fills in the right contract with their name, start date and pay, and sends it through SignWell in this order: their location director (<span data-f="directorName">the office director</span>), then <b>${CONTRACT_SIGNER}</b> (COO), then the new hire at their personal email. When everyone has signed, the signed copy is saved into their folder and this profile turns green by itself.</p>
    <p class="pt-muted">To do it by hand:</p><ol>
    <li>Open the ${a(DRIVE_MANAGEMENT, 'Management folder')}, right-click the right employment contract → <b>Make a copy</b>.</li>
    <li>Fill in the copy (name, pay, employment status), then <b>File</b> → <b>Download</b> → <b>PDF</b>.</li>
    <li>Send it to their location director, then ${CONTRACT_SIGNER} (COO), then the new employee to sign.</li>
    <li>Save the signed copy in their folder, then click <b>Employee contract signed</b> here.</li></ol>`,
  setup: `<p><b>Finish setup</b> does all of this in one go. If something didn’t work, here’s how to do that part by hand.</p>
    <h4>Tangible email and groups</h4><ol>
    <li>Open the ${a('https://admin.google.com/ac/users', 'Google Admin console')} → <b>Users</b> → <b>Add new user</b>.</li>
    <li>Use their first name for the address: <span class="ob-chip" data-f="email">first@tangiblementalhealth.com</span> (first name + last initial if it’s taken). Put their personal email as the secondary email, then <b>Add new user</b>.</li>
    <li><b>Directory</b> → <b>Groups</b> → add them to the groups for their office (<span data-f="office">their office</span>).</li></ol>
    <h4>Employee Portal access</h4>
    <p>Ask <span data-f="director">the office director</span> to add them in ${a('/staff-admin', 'Staff Admin')} and leave <b>Already completed orientation</b> unticked: <span class="ob-chip" data-f="staffline">Name, email, role, office</span> <button type="button" class="ob-mini" data-copy="staffline">Copy</button></p>
    <p class="ob-tip">Until Google sign-in is switched on for the live site, also send them the staff password from the team password manager.</p>
    <h4>Welcome email</h4>
    <div class="ob-mail"><p class="ob-mail-meta"><b>To:</b> <span data-f="emailOrPersonal">their email</span><br><b>Subject:</b> Welcome to Tangible!</p><pre class="ob-mail-body" data-f="welcomeBody"></pre></div>
    <div class="ob-actions"><a class="pt-btn ghost" data-mail="welcome" href="#" ${ext}>Open in Gmail</a><button type="button" class="pt-btn ghost" data-copy="welcomeBody">Copy text</button></div>
    <h4>Payroll info</h4>
    <p>Their pay and start date are saved on their Drive folder so the payroll email to Chelsea can go out by itself once their paperwork comes in (see “Paperwork filed and payroll emailed”).</p>`,
  slack: `<p>Nothing to do: anyone with a Tangible email can join ${a(SLACK, 'Tangible’s Slack')} on their own, and their Employee Portal checklist walks them through it. Tick this once they’ve joined.</p>
    <p class="pt-muted">If they can’t get in: open Slack, click <b>Tangible Therapy</b> (top left) → <b>Invite people</b>, and enter <span data-f="email">their Tangible email</span>.</p>`,
  simple: `<ol>
    <li>Open ${a(SIMPLEPRACTICE, 'SimplePractice')} → <b>Settings</b> → <b>Team</b> → <b>Team members</b> → <b>Add new team member</b>.</li>
    <li>Enter their legal name and <span data-f="email">Tangible email</span> → <b>Continue</b>.</li>
    <li>Choose <b>Clinician</b> and <b>Full client list</b> → <b>Continue</b>, turn on all permissions → <b>Continue</b>.</li>
    <li>If they need supervision, pick their supervisor. Specialty: <b>Counselor</b>. Send the invitation.</li></ol>`,
  paperwork: `<p>This happens by itself once they fill out the onboarding form from their Employee Portal checklist:</p><ol>
    <li>Their uploads are moved into their ${a(DRIVE_EMPLOYEES, 'Drive folder')} with their legal name (“<span data-f="full">Name</span> - W-4” and so on), and frontdesk@ gets <b>“Onboarding files filed: <span data-f="full">Name</span>”</b>.</li>
    <li>Within about 10 minutes, Chelsea (nsbcpayroll@gmail.com) gets the payroll email from frontdesk@ with the W-4 and direct deposit form attached, and the filing email gets the Gmail label <b>Payroll sent</b>.</li></ol>
    <p>Tick this once you see “New employee: <span data-f="full">Name</span>” in frontdesk@’s <b>Sent</b> folder with both attachments.</p>
    <h4>If it didn’t work</h4><ul>
    <li><b>“Payroll email waiting”</b>: it says what’s missing. Fix the pay or start date in this profile’s details, or save the missing file in their folder named like the others. It then sends within 10 minutes.</li>
    <li><b>“NOT filed”</b> or no filing email after 15 minutes: move the files into their folder by hand from the ${a(ONBOARDING_SHEET, 'Onboarding responses')} sheet, send payroll by hand (below) and tell Brady.</li></ul>
    <div class="ob-actions"><a class="pt-btn ghost" data-mail="payroll" href="#" ${ext}>Send payroll email by hand</a></div>
    <p class="ob-tip">Gmail can’t attach the files for you: add the W-4 and direct deposit form before sending, and check Sent first so it doesn’t go twice.</p>`,
  malpractice: `<ol>
    <li>Open the ${a('https://www.insure-portal.com/User/', 'malpractice insurance portal')} and sign in (the login is in the team password manager).</li>
    <li><b>Make changes to my policy</b> → <b>Add something</b> → <b>Add an employee</b>, add them and <b>Save</b>.</li></ol>`,
  hours: `<ol>
    <li>Make sure they have the <b>Associate (pre-licensed)</b> role.</li>
    <li>Ask their clinical supervisor to open the ${a('/hours', 'Supervision Hours')} → <b>My supervisees</b> → add them and set their license track, start date and hour targets.</li></ol>`,
  availibility: `<ol>
    <li>Open ${a(SIMPLEPRACTICE, 'SimplePractice')}, go to their calendar → gear icon → <b>View availability schedule</b>.</li>
    <li>Click a time, title it <b>Opening</b> (their schedule is in the ${a(ONBOARDING_SHEET, 'Onboarding responses')} sheet), set it to repeat, pick the location and tick <b>Telehealth</b>.</li>
    <li>Make sure the services match the screenshot, then <b>Save</b>. Add each time window separately.</li></ol>
    <img class="ob-shot" src="/images/screenshot-2025-11-24-at-3-57-40-pm-b0f670.png" alt="SimplePractice availability window showing the services to offer" width="858" height="570" loading="lazy" decoding="async">`,
  'booking-id': `<ol>
    <li>In SimplePractice go to <b>Settings</b> → <b>Widgets</b> → <b>Appointment request</b>.</li>
    <li>Preview their row and copy the <b>clinicianId</b> number into the <b>SimplePractice clinician ID</b> column of their row in the website profiles tab.</li></ol>`,
  website: `<p>No code needed. The website reads the ${a(THERAPIST_SHEET, 'tangible sheets')} Google Sheet.</p><ol>
    <li>In <b>website profiles</b>, add a row: Name, Credential, Photo (Drive link to their headshot), Bio, SimplePractice clinician ID, Online booking and Show on website.</li>
    <li>Add them to the <b>openings</b>, <b>modalities</b> and <b>Insurances</b> tabs, spelling their name the same.</li>
    <li>It goes live about 15 minutes after the last edit, once the photo link works. The <b>Website status</b> column says what’s missing.</li></ol>`,
  'psychology-today': `<p class="pt-muted">Step-by-step instructions haven’t been written yet.</p>`,
};
const steps = HIRE_STEPS.map((s) => ({ id: s.id, title: s.title, who: s.who || '', auto: !!s.auto }));
---
<Base title={"Onboarding New Employees | Tangible Therapy"} description={""} noindex>
<div class="pt-page ob">
  <div class="pt-head">
    <div>
      <p class="pt-eyebrow">Reception</p>
      <h1>Onboarding new employees</h1>
    </div>
    <p class="pt-muted ob-count" aria-live="polite" id="ob-count"></p>
  </div>

  <div class="ob-home" id="ob-home">
      <nav class="pt-card ob-people" aria-label="People being onboarded">
        <h2>Being onboarded</h2>
        <ul class="ob-list" id="ob-list"></ul>
        <p class="pt-muted ob-empty" id="ob-list-empty" hidden>Nobody yet. Add a new hire with the form.</p>
        <details class="ob-done-list" id="ob-done-wrap" hidden>
          <summary>Completed (<span id="ob-done-n">0</span>)</summary>
          <ul id="ob-done-ul"></ul>
        </details>
      </nav>
      <section class="pt-card ob-hire" aria-label="Add a new hire">
        <h2>New hire</h2>
        <p class="pt-muted">Fill these in and click <b>Start a new hire</b>. It makes their profile, their Google Drive folder and sends their contract for signing.</p>
        <div class="ob-fields">
          <label class="pt-field">First name<input id="f-first" autocomplete="off"></label>
          <label class="pt-field">Last name<input id="f-last" autocomplete="off"></label>
          <label class="pt-field ob-wide">Personal email<input id="f-personal" type="email" autocomplete="off" placeholder="Their contract is sent here"></label>
          <label class="pt-field">Office<select id="f-office">{offices.map((o) => <option value={o.id}>{o.label}</option>)}</select></label>
          <label class="pt-field">Role<select id="f-role">
            <option value="therapist">Therapist (licensed)</option>
            <option value="associate">Associate (pre-licensed)</option>
            <option value="frontdesk">Admin / front desk</option>
            <option value="billing">Billing</option>
            <option value="other">Other</option>
          </select></label>
          <label class="pt-field ob-wide ob-chk"><input type="checkbox" id="f-alsosup"> Also a clinical supervisor</label>
          <label class="pt-field ob-wide" id="f-supervisor-wrap">Their supervisor<select id="f-supervisor"><option value="">Choose later</option></select></label>
          <label class="pt-field">Start date<input id="f-start" type="date"></label>
          <label class="pt-field">Pay per billable hr ($)<input id="f-pay" inputmode="decimal" autocomplete="off" placeholder="e.g. 60"></label>
          <label class="pt-field ob-wide">Contract to send<select id="f-contract">
            {Object.entries(contractTypes).map(([k, v]) => <option value={k}>{v}</option>)}
            <option value="none">Don’t send a contract (I’ll do it by hand)</option>
          </select></label>
        </div>
        <button type="button" class="pt-btn ob-start" id="ob-start">Start a new hire</button>
        <p class="ob-status" id="ob-status" role="status" aria-live="polite"></p>
      </section>
  </div>

  <div class="ob-view" id="ob-view" hidden>
    <a class="ob-back" href="/reception-onboarding">← All new hires</a>
    <main class="ob-main" id="ob-profile" aria-live="polite">
      <div class="pt-card ob-placeholder"><p class="pt-muted">Loading…</p></div>
    </main>
  </div>

</div>

<style is:global>
  .ob h2 { font-size: 1.15rem; font-weight: 600; margin: 0 0 .3rem; }
  .ob h4 { font-size: .92rem; font-weight: 600; margin: 1rem 0 .3rem; }
  .ob .ob-home { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 1.5rem; align-items: start; }
  .ob .ob-view { max-width: 860px; }
  .ob .ob-back { display: inline-block; font-size: .9rem; font-weight: 600; color: var(--charcoal); text-decoration: none; margin: 0 0 .8rem; }
  .ob .ob-back:hover { text-decoration: underline; }
  .ob .ob-fields { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .6rem; margin: .9rem 0; }
  .ob .ob-wide { grid-column: 1 / -1; }
  .ob .ob-chk { flex-direction: row !important; align-items: center; gap: .45rem; font-size: .88rem; }
  .ob .ob-chk input { width: auto !important; min-height: 0 !important; }
  .ob [hidden] { display: none !important; }
  .ob .ob-fields input, .ob .ob-fields select { font: inherit; font-size: .9rem; color: var(--charcoal); border: 1px solid #c9cfca; border-radius: 10px; padding: .45rem .6rem; background: #fff; min-width: 0; width: 100%; box-sizing: border-box; min-height: 38px; }
  .ob .ob-fields input:disabled { background: #f3f4f3; color: #5d635e; }
  .ob .ob-start { width: 100%; }
  .ob .pt-btn[aria-busy=true] { opacity: .6; cursor: progress; }
  .ob .pt-btn:disabled { opacity: .5; cursor: not-allowed; }
  .ob .ob-status { font-size: .85rem; margin: .6rem 0 0; }
  .ob .ob-status:empty { display: none; }
  .ob .ob-status.err, .ob .ob-err { color: #8a2f1c; }

  /* people list */
  .ob .ob-list { list-style: none; margin: .6rem 0 0; padding: 0; border-top: 1px solid #e6e9e6; }
  .ob .ob-list li { border-bottom: 1px solid #e6e9e6; }
  .ob .ob-person { display: flex; align-items: center; justify-content: space-between; gap: .8rem; padding: .7rem .3rem; color: var(--charcoal); text-decoration: none; flex-wrap: wrap; }
  .ob .ob-person:hover { background: #f6f8f6; }
  .ob .ob-person b { font-size: 1rem; font-weight: 600; }
  .ob .ob-person .ob-pill { margin-left: auto; }
  .ob .ob-person::after { content: '›'; font-size: 1.3rem; color: #9aa09b; line-height: 1; }
  .ob .ob-empty { font-size: .88rem; margin: .4rem 0 0; }
  .ob .ob-done-list { margin-top: .8rem; font-size: .85rem; }
  .ob .ob-done-list summary { cursor: pointer; color: #5d635e; }
  .ob .ob-done-list ul { margin: .4rem 0 0; padding-left: 1.1rem; color: #5d635e; }

  /* status pill */
  .ob .ob-pill { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; font-size: .74rem; font-weight: 600; border-radius: 300px; padding: .15rem .6rem .15rem .5rem; line-height: 1.4; }
  .ob .ob-pill::before { content: ''; width: .5rem; height: .5rem; border-radius: 50%; background: currentColor; }
  .ob .ob-pill.red { background: #fbe4dd; color: #a3361b; }
  .ob .ob-pill.green { background: #e1efe4; color: #2f6b3f; }
  .ob .ob-pill.blue { background: #e3ecf3; color: #2e5873; }
  .ob .ob-pill.amber { background: #fbf0d9; color: #8a5a10; }
  .ob .ob-paystate { margin: .45rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .5rem; }
  .ob .ob-paydetail { font-size: .85rem; color: #4a4f4b; }

  /* profile */
  .ob .ob-main { min-width: 0; }
  .ob .ob-placeholder { text-align: center; padding: 3rem 1rem; }
  .ob .ob-profile-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .ob .ob-profile-head h2 { font-size: 1.5rem; margin: 0 0 .35rem; }
  .ob .ob-meta { font-size: .88rem; color: #5d635e; margin: .4rem 0 0; }
  .ob .ob-section { margin-top: 1.2rem; }
  .ob .ob-section > h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 .5rem; }
  .ob .ob-box { font-size: .9rem; border-radius: 12px; padding: .7rem .85rem; margin: .5rem 0 0; line-height: 1.5; background: #f6f4ec; color: #4a4630; }
  .ob .ob-box.ok { background: #e8f1ea; color: #23432c; }
  .ob .ob-box.bad { background: #fbe9e4; color: #6b2a17; }
  .ob .ob-box a { color: inherit; font-weight: 600; }
  .ob .ob-row { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: .7rem; align-items: center; }
  .ob .pt-btn.armed { background: #8a3b1f !important; border-color: #8a3b1f !important; color: #fff !important; }
  .ob .ob-locked { margin-top: 1.2rem; border: 1.5px dashed #d6dad6; border-radius: 14px; padding: 1rem 1.1rem; color: #5d635e; font-size: .9rem; line-height: 1.55; }
  .ob .ob-details summary, .ob .ob-how summary { cursor: pointer; font-size: .85rem; color: #4a5a4e; font-weight: 600; }
  .ob .ob-details { margin-top: .8rem; }
  .ob .ob-details .ob-fields { margin-bottom: 0; }

  .ob .ob-bar { height: 6px; border-radius: 6px; background: #e6e9e6; overflow: hidden; margin: .3rem 0 .8rem; }
  .ob .ob-bar i { display: block; height: 100%; background: var(--slate); transition: width .3s; }
  .ob .ob-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .ob .ob-item { border: 1px solid #e0e4e0; border-radius: 12px; padding: .65rem .8rem; background: #fff; }
  .ob .ob-item.auto { border: 1.5px solid #c9d8cc; background: #f4f8f5; }
  .ob .ob-item.done { background: #f7f9f7; }
  .ob .ob-tick { display: flex; align-items: flex-start; gap: .65rem; cursor: pointer; font-weight: 600; font-size: .95rem; line-height: 1.35; }
  .ob .ob-tick input { flex: none; width: 1.15rem; height: 1.15rem; margin: .1rem 0 0; accent-color: var(--slate); cursor: pointer; }
  .ob .ob-item.done .ob-tick span { color: #6b716c; text-decoration: line-through; }
  .ob .ob-item-body { padding-left: 1.8rem; font-size: .9rem; line-height: 1.55; }
  .ob .ob-item-body > p { margin: .4rem 0 0; }
  .ob .ob-how { margin-top: .35rem; }
  .ob .ob-how-body { margin-top: .4rem; }
  .ob .ob-how-body ol, .ob .ob-how-body ul { margin: .4rem 0 0; padding-left: 1.2rem; }
  .ob .ob-how-body li { margin: .2rem 0; }
  .ob .ob-how-body p { margin: .5rem 0 0; }
  .ob .ob-results { list-style: none; margin: .6rem 0 0; padding: 0; font-size: .86rem; line-height: 1.45; }
  .ob .ob-results li { padding: .25rem 0 .25rem 1.4rem; position: relative; }
  .ob .ob-results li::before { position: absolute; left: 0; font-weight: 700; }
  .ob .ob-results li.ok::before { content: '✓'; color: #2f6b3f; }
  .ob .ob-results li.bad::before { content: '!'; color: #a3361b; }
  .ob .ob-results li.bad { color: #6b2a17; }
  .ob .ob-complete { margin-top: 1.2rem; border-top: 1px solid #e6e9e6; padding-top: 1rem; }
  .ob .ob-complete .pt-btn { width: 100%; }
  .ob .ob-link { font: inherit; font-size: .8rem; color: #8a2f1c; background: none; border: 0; text-decoration: underline; cursor: pointer; padding: .2rem; }
  .ob .ob-link.armed { font-weight: 700; }
  .ob .ob-small { font-size: .8rem; margin: .4rem 0 0; }

  .ob .ob-chip { display: inline-block; background: #f1f3f1; border-radius: 6px; padding: 0 .4rem; font-weight: 500; word-break: break-all; }
  .ob .ob-mini { font: inherit; font-size: .75rem; border: 1px solid #c9cfca; background: #fff; border-radius: 300px; padding: .05rem .6rem; cursor: pointer; margin-left: .2rem; }
  .ob .ob-tip { font-size: .85rem; background: #f6f4ec; border-radius: 10px; padding: .5rem .75rem; }
  .ob .ob-mail { border: 1px solid #e0e4e0; border-radius: 12px; margin-top: .7rem; overflow: hidden; background: #fff; }
  .ob .ob-mail-meta { background: #f6f7f6; margin: 0 !important; padding: .6rem .9rem; font-size: .85rem; }
  .ob .ob-mail-body { margin: 0; padding: .8rem .9rem; font: inherit; font-size: .86rem; white-space: pre-wrap; max-height: 280px; overflow: auto; }
  .ob .ob-actions { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .7rem; }
  .ob .ob-actions a.pt-btn { text-decoration: none; display: inline-flex; align-items: center; }
  .ob .ob-shot { display: block; max-width: 100%; height: auto; border-radius: 12px; margin-top: .8rem; border: 1px solid #e0e4e0; }

  @media (max-width: 900px) {
    .ob .ob-home { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .ob .ob-fields { grid-template-columns: 1fr; }
    .ob .ob-item-body { padding-left: 0; }
  }
</style>

<script is:inline define:vars={{ offices, signer: SIGNER.name, welcomeTpl: WELCOME_TEMPLATE, steps, HOW }}>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var hires = [], completed = [], sel = null, supervisors = [], loaded = false, payrollTracking = false;
    var msgs = {};       // per-hire notes from the last action (not saved)
    var busy = {};       // per-hire: an action is running
    var checkedAt = {};  // per-hire: last time the contract status was checked
    // Main page: list + New hire box. ?hire=<id>: that person's own page. &start=1: just added, finish
    // making their folder and sending their contract.
    var params = new URLSearchParams(location.search), viewId = params.get('hire'), starting = params.get('start') === '1';
    sel = viewId;
    $('ob-home').hidden = !!viewId; $('ob-view').hidden = !viewId;
    function pageFor(id) { return '/reception-onboarding?hire=' + encodeURIComponent(id); }

    var ROLE_LABEL = { therapist: 'Therapist', associate: 'Associate', frontdesk: 'Front desk', billing: 'Billing', other: 'Other' };
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function api(url, body) {
      return fetch(url, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify(body) } : { credentials: 'same-origin' })
        .then(function (r) { return r.json().catch(function () { return { error: 'The website didn’t answer (status ' + r.status + ').' }; }); })
        .then(function (res) { if (!res || res.error) throw new Error((res && res.error) || 'Something went wrong.'); return res; });
    }
    function office(h) { for (var i = 0; i < offices.length; i++) if (offices[i].id === h.office) return offices[i]; return offices[0]; }
    function isClin(h) { return h.role === 'therapist' || h.role === 'associate'; }
    function stepsFor(h) { return steps.filter(function (s) { return !s.who || (s.who === 'clinician' ? isClin(h) : h.role === 'associate'); }); }
    function fmtDate(d) { if (!d) return ''; var p = d.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }); }
    function full(h) { return (h.first + ' ' + h.last).trim(); }
    function suggested(h) { var f = String(h.first || '').toLowerCase().replace(/[^a-z]/g, ''); return f ? f + '@tangiblementalhealth.com' : ''; }
    function tangible(h) { return (h.account && h.account.email) || h.email || suggested(h); }
    function payRate(h) { var v = String(h.pay || '').replace(/[$,\s]/g, ''); return /^\d+(\.\d+)?$/.test(v) ? '$' + v + ' per billable hour' : String(h.pay || ''); }
    function portalRoles(h) { var r = h.role !== 'other' ? [h.role] : []; if (h.alsosup) r.push('supervisor'); return r; }
    function supName(h) { for (var i = 0; i < supervisors.length; i++) if (supervisors[i].email === h.supervisor) return supervisors[i].name; return ''; }
    function cDone(c) { return !!c && /complete/i.test(c.status || ''); }
    function cDead(c) { return !!c && /declin|expire|cancel/i.test(c.status || ''); }
    function cur() { for (var i = 0; i < hires.length; i++) if (hires[i].id === sel) return hires[i]; return null; }
    function put(h) { var f = false; hires = hires.map(function (x) { if (x.id === h.id) { f = true; return h; } return x; }); if (!f) hires.push(h); }
    function anyArmed() { return !!document.querySelector('.ob .armed'); }

    // ---- status shown next to each name ----
    function status(h) {
      if (!h.contractSigned) {
        if (cDead(h.contract)) return { cls: 'red', text: 'Contract ' + String(h.contract.status).toLowerCase() };
        return { cls: 'red', text: 'Waiting for employment contract' };
      }
      var list = stepsFor(h), n = list.filter(function (s) { return h.done[s.id]; }).length;
      if (n === list.length) return { cls: 'blue', text: 'Ready to complete' };
      if (!n) return { cls: 'green', text: 'Ready for next steps' };
      return { cls: 'green', text: 'In progress · ' + n + ' of ' + list.length };
    }

    // ---- left: people list ----
    function renderList() {
      var ul = $('ob-list'); ul.textContent = '';
      hires.forEach(function (h) {
        var st = status(h), li = document.createElement('li');
        li.innerHTML = '<a class="ob-person" href="' + pageFor(h.id) + '"><b>' + esc(full(h)) + '</b><span class="ob-pill ' + st.cls + '">' + esc(st.text) + '</span></a>';
        ul.appendChild(li);
      });
      $('ob-list-empty').hidden = !!hires.length || !loaded;
      $('ob-done-wrap').hidden = !completed.length;
      $('ob-done-n').textContent = completed.length;
      var dl = $('ob-done-ul'); dl.textContent = '';
      completed.forEach(function (c) { var li = document.createElement('li'); li.textContent = c.name + (c.completedAt ? ' · ' + new Date(c.completedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : ''); dl.appendChild(li); });
      $('ob-count').textContent = loaded && !viewId ? hires.length + (hires.length === 1 ? ' person' : ' people') + ' being onboarded' : '';
    }

    // ---- per-person text used in instructions and emails ----
    function fills(h) {
      var o = office(h);
      var welcome = welcomeTpl.replace('{{first}}', h.first || '[first name]').replace('{{email}}', tangible(h) || '[Tangible email]').split('{{director}}').join(o.director).replace('{{directorEmail}}', o.email);
      var payroll = 'Hey Chelsea,\n\nPlease add our new employee to payroll:\n\nName: ' + full(h) + '\nPay rate: ' + (payRate(h) || '[pay rate]') + '\nStart date: ' + (fmtDate(h.start) || '[start date]') + '\n\nTheir W-4 and direct deposit form are attached.\n\nThank you!';
      return {
        full: full(h), first: h.first, email: tangible(h), personal: h.personal, office: o.label,
        director: o.director + ' (' + o.email + ')', directorName: o.directorFull,
        supervisorName: supName(h) || 'not chosen yet',
        staffline: [full(h), tangible(h), portalRoles(h).join('+') || 'role', o.id].join(', ') + (supName(h) ? ' · supervisor: ' + supName(h) : ''),
        emailOrPersonal: [tangible(h), h.personal].filter(Boolean).join(', '),
        welcomeBody: welcome, payrollBody: payroll,
      };
    }
    function gmail(to, su, body) { return 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(to) + '&su=' + encodeURIComponent(su) + '&body=' + encodeURIComponent(body); }
    function how(id, label) {
      if (!HOW[id]) return '';
      return '<details class="ob-how" data-how="' + id + '"><summary>' + (label || 'How?') + '</summary><div class="ob-how-body">' + HOW[id] + '</div></details>';
    }
    function applyFills(root, h) {
      var d = fills(h);
      root.querySelectorAll('[data-f]').forEach(function (n) { if (d[n.dataset.f] != null) n.textContent = d[n.dataset.f]; });
      root.querySelectorAll('[data-mail=welcome]').forEach(function (n) { n.href = gmail([tangible(h), h.personal].filter(Boolean).join(','), 'Welcome to Tangible!', d.welcomeBody); });
      root.querySelectorAll('[data-mail=payroll]').forEach(function (n) { n.href = gmail('nsbcpayroll@gmail.com', 'New employee: ' + full(h), d.payrollBody); });
    }

    // ---- right: the selected person's profile ----
    function field(label, input, wide) { return '<label class="pt-field' + (wide ? ' ob-wide' : '') + '">' + label + input + '</label>'; }
    function detailsForm(h) {
      var opt = function (v, t, cur) { return '<option value="' + esc(v) + '"' + (v === cur ? ' selected' : '') + '>' + esc(t) + '</option>'; };
      var sup = '<option value="">Choose later</option>' + supervisors.map(function (s) { return opt(s.email, s.name, h.supervisor); }).join('');
      return '<details class="ob-details"><summary>Their details</summary><div class="ob-fields">' +
        field('First name', '<input data-field="first" value="' + esc(h.first) + '" autocomplete="off">') +
        field('Last name', '<input data-field="last" value="' + esc(h.last) + '" autocomplete="off">') +
        field('Personal email', '<input data-field="personal" type="email" value="' + esc(h.personal) + '" autocomplete="off">', true) +
        field('Tangible email', '<input data-field="email" type="email" value="' + esc((h.account && h.account.email) || h.email) + '" placeholder="' + esc(suggested(h) || 'Suggested from first name') + '" autocomplete="off"' + (h.account ? ' disabled' : '') + '>', true) +
        field('Office', '<select data-field="office">' + offices.map(function (o) { return opt(o.id, o.label, h.office); }).join('') + '</select>') +
        field('Role', '<select data-field="role">' + [['therapist', 'Therapist (licensed)'], ['associate', 'Associate (pre-licensed)'], ['frontdesk', 'Admin / front desk'], ['billing', 'Billing'], ['other', 'Other']].map(function (r) { return opt(r[0], r[1], h.role); }).join('') + '</select>') +
        '<label class="pt-field ob-wide ob-chk"><input type="checkbox" data-field="alsosup"' + (h.alsosup ? ' checked' : '') + '> Also a clinical supervisor</label>' +
        (isClin(h) ? field('Their supervisor', '<select data-field="supervisor">' + sup + '</select>', true) : '') +
        field('Start date', '<input data-field="start" type="date" value="' + esc(h.start) + '">') +
        field('Pay per billable hr ($)', '<input data-field="pay" inputmode="decimal" value="' + esc(h.pay) + '" autocomplete="off">') +
        '</div><p class="pt-muted ob-small">Changes save by themselves. Pay and start date are also re-saved on their folder for the payroll email.</p></details>';
    }
    function contractSection(h) {
      var c = h.contract, out = '<section class="ob-section"><h3>Employment contract</h3>';
      if (h.folder && h.folder.url) out += '<div class="ob-box ok">Drive folder: <a href="' + esc(h.folder.url) + '" target="_blank" rel="noopener">' + esc(h.folder.name) + '</a></div>';
      else if (busy[h.id] !== 'start') out += '<div class="ob-box bad">No Drive folder yet. <button type="button" class="ob-mini" data-act="folder">Create it</button></div>';
      if (h.contractSigned) {
        out += '<div class="ob-box ok"><b>Signed.</b> ' + (h.contractSignedBy === 'manual' ? 'Marked signed by hand' : 'Signed by everyone and saved to their folder') +
          (h.contractSignedAt ? ' on ' + new Date(h.contractSignedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '') + '.' +
          (c && c.signedUrl ? ' <a href="' + esc(c.signedUrl) + '" target="_blank" rel="noopener">Open the signed contract</a>' : '') + (c && c.test ? ' (test mode, not binding)' : '') + '</div>';
      } else if (c) {
        var test = c.test ? ' (test mode, not binding)' : '';
        if (cDead(c)) out += '<div class="ob-box bad">The contract was ' + esc(String(c.status).toLowerCase()) + '.' + test + ' <button type="button" class="ob-mini" data-act="resend">Send a new contract</button></div>';
        else if (cDone(c)) out += '<div class="ob-box">Signed by everyone' + test + '. Saving it to their folder… <button type="button" class="ob-mini" data-act="recheck">Check again</button></div>';
        else {
          var next = (c.recipients || []).filter(function (r) { return !r.signed; })[0];
          out += '<div class="ob-box">Contract sent' + test + '. Waiting for <b>' + esc(next ? next.name : signer) + '</b> to sign. <button type="button" class="ob-mini" data-act="recheck"' + (busy[h.id] === 'recheck' ? ' disabled' : '') + '>' + (busy[h.id] === 'recheck' ? 'Checking…' : 'Check again') + '</button></div>';
        }
      } else if (busy[h.id] === 'start') {
        out += '<div class="ob-box">Setting up…</div>';
      } else if (h.contractType && h.contractType !== 'none') {
        out += '<div class="ob-box bad">The contract hasn’t been sent. <button type="button" class="ob-mini" data-act="send">Send their contract</button></div>';
      } else {
        out += '<div class="ob-box">You chose to send the contract by hand. When it’s signed and saved in their folder, click <b>Employee contract signed</b> below.</div>';
      }
      if (!h.contractSigned) out += '<div class="ob-row"><button type="button" class="pt-btn ghost" data-act="signed" data-two="Employee contract signed">Employee contract signed</button><span class="pt-muted ob-small" style="margin:0">Only if the automatic check didn’t catch it. Two clicks.</span></div>';
      out += how('contract', 'How the contract works / doing it by hand') + (h.folder ? '' : how('folder', 'Making the folder by hand'));
      return out + '</section>';
    }
    // Paperwork step: what frontdesk@'s Payroll email script reported for this person.
    function payrollLine(h) {
      var p = h.payrollStatus, when = function (t) { return t ? ' on ' + new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : ''; };
      var cls, text;
      if (p && p.state === 'sent') { cls = 'green'; text = 'Payroll email sent' + when(p.at); }
      else if (p && p.state === 'failed') { cls = 'red'; text = 'Email failed'; }
      else if (p && p.state === 'waiting') { cls = 'amber'; text = 'Payroll email waiting'; }
      else { cls = 'amber'; text = 'Waiting for their paperwork'; }
      var detail = p && p.state !== 'sent' ? p.detail : (!p ? (payrollTracking ? 'They haven’t sent their onboarding form yet. This updates by itself.' : 'Automatic status isn’t connected yet (Front desk mailer), so check frontdesk@’s Sent folder and tick this by hand.') : '');
      return '<p class="ob-paystate"><span class="ob-pill ' + cls + '">' + text + '</span>' + (detail ? ' <span class="ob-paydetail">' + esc(detail) + '</span>' : '') + '</p>';
    }
    function checklist(h) {
      var list = stepsFor(h), n = list.filter(function (s) { return h.done[s.id]; }).length;
      var out = '<section class="ob-section"><h3>Onboarding checklist</h3>' +
        '<p class="pt-muted ob-small" style="margin:0">' + n + ' of ' + list.length + ' done</p><div class="ob-bar"><i style="width:' + Math.round(n / list.length * 100) + '%"></i></div><ul class="ob-checks">';
      list.forEach(function (s) {
        var d = h.done[s.id];
        out += '<li class="ob-item' + (s.auto ? ' auto' : '') + (d ? ' done' : '') + '"><label class="ob-tick"><input type="checkbox" data-step="' + s.id + '"' + (d ? ' checked' : '') + '><span>' + esc(s.title) + '</span></label><div class="ob-item-body">';
        if (s.auto) {
          var allOk = h.account && h.welcome && h.folder && h.folder.payroll && h.folder.payroll.payRate && h.folder.payroll.startDate;
          if (!allOk) out += '<p>One button, two clicks: creates their Tangible email and adds their groups, gives them Employee Portal access, saves their pay and start date for the automatic payroll email, and emails them the welcome email from frontdesk@.</p>' +
            '<div class="ob-row"><button type="button" class="pt-btn" data-act="finish" data-two="' + (h.finish && h.finish.length ? 'Try again' : 'Finish setup') + '"' + (busy[h.id] === 'finish' ? ' disabled aria-busy="true"' : '') + '>' + (busy[h.id] === 'finish' ? 'Working…' : (h.finish && h.finish.length ? 'Try again' : 'Finish setup')) + '</button></div>';
          if (h.finish && h.finish.length) out += '<ul class="ob-results">' + h.finish.map(function (r) { return '<li class="' + (r.ok ? 'ok' : 'bad') + '">' + esc(r.text) + '</li>'; }).join('') + '</ul>';
          out += how('setup', 'Doing it by hand');
        } else {
          if (s.id === 'paperwork') out += payrollLine(h);
          out += how(s.id);
        }
        if (d && d.by === 'automatic') out += '<p class="pt-muted ob-small">Ticked automatically</p>';
        else if (d && d.by && d.by !== 'front desk') out += '<p class="pt-muted ob-small">Ticked by ' + esc(d.by) + '</p>';
        out += '</div></li>';
      });
      out += '</ul><div class="ob-complete"><button type="button" class="pt-btn" data-act="complete" data-two="Onboarding complete"' + (n === list.length ? '' : ' disabled') + '>Onboarding complete</button>' +
        '<p class="pt-muted ob-small">' + (n === list.length ? 'Two clicks. Moves ' + esc(h.first) + ' to Completed.' : 'Tick every step to finish their onboarding.') + '</p></div></section>';
      return out;
    }
    function renderProfile() {
      var box = $('ob-profile'), h = cur();
      if (!h) {
        box.innerHTML = '<div class="pt-card ob-placeholder"><p class="pt-muted">' + (!loaded ? 'Loading…' : 'This person isn’t being onboarded anymore (their onboarding may be complete, or the profile was removed). <a href="/reception-onboarding">Back to all new hires</a>') + '</p></div>';
        return;
      }
      var open = {}; box.querySelectorAll('details[open]').forEach(function (d) { open[d.dataset.how || d.className] = 1; });
      var st = status(h), o = office(h), m = msgs[h.id];
      box.innerHTML = '<article class="pt-card ob-profile" data-id="' + esc(h.id) + '">' +
        '<div class="ob-profile-head"><div><h2>' + esc(full(h)) + '</h2><span class="ob-pill ' + st.cls + '">' + esc(st.text) + '</span></div>' +
        '<button type="button" class="ob-link" data-act="remove" data-two="Remove profile">Remove profile</button></div>' +
        '<p class="ob-meta">' + esc([ROLE_LABEL[h.role], o.label, h.start ? 'starts ' + fmtDate(h.start) : 'no start date', h.pay ? payRate(h) : 'no pay set', tangible(h)].filter(Boolean).join(' · ')) + '</p>' +
        (m && m.text ? '<p class="ob-status' + (m.err ? ' err' : '') + '">' + esc(m.text) + '</p>' : '') +
        detailsForm(h) + contractSection(h) +
        (h.contractSigned ? checklist(h) : '<div class="ob-locked"><b>The rest of ' + esc(h.first) + '’s onboarding unlocks once their employment contract is signed.</b><br>It turns green by itself when the signed contract is saved in their folder. If you handled the contract another way, click <b>Employee contract signed</b> above.</div>') +
        '</article>';
      if (box.dataset.for === h.id) box.querySelectorAll('details').forEach(function (d) { if (open[d.dataset.how || d.className]) d.open = true; });
      box.dataset.for = h.id;
      applyFills(box, h);
    }
    function render() { if (anyArmed()) return; if (viewId) { renderProfile(); document.title = (cur() ? full(cur()) + ' · ' : '') + 'Onboarding | Tangible Therapy'; } else renderList(); }

    // ---- saving ----
    function upd(h, patch) { return api('/api/new-hires', { action: 'update', id: h.id, patch: patch }).then(function (r) { put(r.hire); return r.hire; }); }
    function note(h, text, err) { msgs[h.id] = text ? { text: text, err: !!err } : null; }
    function load() {
      return api('/api/new-hires').then(function (r) {
        hires = r.hires || []; completed = r.completed || []; loaded = true; payrollTracking = !!r.payrollTracking;
        render(); autoCheck();
        if (starting && cur()) { starting = false; history.replaceState(null, '', pageFor(viewId)); startHire(cur()); }
      }, function (e) { loaded = true; $('ob-profile').innerHTML = '<div class="pt-card ob-placeholder"><p class="ob-err">Couldn’t load the new hires: ' + esc(e.message) + '</p></div>'; });
    }

    // ---- folder + contract ----
    function makeFolder(h) {
      return api('/api/new-hire-folder', { first: h.first, last: h.last, payRate: payRate(h), startDate: h.start, office: h.office })
        .then(function (res) { if (!res.url) throw new Error('Google didn’t return the folder link.'); return upd(h, { folder: { id: res.id || null, url: res.url, name: res.name, created: !!res.created, payroll: res.payroll || null } }); });
    }
    function contractProblem(h) {
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(h.personal || '')) return 'Add their personal email. Their contract is sent there.';
      if (!h.start) return 'Add their start date. It goes on the contract.';
      if (!(Number(String(h.pay || '').replace(/[$,\s]/g, '')) > 0)) return 'Add their pay per billable hour (e.g. 60). It goes on the contract.';
      if (!h.folder || !h.folder.id) return 'Their Drive folder is missing.';
      return '';
    }
    function sendContract(h) {
      var p = contractProblem(h); if (p) return Promise.reject(new Error(p));
      return api('/api/new-hire-contract', { first: h.first, last: h.last, personal: h.personal, office: h.office, type: h.contractType, pay: h.pay, start: h.start, folderId: h.folder.id })
        .then(function (res) { return upd(h, { contract: { id: res.id, status: res.status, test: !!res.testMode, docUrl: res.docUrl, recipients: res.recipients || [] } }); });
    }
    function checkContract(h) {
      var c = h.contract;
      if (!c || !c.id || h.contractSigned || cDead(c) || busy[h.id]) return Promise.resolve();
      busy[h.id] = 'recheck'; checkedAt[h.id] = Date.now(); render();
      return api('/api/new-hire-contract?id=' + encodeURIComponent(c.id))
        .then(function (res) { return upd(h, { contract: { id: c.id, status: res.status, test: c.test, docUrl: c.docUrl, recipients: res.recipients && res.recipients.length ? res.recipients : c.recipients, signedUrl: res.signedUrl || c.signedUrl || null } }); })
        .catch(function (e) { note(h, 'Couldn’t check the contract: ' + e.message, true); })
        .then(function () { delete busy[h.id]; render(); });
    }
    function autoCheck() { var h = cur(); if (h && h.contract && !h.contractSigned && Date.now() - (checkedAt[h.id] || 0) > 30000) checkContract(h); }

    // ---- Finish setup (all the automated steps) ----
    function finish(h) {
      var miss = [];
      if (!h.personal) miss.push('their personal email');
      if (!h.pay) miss.push('their pay');
      if (!h.start) miss.push('their start date');
      if (miss.length) return upd(h, { finish: [{ ok: false, text: 'Add ' + (miss.length > 1 ? miss.slice(0, -1).join(', ') + ' and ' + miss[miss.length - 1] : miss[0]) + ' in their details first.' }] });
      var out = [];
      var acct = h.account ? Promise.resolve(h.account) : api('/api/new-hire-email', { first: h.first, last: h.last, personal: h.personal, office: h.office, role: h.role, roles: portalRoles(h), supervisor: isClin(h) ? h.supervisor : '', email: h.email })
        .then(function (res) {
          if (!res.email) throw new Error('Google didn’t return the new email address.');
          var a = { email: res.email, created: !!res.created, emailedTo: res.emailedTo || '', groups: res.groups || [], groupsFailed: res.groupsFailed || [], groupsSetUp: !!res.groupsSetUp, portal: res.portal || '', portalRoles: res.portalRoles || [] };
          return upd(h, { account: a, email: res.email }).then(function (nh) { h = nh; return a; });
        });
      return acct.then(function (a) {
        var bad = (a.groupsFailed || []).length;
        out.push({ ok: !bad && a.groupsSetUp !== false, text: 'Tangible email: ' + a.email + (a.created ? ' created' : ' (already set up)') + (bad ? '. Couldn’t add to ' + a.groupsFailed.join(', ') + ', so add those groups by hand.' : a.groupsSetUp === false ? '. Add their groups by hand.' : ', groups added.') });
        out.push({ ok: !!a.portal, text: a.portal ? 'Employee Portal access: ' + (a.portal === 'kept' ? 'already current staff, not changed.' : 'done.') : 'Employee Portal access wasn’t saved. Ask the office director to add them in Staff Admin.' });
        return true;
      }, function (e) { out.push({ ok: false, text: 'Tangible email not created: ' + e.message }); return false; })
        .then(function (hasAcct) {
          var save = !h.folder ? Promise.reject(new Error('their Drive folder is missing.')) : (function () {
            var parts = h.folder.name.split(' '), last = parts.pop(), first = parts.join(' ');
            return api('/api/new-hire-folder', { first: first, last: last, payRate: payRate(h), startDate: h.start, office: h.office })
              .then(function (res) { return upd(h, { folder: Object.assign({}, h.folder, { payroll: res.payroll || null }) }).then(function (nh) { h = nh; return res.payroll; }); });
          })();
          return save.then(function (pr) {
            var ok = pr && pr.payRate && pr.startDate;
            out.push({ ok: !!ok, text: ok ? 'Payroll: pay and start date saved. Chelsea is emailed automatically once their W-4 and direct deposit form come in.' : 'Payroll: pay or start date didn’t save. Check their details and try again.' });
          }, function (e) { out.push({ ok: false, text: 'Payroll info not saved: ' + e.message }); }).then(function () { return hasAcct; });
        })
        .then(function (hasAcct) {
          if (!hasAcct) { out.push({ ok: false, text: 'Welcome email not sent, because their Tangible email isn’t set up yet.' }); return; }
          if (h.welcome) { out.push({ ok: true, text: 'Welcome email: already sent, not sent again.' }); return; }
          return api('/api/new-hire-welcome', { first: h.first, email: h.account.email, personal: h.personal, office: h.office })
            .then(function (res) {
              out.push({ ok: true, text: res.already ? 'Welcome email: already sent before, not sent again.' : 'Welcome email sent from frontdesk@ to ' + (res.to || []).join(' and ') + '.' });
              return upd(h, { welcome: { sentAt: res.sentAt || new Date().toISOString(), to: res.to || [], already: !!res.already } }).then(function (nh) { h = nh; });
            }, function (e) { out.push({ ok: false, text: 'Welcome email not sent: ' + e.message + (/by hand/.test(e.message) ? '' : ' Send it by hand (“Doing it by hand” below).') }); });
        })
        .then(function () { return upd(h, { finish: out }); });
    }

    // ---- two-click buttons ----
    function twoClick(btn) {
      if (btn.classList.contains('armed')) { clearTimeout(btn._t); btn.classList.remove('armed'); return true; }
      btn.classList.add('armed'); btn.textContent = 'Click again to confirm';
      btn._t = setTimeout(function () { btn.classList.remove('armed'); btn.textContent = btn.dataset.two; render(); }, 5000);
      return false;
    }
    function run(h, kind, p) {
      busy[h.id] = kind; note(h, ''); render();
      return p().catch(function (e) { note(h, e.message, true); }).then(function () { delete busy[h.id]; render(); });
    }

    // ---- events ----
    document.addEventListener('click', function (e) {
      var cp = e.target.closest('[data-copy]');
      if (cp && cur()) { var t = fills(cur())[cp.dataset.copy] || ''; if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { var l = cp.textContent; cp.textContent = 'Copied'; setTimeout(function () { cp.textContent = l; }, 1500); }); return; }
      var btn = e.target.closest('[data-act]'); if (!btn) return;
      var h = cur(); if (!h || busy[h.id]) return;
      var act = btn.dataset.act;
      if (btn.dataset.two && !twoClick(btn)) return;
      if (act === 'recheck') checkContract(h);
      else if (act === 'folder') run(h, 'folder', function () { return makeFolder(h); });
      else if (act === 'send') run(h, 'send', function () { return sendContract(h); });
      else if (act === 'resend') run(h, 'send', function () { return upd(h, { contract: null }).then(sendContract); });
      else if (act === 'signed') run(h, 'signed', function () { return api('/api/new-hires', { action: 'signed', id: h.id }).then(function (r) { put(r.hire); }); });
      else if (act === 'finish') run(h, 'finish', function () { return finish(h); });
      else if (act === 'complete') run(h, 'complete', function () {
        return api('/api/new-hires', { action: 'complete', id: h.id }).then(function () { location.href = '/reception-onboarding'; return new Promise(function () {}); });
      });
      else if (act === 'remove') run(h, 'remove', function () {
        return api('/api/new-hires', { action: 'remove', id: h.id }).then(function () { location.href = '/reception-onboarding'; return new Promise(function () {}); });
      });
    });
    document.addEventListener('change', function (e) {
      var h = cur(); if (!h || !e.target.closest('#ob-profile')) return;
      var st = e.target.closest('[data-step]');
      if (st) {
        var on = st.checked;
        api('/api/new-hires', { action: 'check', id: h.id, step: st.dataset.step, checked: on }).then(function (r) { put(r.hire); render(); }, function (err) { st.checked = !on; note(h, err.message, true); render(); });
        return;
      }
      var f = e.target.closest('[data-field]');
      if (f) {
        var k = f.dataset.field, v = f.type === 'checkbox' ? f.checked : f.value.trim(), patch = {}; patch[k] = v;
        upd(h, patch).then(function (nh) {
          render();
          if ((k === 'pay' || k === 'start') && nh.folder) {
            var parts = nh.folder.name.split(' '), last = parts.pop(), first = parts.join(' ');
            api('/api/new-hire-folder', { first: first, last: last, payRate: payRate(nh), startDate: nh.start, office: nh.office })
              .then(function (res) { return upd(nh, { folder: Object.assign({}, nh.folder, { payroll: res.payroll || null }) }); })
              .catch(function (err) { note(nh, 'Saved, but couldn’t update their folder for payroll: ' + err.message, true); render(); });
          }
        }, function (err) { note(h, err.message, true); render(); });
      }
    });

    // ---- New hire box ----
    function val(id) { return ($('f-' + id).value || '').trim(); }
    function isClinBox() { var r = $('f-role').value; return r === 'therapist' || r === 'associate'; }
    function sayBox(t, err) { $('ob-status').textContent = t; $('ob-status').classList.toggle('err', !!err); }
    $('f-role').addEventListener('change', function () { $('f-supervisor-wrap').hidden = !isClinBox(); });
    $('ob-start').addEventListener('click', function () {
      var d = { first: val('first'), last: val('last'), personal: val('personal'), office: $('f-office').value, role: $('f-role').value, alsosup: $('f-alsosup').checked,
        supervisor: isClinBox() ? $('f-supervisor').value : '', start: val('start'), pay: val('pay'), contractType: $('f-contract').value };
      if (!d.first || !d.last) { sayBox('Type their first and last name first.', true); (d.first ? $('f-last') : $('f-first')).focus(); return; }
      if (d.contractType !== 'none') {
        var p = contractProblem({ personal: d.personal, start: d.start, pay: d.pay, folder: { id: 'x' } });
        if (p) { sayBox(p + ' (Or choose “Don’t send a contract”.)', true); return; }
      }
      var b = $('ob-start'); b.disabled = true; b.setAttribute('aria-busy', 'true'); sayBox('Creating their profile…');
      api('/api/new-hires', Object.assign({ action: 'create' }, d)).then(function (r) {
        location.href = pageFor(r.hire.id) + '&start=1';
      }, function (e) { sayBox('Couldn’t create their profile: ' + e.message, true); b.disabled = false; b.removeAttribute('aria-busy'); });
    });

    // Right after Start a new hire, on their page: make their Drive folder, then send the contract.
    function startHire(h) {
      if (h.folder && h.folder.url) return;
      busy[h.id] = 'start'; note(h, 'Creating their Drive folder…'); render();
      makeFolder(h).then(function (h2) {
        if (h2.contractType === 'none') return;
        if (!h2.folder.id) throw new Error('Their folder is ready, but the Google script needs updating before contracts can be sent (see docs/new-hire-folder).');
        note(h2, 'Filling in and sending their contract…'); render();
        return sendContract(h2);
      }).then(function () { note(h, ''); }, function (e) { note(h, e.message, true); })
        .then(function () { delete busy[h.id]; render(); });
    }

    // Supervisors (everyone with the Clinical supervisor role on the Employee Portal).
    fetch('/api/new-hire-email', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (b) {
      if (!b || !b.supervisors) return;
      supervisors = b.supervisors;
      supervisors.forEach(function (x) { var op = document.createElement('option'); op.value = x.email; op.textContent = x.name; $('f-supervisor').appendChild(op); });
      render();
    }).catch(function () {});

    // A hire that was only saved in this browser by the old checklist becomes a shared profile.
    function importOld() {
      var s = null; try { s = JSON.parse(localStorage.getItem('tt.onboard.v1') || 'null'); } catch (e) {}
      if (!s || !s.f || !s.f.first || !s.f.last || !(s.folder || Object.keys(s.done || {}).length)) return Promise.resolve();
      var f = s.f, done = s.done || {};
      var imp = { folder: s.folder || null, contract: s.contract || null, account: s.account || null, welcome: s.welcome || null, finish: s.finish || [],
        contractSigned: !!done['employment-contract'] || cDone(s.contract),
        done: { setup: done.gmailsetup && done['staff-admin'] && done.onboarding ? 1 : 0, slack: done.slack, simple: done.simple, paperwork: done.driveandpayroll, malpractice: done.malpractice, hours: done.hours, availibility: done.availibility, 'booking-id': done['booking-id'], website: done.website, 'psychology-today': done['psychology-today'] } };
      return api('/api/new-hires', { action: 'create', first: f.first, last: f.last, personal: f.personal || '', email: f.email || '', office: f.office || 'orem', role: f.role || 'therapist', alsosup: !!f.alsosup, supervisor: f.supervisor || '', start: f.start || '', pay: '', contractType: f.contract || 'none', import: imp })
        .then(function () { try { localStorage.removeItem('tt.onboard.v1'); } catch (e) {} }, function () {});
    }

    importOld().then(load);
    setInterval(function () {
      if (document.hidden || anyArmed() || Object.keys(busy).length) return;
      var a = document.activeElement; if (a && a.closest && a.closest('#ob-profile') && /INPUT|SELECT/.test(a.tagName)) return;
      load();
    }, 60000);
  })();
</script>
</Base>
