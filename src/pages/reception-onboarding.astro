---
// Reception: step-by-step checklist for onboarding a new employee (front desk + directors).
// Redesigned Oct 2026: plain HTML in the Employee Portal style (.pt-*), grouped into 4 stages with a
// "new hire" panel that fills the email templates, a per-browser checklist (localStorage tt.onboard.v1)
// and role-aware steps (clinician-only / associate-only). Old #anchors are kept as step ids.
// No logins or passwords on this page — point to the team password manager.
import Base from '../layouts/Base.astro';
import { OFFICES } from '../data/staff-access';
import { CONTRACT_SIGNER as SIGNER, CONTRACT_TYPES, LOCATION_DIRECTORS } from '../data/contracts';
const CONTRACT_SIGNER = SIGNER.name;

const DRIVE_EMPLOYEES = 'https://drive.google.com/drive/u/0/folders/1DCzPfLaGhpOIepDvmZ0krxgQl61bahwN';
const DRIVE_MANAGEMENT = 'https://drive.google.com/drive/folders/1Lmh1aH0YbyRgcfuunFafXil00kQi1zLI';
const ONBOARDING_SHEET = 'https://docs.google.com/spreadsheets/d/1i2OFTCSZUwcAvJD7pckJT0h9BPsUk2wvuAS0IjgjWZ8/edit?gid=0#gid=0';
const THERAPIST_SHEET = 'https://docs.google.com/spreadsheets/d/1QIrJbIzoNtenFfOqAGBJzyx3nYSPVkLqOu7ECwLx-Kw/edit';
const SIMPLEPRACTICE = 'https://secure.simplepractice.com/calendar/appointments';
const ext = 'target="_blank" rel="noopener"';
const a = (href: string, text: string) => `<a href="${href}" ${ext}>${text}</a>`;

const offices = OFFICES.map((o) => ({ id: o.id, label: o.label, director: o.director, email: o.directorEmail, directorFull: LOCATION_DIRECTORS[o.id]?.name || o.director }));

type Step = { id: string; title: string; who?: 'clinician' | 'associate'; tag?: string; body: string };
type Stage = { title: string; when: string; steps: Step[]; gate?: string };

const stages: Stage[] = [
  {
    title: 'Get the contract signed',
    when: 'As soon as the hire is confirmed',
    gate: 'Stop here. Don’t do any other steps until the employment contract is signed and saved.',
    steps: [
      { id: 'googledrive', title: 'Create their Google Drive folder', body: `
        <p class="ob-folder" data-folder hidden></p>
        <p>This happens automatically when you click <b>Start a new hire</b> at the top: their folder is made inside the shared ${a(DRIVE_EMPLOYEES, 'Employee folder')}, so everyone who has that folder can see it.</p>
        <p class="pt-muted">If that didn’t work, make it by hand:</p><ol>
        <li>Open the ${a(DRIVE_EMPLOYEES, 'Employee folder')} in Google Drive.</li>
        <li>Click <b>New</b> → <b>New folder</b> (top left).</li>
        <li>Name it with their first and last name: <span class="ob-chip" data-fill="full">First Last</span></li></ol>` },
      { id: 'employment-contract', title: 'Send the employment contract', body: `
        <div class="ob-contract" data-contract hidden></div>
        <p>This happens automatically when you click <b>Start a new hire</b> with a contract chosen: the right contract is filled in with their name, start date and pay, and sent through SignWell for signing in this order: <b>their location director</b> (<span data-fill="directorName">the office director</span>), then <b>${CONTRACT_SIGNER}</b> (COO), then the new hire at their personal email. For Provo, ${CONTRACT_SIGNER} signs once. The signed copy is saved in their folder and emailed to front desk.</p>
        <p class="pt-muted">If you need to do it by hand:</p><ol>
        <li>Open the ${a(DRIVE_MANAGEMENT, 'Management folder')}.</li>
        <li>Right-click the right employment contract → <b>Make a copy</b>.</li>
        <li>Fill in the copy: name, pay, employment status, etc.</li>
        <li><b>File</b> → <b>Download</b> → <b>PDF</b>.</li>
        <li>Send it to their location director, then ${CONTRACT_SIGNER} (COO), to sign.</li>
        <li>Then send it to the new employee to sign.</li>
        <li>Save the signed copy in their Google Drive folder.</li></ol>` },
    ],
  },
  {
    title: 'Set up their accounts',
    when: 'After the contract is signed',
    steps: [
      { id: 'gmailsetup', title: 'Create their Tangible email and add to groups', body: `<ol>
        <li>Open the ${a('https://admin.google.com/ac/users', 'Google Admin console')} → <b>Users</b> → <b>Add new user</b>.</li>
        <li>Enter their name. Use their first name for the email address: <span class="ob-chip" data-fill="email">first@tangiblementalhealth.com</span>. If it’s taken, use first name + last initial.</li>
        <li>Put their personal email as the secondary email (Google sends their setup link there).</li>
        <li>Click <b>Add new user</b>.</li></ol>
        <h4>Add to Google Groups</h4><ol>
        <li>In the left menu, open <b>Directory</b> → <b>Groups</b>.</li>
        <li>Hover over a group and click <b>Add members</b>.</li>
        <li>Add them to the groups for their office (<span data-fill="office">their office</span>).</li></ol>` },
      { id: 'staff-admin', title: 'Get them approved for the Employee Portal', tag: 'New', body: `
        <p>This lets them sign in to the Employee Portal with their Tangible Google account and see the right pages.</p><ol>
        <li>Ask <span data-fill="director">the office director</span> to add them at ${a('/staff-admin', 'Staff Admin')} (only directors can open it). Send them:
          <span class="ob-chip" data-fill="staffline">Name, email, role, office</span> <button type="button" class="ob-mini" data-copy="staffline">Copy</button></li>
        <li>Roles: <b>Therapist</b> for licensed clinicians, <b>Associate (pre-licensed)</b> for anyone logging supervised hours, <b>Admin / front desk</b> for reception. Someone can have more than one.</li>
        <li>If they sign in before they’re added, they show up as <b>pending</b> and the director just clicks Approve.</li></ol>
        <p class="ob-tip">Until Google sign-in is switched on for the live site, also send them the staff password from the team password manager.</p>` },
      { id: 'slack', title: 'Invite them to Slack', body: `<ol>
        <li>Open Slack and click <b>Tangible Therapy</b> (top left).</li>
        <li>Click <b>Invite people</b> and enter their Tangible email.</li></ol>` },
      { id: 'simple', who: 'clinician', title: 'Add them to SimplePractice', body: `<ol>
        <li>Open ${a(SIMPLEPRACTICE, 'SimplePractice')} → <b>Settings</b> → <b>Team</b> → <b>Team members</b>.</li>
        <li>Click <b>Add new team member</b> (top right).</li>
        <li>Enter their legal name and Tangible email → <b>Continue</b>.</li>
        <li>Choose <b>Clinician</b> and <b>Full client list</b> → <b>Continue</b>.</li>
        <li>Turn on all permissions → <b>Continue</b>.</li>
        <li>If they need supervision, pick their supervisor from the dropdown. Specialty: <b>Counselor</b>.</li>
        <li>Send the invitation and finish setup.</li></ol>` },
    ],
  },
  {
    title: 'Paperwork and payroll',
    when: 'Once their email works',
    steps: [
      { id: 'onboarding', title: 'Send the welcome email (orientation + onboarding)', body: `
        <p>Fill in the new hire details at the top and the email below is ready to send.</p>
        <div class="ob-mail">
          <p class="ob-mail-meta"><b>To:</b> <span data-fill="emailOrPersonal">their email</span><br><b>Subject:</b> Welcome to Tangible!</p>
          <pre class="ob-mail-body" data-fill="welcomeBody"></pre>
        </div>
        <div class="ob-actions"><a class="pt-btn" data-mail="welcome" href="#" ${ext}>Open in Gmail</a><button type="button" class="pt-btn ghost" data-copy="welcomeBody">Copy text</button></div>` },
      { id: 'driveandpayroll', title: 'File their paperwork and add them to payroll', body: `<ol>
        <li>Wait for their answers in the ${a(ONBOARDING_SHEET, 'Onboarding responses')} sheet (you’ll also get an email alert).</li>
        <li>Download their uploaded files and put them in their ${a(DRIVE_EMPLOYEES, 'Google Drive folder')}.</li>
        <li>Email payroll (nsbcpayroll@gmail.com) with their name, pay rate and start date, and <b>attach the W-4 and direct deposit form</b>.</li></ol>
        <div class="ob-actions"><a class="pt-btn" data-mail="payroll" href="#" ${ext}>Open payroll email in Gmail</a></div>
        <p class="ob-tip">Gmail can’t attach the files for you. Add the W-4 and direct deposit form before sending.</p>` },
      { id: 'malpractice', who: 'clinician', title: 'Add them to malpractice insurance', body: `<ol>
        <li>Open the ${a('https://www.insure-portal.com/User/', 'malpractice insurance portal')} and sign in (the login is in the team password manager).</li>
        <li>Click <b>Make changes to my policy</b> → <b>Add something</b> → <b>Add an employee</b>.</li>
        <li>Add them and click <b>Save</b>.</li></ol>` },
    ],
  },
  {
    title: 'Get them ready to see clients',
    when: 'After onboarding is finished',
    steps: [
      { id: 'supervision', who: 'clinician', title: 'Schedule supervision', body: `<ol>
        <li>Reach out to <span data-fill="director">the office director</span> / their supervisor and find a time that works for both of them.</li>
        <li>Add a recurring event to both calendars.</li></ol>` },
      { id: 'hours', who: 'associate', tag: 'New', title: 'Link them in the Hours Tracker', body: `
        <p>Pre-licensed associates log their supervised hours in the ${a('/hours', 'Hours Tracker')}.</p><ol>
        <li>Make sure they have the <b>Associate (pre-licensed)</b> role in Staff Admin (step above).</li>
        <li>Ask their clinical supervisor to open the Hours Tracker → <b>My supervisees</b> → add them, and set their license track, start date and hour targets.</li>
        <li>If they were already linked to a different supervisor, that supervisor has to remove them first.</li></ol>` },
      { id: 'photos', who: 'clinician', title: 'Schedule headshots', body: `<ol>
        <li>Coordinate a time with Julie and the new employee.</li>
        <li>Tell them to wear semi-professional clothes in neutral colors (not gray or black).</li></ol>` },
      { id: 'availibility', who: 'clinician', title: 'Set up their availability in SimplePractice', body: `<ol>
        <li>Open ${a(SIMPLEPRACTICE, 'SimplePractice')} and go to their calendar.</li>
        <li>Click the gear icon (top right) → <b>View availability schedule</b>.</li>
        <li>Click a time to add availability and title it <b>Opening</b>. Their schedule is in the ${a(ONBOARDING_SHEET, 'Onboarding responses')} sheet.</li>
        <li>Set it to repeat on the right days. Different time windows are added one at a time.</li>
        <li>Pick the right location and tick <b>Telehealth</b>.</li>
        <li>Make sure the services match the screenshot below, then <b>Save</b>. Repeat for other times.</li></ol>
        <img class="ob-shot" src="/images/screenshot-2025-11-24-at-3-57-40-pm-b0f670.png" alt="SimplePractice availability window showing the services to offer" width="858" height="570" loading="lazy" decoding="async">` },
      { id: 'booking-id', who: 'clinician', tag: 'New', title: 'Find their SimplePractice booking ID', body: `
        <p>This makes the <b>Book now</b> button on their website profile open their own calendar.</p><ol>
        <li>In SimplePractice go to <b>Settings</b> → <b>Widgets</b> → <b>Appointment request</b>.</li>
        <li>Preview their row and copy the <b>clinicianId</b> number.</li>
        <li>Paste it in the <b>SimplePractice clinician ID</b> column of their row in the website profiles tab (next step).</li></ol>
        <p class="ob-tip">Their booking page only shows times once their availability and new-client services are set up (step above).</p>` },
      { id: 'website', who: 'clinician', tag: 'New', title: 'Add them to the website', body: `
        <p>No code needed. The website reads the ${a(THERAPIST_SHEET, 'tangible sheets')} Google Sheet.</p><ol>
        <li>In the <b>website profiles</b> tab, add a row: Name, Credential, Photo (Google Drive link to their headshot), Bio, SimplePractice clinician ID, Online booking and Show on website. SEO description is optional.</li>
        <li>Add them to the <b>openings</b>, <b>modalities</b> and <b>Insurances</b> tabs too, spelling their name exactly the same.</li>
        <li>Their profile goes live about 15 minutes after the last edit, but only once the photo link works. The <b>Website status</b> column says what’s missing.</li></ol>` },
      { id: 'psychology-today', who: 'clinician', title: 'Create their Psychology Today profile', body: `<p class="pt-muted">Step-by-step instructions haven’t been written yet.</p>` },
    ],
  },
];
const total = stages.reduce((n, s) => n + s.steps.length, 0);
let num = 0;
---
<Base title={"Onboarding New Employees | Tangible Therapy"} description={""} noindex>
<div class="pt-page ob">
  <div class="pt-head">
    <div>
      <p class="pt-eyebrow">Reception</p>
      <h1>Onboarding a new employee</h1>
    </div>
    <p class="pt-muted ob-count" aria-live="polite"><span id="ob-done">0</span> of <span id="ob-total">{total}</span> steps done</p>
  </div>

  <div class="ob-layout">
    <aside class="ob-side">
      <section class="pt-card ob-hire">
        <h2>New hire</h2>
        <p class="pt-muted">Fill these in, then click Start a new hire. It makes their Google Drive folder and sends their contract for signing. The emails and names below fill themselves.</p>
        <div class="ob-fields">
          <label class="pt-field">First name<input id="f-first" autocomplete="off"></label>
          <label class="pt-field">Last name<input id="f-last" autocomplete="off"></label>
          <label class="pt-field ob-wide">Tangible email<input id="f-email" type="email" autocomplete="off" placeholder="Suggested from first name"></label>
          <label class="pt-field ob-wide">Personal email<input id="f-personal" type="email" autocomplete="off" placeholder="Their contract is sent here"></label>
          <label class="pt-field">Office<select id="f-office">{offices.map((o) => <option value={o.id}>{o.label}</option>)}</select></label>
          <label class="pt-field">Role<select id="f-role">
            <option value="therapist">Therapist (licensed)</option>
            <option value="associate">Associate (pre-licensed)</option>
            <option value="frontdesk">Admin / front desk</option>
            <option value="other">Other</option>
          </select></label>
          <label class="pt-field">Start date<input id="f-start" type="date"></label>
          <label class="pt-field">Pay per billable hr ($)<input id="f-pay" inputmode="decimal" autocomplete="off" placeholder="e.g. 60"></label>
          <label class="pt-field ob-wide">Contract to send<select id="f-contract">
            {Object.entries(CONTRACT_TYPES).map(([k, v]) => <option value={k}>{v}</option>)}
            <option value="none">Don’t send a contract (I’ll do it by hand)</option>
          </select></label>
        </div>
        <button type="button" class="pt-btn ob-start" id="ob-start">Start a new hire</button>
        <p class="ob-status" id="ob-status" role="status" aria-live="polite"></p>
        <p class="ob-folder" data-folder hidden></p>
        <div class="ob-contract" data-contract hidden></div>
        <button type="button" class="pt-btn ghost ob-send" id="ob-send" hidden>Send their contract</button>
        <button type="button" class="ob-reset" id="ob-reset" hidden>Clear for the next hire</button>
      </section>
      <nav class="pt-card ob-nav" aria-label="Onboarding steps">
        <div class="ob-bar"><i id="ob-bar"></i></div>
        {stages.map((s, si) => (
          <div class="ob-nav-stage">
            <p class="ob-nav-title">{si + 1}. {s.title}</p>
            <ul>{s.steps.map((st) => <li data-nav={st.id} data-who={st.who}><a href={`#${st.id}`}>{st.title}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </aside>

    <div class="ob-main">
      {stages.map((s, si) => (
        <section class="ob-stage" data-stage={si}>
          <header class="ob-stage-head">
            <span class="ob-stage-num">Stage {si + 1}</span>
            <h2>{s.title}</h2>
            <p class="pt-muted">{s.when}</p>
          </header>
          {s.steps.map((st) => { num++; return (
            <article class="pt-card ob-step" id={st.id} data-step={st.id} data-who={st.who}>
              <label class="ob-check">
                <input type="checkbox" data-check={st.id}>
                <span class="ob-num" aria-hidden="true">{num}</span>
                <span class="ob-title">{st.title}{st.tag && <em class="ob-tag">{st.tag}</em>}</span>
              </label>
              <p class="ob-skip">Not needed for this role. Skip it or tick it if it applies.</p>
              <div class="ob-body" set:html={st.body} />
            </article>
          ); })}
          {s.gate && <div class="ob-gate" role="note"><strong>Stop</strong><span>{s.gate}</span></div>}
        </section>
      ))}
      <p class="pt-note">Your ticks and the new hire’s details are saved in this browser only. Pay rate is never saved. Use “Clear for the next hire” to clear everything (it doesn’t delete their Drive folder).</p>
    </div>
  </div>
</div>

<style is:global>
  .ob h4 { font-size: .95rem; font-weight: 600; margin: 1rem 0 .3rem; }
  .ob .ob-count { font-size: .95rem; }
  .ob .ob-count span { font-weight: 600; color: var(--charcoal); }
  .ob .ob-layout { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .ob .ob-side { position: sticky; top: 1rem; display: flex; flex-direction: column; gap: 1rem; max-height: calc(100vh - 2rem); overflow: auto; }
  .ob .ob-fields { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .6rem; margin: .9rem 0; }
  .ob .ob-wide { grid-column: 1 / -1; }
  .ob .ob-fields input, .ob .ob-fields select { font: inherit; font-size: .9rem; color: var(--charcoal); border: 1px solid #c9cfca; border-radius: 10px; padding: .45rem .6rem; background: #fff; min-width: 0; width: 100%; box-sizing: border-box; min-height: 38px; }
  .ob .ob-start { width: 100%; }
  .ob .ob-start[aria-busy=true] { opacity: .6; cursor: progress; }
  .ob .ob-send { width: 100%; margin-top: .6rem; }
  .ob .ob-send[hidden] { display: none; }
  .ob .ob-contract { font-size: .88rem; background: #f6f4ec; color: #4a4630; border-radius: 10px; padding: .55rem .75rem; margin: .6rem 0 0; line-height: 1.5; }
  .ob .ob-contract[hidden] { display: none; }
  .ob .ob-contract.ok { background: #e8f1ea; color: #23432c; }
  .ob .ob-contract.bad { background: #fbe9e4; color: #6b2a17; }
  .ob .ob-contract a { color: inherit; font-weight: 600; }
  .ob .ob-status { font-size: .85rem; margin: .6rem 0 0; }
  .ob .ob-status:empty { display: none; }
  .ob .ob-status.err { color: #8a2f1c; }
  .ob .ob-folder { font-size: .88rem; background: #e8f1ea; color: #23432c; border-radius: 10px; padding: .55rem .75rem; margin: .6rem 0 0; }
  .ob .ob-folder a { color: inherit; font-weight: 600; }
  .ob .ob-reset { display: block; margin: .7rem auto 0; font: inherit; font-size: .82rem; color: #5d635e; background: none; border: 0; text-decoration: underline; cursor: pointer; padding: .3rem; }
  .ob .ob-reset[hidden] { display: none; }
  .ob .ob-step.done .ob-folder { display: none; }
  .ob .ob-bar { height: 6px; border-radius: 6px; background: #e6e9e6; overflow: hidden; margin-bottom: .9rem; }
  .ob .ob-bar i { display: block; height: 100%; width: 0; background: var(--slate); transition: width .3s; }
  .ob .ob-nav-title { font-size: .78rem; font-weight: 600; color: #5d635e; margin: .7rem 0 .2rem; text-transform: uppercase; letter-spacing: .04em; }
  .ob .ob-nav ul { list-style: none; margin: 0; padding: 0; }
  .ob .ob-nav li a { display: block; padding: .25rem 0 .25rem 1.4rem; font-size: .86rem; color: var(--charcoal); text-decoration: none; position: relative; line-height: 1.35; }
  .ob .ob-nav li a::before { content: ''; position: absolute; left: 0; top: .45rem; width: .8rem; height: .8rem; border-radius: 50%; border: 1.5px solid #b5bcb6; box-sizing: border-box; }
  .ob .ob-nav li.done a { color: #7a807b; text-decoration: line-through; }
  .ob .ob-nav li.done a::before { background: var(--slate); border-color: var(--slate); }
  .ob .ob-nav li.na a { color: #9aa09b; }
  .ob .ob-stage { margin-bottom: 2rem; }
  .ob .ob-stage-head { margin: 0 0 .8rem; }
  .ob .ob-stage-num { font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--slate); }
  .ob .ob-stage-head h2 { font-size: 1.35rem; font-weight: 600; margin: .1rem 0 .1rem; color: var(--charcoal); }
  .ob .ob-step { margin-bottom: .8rem; scroll-margin-top: 1rem; transition: opacity .2s; }
  .ob .ob-check { display: flex; align-items: center; gap: .75rem; cursor: pointer; }
  .ob .ob-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .ob .ob-num { flex: none; width: 2rem; height: 2rem; border-radius: 50%; border: 2px solid #b5bcb6; display: grid; place-items: center; font-weight: 600; font-size: .9rem; color: var(--charcoal); }
  .ob .ob-check input:focus-visible + .ob-num { outline: 2px solid var(--charcoal); outline-offset: 2px; }
  .ob .ob-check input:checked + .ob-num { background: var(--slate); border-color: var(--slate); color: #fff; font-size: 0; }
  .ob .ob-check input:checked + .ob-num::after { content: '✓'; font-size: 1rem; }
  .ob .ob-title { font-size: 1.05rem; font-weight: 600; color: var(--charcoal); line-height: 1.3; }
  .ob .ob-tag { font-style: normal; font-size: .7rem; font-weight: 600; background: var(--sage); color: var(--charcoal); border-radius: 300px; padding: .1rem .55rem; margin-left: .5rem; vertical-align: middle; }
  .ob .ob-body { padding-left: 2.75rem; font-size: .93rem; line-height: 1.55; }
  .ob .ob-body ol { margin: .6rem 0 0; padding-left: 1.2rem; }
  .ob .ob-body li { margin: .25rem 0; }
  .ob .ob-body p { margin: .6rem 0 0; }
  .ob .ob-chip { display: inline-block; background: #f1f3f1; border-radius: 6px; padding: 0 .4rem; font-weight: 500; word-break: break-all; }
  .ob .ob-mini { font: inherit; font-size: .75rem; border: 1px solid #c9cfca; background: #fff; border-radius: 300px; padding: .05rem .6rem; cursor: pointer; margin-left: .2rem; }
  .ob .ob-tip { font-size: .85rem; background: #f6f4ec; border-radius: 10px; padding: .5rem .75rem; }
  .ob .ob-mail { border: 1px solid #e0e4e0; border-radius: 12px; margin-top: .7rem; overflow: hidden; }
  .ob .ob-mail-meta { background: #f6f7f6; margin: 0 !important; padding: .6rem .9rem; font-size: .85rem; }
  .ob .ob-mail-body { margin: 0; padding: .8rem .9rem; font: inherit; font-size: .88rem; white-space: pre-wrap; max-height: 320px; overflow: auto; }
  .ob .ob-actions { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .8rem; }
  .ob .ob-actions a.pt-btn { text-decoration: none; display: inline-flex; align-items: center; }
  .ob .ob-shot { display: block; max-width: 100%; height: auto; border-radius: 12px; margin-top: .8rem; border: 1px solid #e0e4e0; }
  .ob .ob-skip { display: none; margin: .4rem 0 0 2.75rem; font-size: .82rem; color: #5d635e; }
  .ob .ob-step.na { opacity: .6; }
  .ob .ob-step.na .ob-skip { display: block; }
  .ob .ob-step.na .ob-body { display: none; }
  .ob .ob-step.done .ob-body { display: none; }
  .ob .ob-step.done .ob-title { color: #5d635e; }
  .ob .ob-gate { display: flex; gap: .9rem; align-items: center; background: #fbe9e4; border: 1px solid #efc2b5; color: #6b2a17; border-radius: 16px; padding: .9rem 1.2rem; margin-top: 1rem; font-size: .95rem; }
  .ob .ob-gate strong { flex: none; background: #b8432b; color: #fff; border-radius: 300px; padding: .2rem .8rem; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; }
  .ob .ob-gate.ok { background: #e8f1ea; border-color: #bcd6c2; color: #23432c; }
  .ob .ob-gate.ok strong { background: var(--slate); }
  @media (max-width: 1100px) {
    .ob .ob-layout { grid-template-columns: minmax(0, 1fr); }
    .ob .ob-side { position: static; max-height: none; overflow: visible; }
    .ob .ob-nav { display: none; }
  }
  @media (max-width: 520px) {
    .ob .ob-body { padding-left: 0; }
    .ob .ob-skip { margin-left: 0; }
    .ob .ob-fields { grid-template-columns: 1fr; }
    .ob .ob-gate { flex-direction: column; align-items: flex-start; }
  }
</style>

<script is:inline define:vars={{ offices, signer: SIGNER.name }}>
  (function () {
    var KEY = 'tt.onboard.v1';
    var F = ['first', 'last', 'email', 'personal', 'office', 'role', 'start', 'contract'];
    var $ = function (id) { return document.getElementById(id); };
    var state = { f: {}, done: {} };
    try { var s = JSON.parse(localStorage.getItem(KEY) || 'null'); if (s && s.f && s.done) state = s; } catch (e) {}
    function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }

    function val(id) { return ($('f-' + id).value || '').trim(); }
    function office() { var id = $('f-office').value; for (var i = 0; i < offices.length; i++) if (offices[i].id === id) return offices[i]; return offices[0]; }
    function suggestedEmail() { var f = val('first').toLowerCase().replace(/[^a-z]/g, ''); return f ? f + '@tangiblementalhealth.com' : ''; }
    function email() { return val('email') || suggestedEmail(); }
    function fmtDate(d) { if (!d) return ''; var p = d.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }); }
    var ROLE = { therapist: 'therapist', associate: 'associate', frontdesk: 'frontdesk', other: '' };

    function data() {
      var first = val('first'), last = val('last'), o = office(), full = (first + ' ' + last).trim();
      var welcome = 'Hi ' + (first || '[first name]') + ',\n\n' +
        'Welcome to the Tangible team! We’re excited to have you on board.\n\n' +
        'To get started, please complete our orientation and onboarding:\n\n' +
        '1. Go to the Employee Portal: https://tangiblementalhealth.com/employeeportal\n' +
        '2. Sign in with your new Tangible email (' + (email() || '[Tangible email]') + '). You should have an email from Google about your new account.\n' +
        '3. Under “New employees”, open Orientation. It covers important things you’ll need for your work at Tangible, so take the time you need. It takes about an hour.\n' +
        '4. When you’ve finished Orientation, complete Onboarding (also under “New employees”).\n\n' +
        'If you have any questions, just reach out and we’ll help you through it.\n\n' +
        'When you’ve finished both, please contact your practice director, ' + o.director + ' (' + o.email + '), to set up a time to finish onboarding.\n\n' +
        'Welcome aboard!';
      var payroll = 'Hi,\n\nPlease add our new employee to payroll:\n\n' +
        'Name: ' + (full || '[name]') + '\n' +
        'Pay rate: ' + (val('pay') || '[pay rate]') + '\n' +
        'Start date: ' + (fmtDate(val('start')) || '[start date]') + '\n\n' +
        'Their W-4 and direct deposit form are attached.\n\nThank you!';
      return {
        full: full || 'First Last',
        email: email() || 'first@tangiblementalhealth.com',
        emailOrPersonal: [email(), val('personal')].filter(Boolean).join(', ') || 'their email',
        office: o.label,
        director: o.director + ' (' + o.email + ')',
        directorName: o.directorFull,
        staffline: [full || 'Name', email() || 'email', ROLE[$('f-role').value] || 'role', o.id].join(', '),
        welcomeBody: welcome,
        payrollBody: payroll,
        directorEmail: o.email,
      };
    }
    function gmail(to, su, body) {
      return 'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(to) + '&su=' + encodeURIComponent(su) + '&body=' + encodeURIComponent(body);
    }

    function render() {
      var d = data();
      $('f-email').placeholder = suggestedEmail() || 'Suggested from first name';
      document.querySelectorAll('[data-fill]').forEach(function (n) { if (d[n.dataset.fill] != null) n.textContent = d[n.dataset.fill]; });
      var to = [email(), val('personal')].filter(Boolean).join(',');
      document.querySelectorAll('[data-mail=welcome]').forEach(function (n) { n.href = gmail(to, 'Welcome to Tangible!', d.welcomeBody); });
      document.querySelectorAll('[data-mail=payroll]').forEach(function (n) { n.href = gmail('nsbcpayroll@gmail.com', 'New employee: ' + (val('first') + ' ' + val('last')).trim(), d.payrollBody); });

      var role = $('f-role').value;
      var done = 0, all = 0;
      document.querySelectorAll('[data-step]').forEach(function (n) {
        var id = n.dataset.step, who = n.dataset.who;
        var na = (who === 'clinician' && role === 'frontdesk') || (who === 'associate' && role !== 'associate');
        var ok = !!state.done[id];
        n.classList.toggle('na', na && !ok);
        n.classList.toggle('done', ok);
        n.querySelector('[data-check]').checked = ok;
        var nav = document.querySelector('[data-nav="' + id + '"]');
        if (nav) { nav.classList.toggle('done', ok); nav.classList.toggle('na', na && !ok); }
        if (!na || ok) { all++; if (ok) done++; }
      });
      $('ob-done').textContent = done; $('ob-total').textContent = all;
      $('ob-bar').style.width = (all ? Math.round(done / all * 100) : 0) + '%';
      var gate = document.querySelector('.ob-gate');
      var c = state.contract, cText = contractText();
      if (gate) {
        var signed = c ? isDone(c) : !!state.done['employment-contract'];
        gate.classList.toggle('ok', signed);
        gate.querySelector('strong').textContent = signed ? 'Go' : 'Stop';
        gate.querySelector('span').textContent = signed ? 'Contract signed. You can move on to setting up their accounts.'
          : (c ? cText + ' Don’t do any other steps until it’s signed.' : 'Don’t do any other steps until the employment contract is signed and saved.');
      }
      document.querySelectorAll('[data-contract]').forEach(function (n) {
        n.hidden = !c; if (!c) return;
        n.textContent = ''; n.className = 'ob-contract' + (isDone(c) ? ' ok' : isDead(c) ? ' bad' : '');
        n.append(cText + ' ');
        if (isDone(c) && c.signedUrl) { var l = document.createElement('a'); l.href = c.signedUrl; l.target = '_blank'; l.rel = 'noopener'; l.textContent = 'Open the signed contract'; n.append(l); }
        else if (!isDone(c) && !isDead(c)) { var b = document.createElement('button'); b.type = 'button'; b.className = 'ob-mini'; b.dataset.recheck = '1'; b.textContent = checking ? 'Checking…' : 'Check again'; b.disabled = checking; n.append(b); }
        else if (isDead(c)) { var r = document.createElement('button'); r.type = 'button'; r.className = 'ob-mini'; r.dataset.resend = '1'; r.textContent = 'Send a new contract'; n.append(r); }
      });
      var started = state.folder && state.folder.url;
      document.querySelectorAll('[data-folder]').forEach(function (n) {
        n.hidden = !started;
        if (started) {
          n.textContent = '';
          n.append((state.folder.created ? 'Folder created: ' : 'Found their existing folder: '));
          var l = document.createElement('a'); l.href = state.folder.url; l.target = '_blank'; l.rel = 'noopener';
          l.textContent = state.folder.name; n.append(l);
        }
      });
      $('ob-start').hidden = !!started;
      $('ob-send').hidden = !started || !!c || $('f-contract').value === 'none';
      $('ob-reset').hidden = !started && !Object.keys(state.done).length && !F.some(function (k) { return state.f[k]; });
    }

    // ---- employment contract (SignWell, via /api/new-hire-contract) ----
    var checking = false;
    function isDone(c) { return /complete/i.test(c.status || ''); }
    function isDead(c) { return /declin|expire|cancel/i.test(c.status || ''); }
    function contractText() {
      var c = state.contract; if (!c) return '';
      var test = c.test ? ' (test mode, not binding)' : '';
      if (isDone(c)) return 'Contract signed by everyone' + (c.signedUrl ? ' and saved to their folder' : '') + '.' + test;
      if (isDead(c)) return 'The contract was ' + String(c.status).toLowerCase() + '.' + test;
      var next = (c.recipients || []).filter(function (r) { return !r.signed; })[0];
      return 'Contract sent' + test + '. Waiting for ' + (next ? next.name : signer) + ' to sign.';
    }
    function api(url, body) {
      return fetch(url, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify(body) } : { credentials: 'same-origin' })
        .then(function (r) { return r.json().catch(function () { return { error: 'The website didn’t answer (status ' + r.status + ').' }; }); })
        .then(function (res) { if (!res || res.error) throw new Error((res && res.error) || 'Something went wrong.'); return res; });
    }
    function contractProblem() {
      if ($('f-contract').value === 'none') return '';
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(val('personal'))) return 'Add their personal email. Their contract is sent there.';
      if (!val('start')) return 'Add their start date. It goes on the contract.';
      if (!(Number(val('pay').replace(/[$,\s]/g, '')) > 0)) return 'Add their pay per billable hour (e.g. 60). It goes on the contract.';
      return '';
    }
    function sendContract() {
      say('Filling in and sending their contract…');
      return api('/api/new-hire-contract', { first: val('first'), last: val('last'), personal: val('personal'), office: $('f-office').value, type: $('f-contract').value, pay: val('pay'), start: val('start'), folderId: state.folder.id })
        .then(function (res) {
          state.contract = { id: res.id, status: res.status, test: !!res.testMode, docUrl: res.docUrl, recipients: res.recipients || [{ name: signer, signed: false }, { name: (val('first') + ' ' + val('last')).trim(), signed: false }] };
          save(); say(''); render();
        })
        .catch(function (e) { say('Their folder is ready, but the contract wasn’t sent: ' + e.message + ' Fix it and click “Send their contract”, or do it by hand (step 2).', true); render(); });
    }
    function checkContract() {
      var c = state.contract;
      if (!c || !c.id || checking || (isDone(c) && c.signedUrl) || isDead(c)) return;
      checking = true; render();
      api('/api/new-hire-contract?id=' + encodeURIComponent(c.id))
        .then(function (res) {
          c.status = res.status; c.recipients = res.recipients && res.recipients.length ? res.recipients : c.recipients; c.signedUrl = res.signedUrl || c.signedUrl;
          if (isDone(c)) state.done['employment-contract'] = 1;
          save();
        })
        .catch(function (e) { say('Couldn’t check the contract: ' + e.message, true); })
        .then(function () { checking = false; render(); });
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-recheck]')) checkContract();
      if (e.target.closest('[data-resend]')) { delete state.contract; save(); render(); }
    });
    $('ob-send').addEventListener('click', function () {
      var p = contractProblem(); if (p) { say(p, true); return; }
      if (!state.folder || !state.folder.id) { say('Their folder link is from before contracts were added. Click “Clear for the next hire” and start again.', true); return; }
      var b = $('ob-send'); b.disabled = true; sendContract().then(function () { b.disabled = false; });
    });

    // "Start a new hire": creates (or finds) their folder in the shared Employee folder on Google Drive
    // through /api/new-hire-folder, then ticks step 1.
    var startBtn = $('ob-start'), status = $('ob-status');
    function say(msg, err) { status.textContent = msg; status.classList.toggle('err', !!err); }
    startBtn.addEventListener('click', function () {
      var first = val('first'), last = val('last');
      if (!first || !last) { say('Type their first and last name first.', true); (first ? $('f-last') : $('f-first')).focus(); return; }
      var p = contractProblem(); if (p) { say(p + ' (Or choose “Don’t send a contract”.)', true); return; }
      startBtn.setAttribute('aria-busy', 'true'); startBtn.disabled = true; say('Creating their Drive folder…');
      api('/api/new-hire-folder', { first: first, last: last })
        .then(function (res) {
          if (!res.url) throw new Error('Google didn’t return the folder link.');
          state.folder = { id: res.id, url: res.url, name: res.name, created: !!res.created };
          state.done.googledrive = 1; save(); say(''); render();
          if ($('f-contract').value !== 'none') {
            if (!res.id) { say('Their folder is ready, but the Google script needs updating before contracts can be sent (see docs/new-hire-folder).', true); return; }
            return sendContract();
          }
        }, function (e) { say('Couldn’t create the folder automatically: ' + e.message + ' You can make it by hand (step 1), or try again.', true); })
        .then(function () { startBtn.removeAttribute('aria-busy'); startBtn.disabled = false; });
    });

    F.forEach(function (k) { if (state.f[k] != null) $('f-' + k).value = state.f[k]; });
    F.concat(['pay']).forEach(function (k) {
      $('f-' + k).addEventListener('input', function () { if (k !== 'pay') { state.f[k] = $('f-' + k).value; save(); } render(); });
    });
    document.querySelectorAll('[data-check]').forEach(function (c) {
      c.addEventListener('change', function () { if (c.checked) state.done[c.dataset.check] = 1; else delete state.done[c.dataset.check]; save(); render(); });
    });
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-copy]'); if (!b) return;
      var text = data()[b.dataset.copy] || '';
      var label = b.textContent;
      function okMsg() { b.textContent = 'Copied'; setTimeout(function () { b.textContent = label; }, 1500); }
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(okMsg, function () {});
    });
    var armed = null, reset = $('ob-reset');
    reset.addEventListener('click', function () {
      if (!armed) {
        reset.textContent = 'Click again to clear everything';
        armed = setTimeout(function () { armed = null; reset.textContent = 'Clear for the next hire'; }, 3000);
        return;
      }
      clearTimeout(armed); armed = null; reset.textContent = 'Clear for the next hire';
      state = { f: {}, done: {} }; save(); say('');
      F.concat(['pay']).forEach(function (k) { var n = $('f-' + k); n.value = n.tagName === 'SELECT' ? n.options[0].value : ''; });
      render(); window.scrollTo(0, 0);
    });
    render();
    checkContract(); // on every visit: picks up signatures and saves the signed PDF once it's complete
  })();
</script>
